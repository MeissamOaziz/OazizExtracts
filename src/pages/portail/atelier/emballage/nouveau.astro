---
export const prerender = false;

import PortailLayout from '../../../../layouts/PortailLayout.astro';
import QuickAdd from '../../../../components/portail/QuickAdd.astro';
import Combo from '../../../../components/portail/Combo.astro';
import { createServerClient } from '../../../../lib/supabase';
import { currentOpsStaff } from '../../../../lib/ops';
import { comboRows } from '../../../../lib/ops-quick';
import { PROVINCES, formatQty } from '../../../../lib/ops-orders';
import { getPortailLocale, makeT } from '../../../../lib/portail-i18n';
import { frEmballage, enEmballage } from '../../../../i18n/portail/atelier-emballage';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentOpsStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frEmballage, enEmballage);

const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
const flash = error ? T(`flash.error.${error}` as keyof typeof frEmballage) : null;
// Pre-selected when arriving from a lot's page.
const fromLot = url.searchParams.get('lot');

const [{ data: products }, { data: lots }, { data: orders }, { data: materials }] = await Promise.all([
  supabase.from('ops_products')
    .select('id, name, brand, sku_size_g, gtin, is_bulk')
    .neq('status', 'discontinued').order('name'),
  // Only what actually has material left can be packaged.
  supabase.from('v_ops_inventory')
    .select('id, lot_code, material_fr, material_en, computed_on_hand_g, release_status, cultivar')
    .order('lot_code'),
  supabase.from('ops_orders')
    .select('order_no, id, customer_po_ref, customer:ops_customers ( name )')
    .in('status', ['draft', 'submitted', 'in_production'])
    .order('order_no', { ascending: false }),
  supabase.from('ops_materials')
    .select('id, code, name_fr, name_en').eq('is_active', true).order('code'),
]);

const comboSeeds = { product: comboRows('product', products, locale) };

const matName = (l: any) => (locale === 'en' ? l.material_en : l.material_fr);
const orderLabel = (o: any) => {
  const c = Array.isArray(o.customer) ? o.customer[0] : o.customer;
  return [o.customer_po_ref ?? o.order_no, c?.name].filter(Boolean).join(' · ');
};
const today = new Date().toISOString().slice(0, 10);
---
<PortailLayout title={T('new.title')} staffName={staff.full_name} wide>
  <p style="margin-bottom: 10px;">
    <a href="/portail/atelier/emballage" style="color: var(--p-muted); font-size: .88rem; text-decoration: none;">
      &larr; {T('detail.backToRuns')}
    </a>
  </p>

  <h1 style="margin-bottom: 6px;">{T('new.title')}</h1>
  <p style="color: var(--p-muted); font-size: .92rem; margin-bottom: 20px; max-width: 70ch;">
    {T('new.subtitle')}
  </p>

  {flash && <div class="flash flash-error" style="margin-bottom:16px;">{flash}</div>}

  <form method="POST" action="/api/portail/atelier/packaging">
    <div class="card">
      <div class="grid">
        <Combo kind="product" name="product_id" id="product_id" label={T('f.product')}
               required wide placeholder="—" />

        <div class="field wide">
          <label for="source_lot_id">{T('f.sourceLot')} <em>*</em></label>
          <select id="source_lot_id" name="source_lot_id" required>
            <option value="">—</option>
            {(lots ?? []).map((l: any) => (
              <option value={l.id} selected={l.id === fromLot}>
                {l.lot_code} — {matName(l)} · {formatQty(l.computed_on_hand_g)}
                {l.cultivar ? ` · ${l.cultivar}` : ''}
              </option>
            ))}
          </select>
        </div>

        <div class="field wide">
          <label for="order_id">{T('f.order')}</label>
          <select id="order_id" name="order_id">
            <option value="">{T('detail.stock')}</option>
            {(orders ?? []).map((o: any) => <option value={o.id}>{orderLabel(o)}</option>)}
          </select>
          <p class="hint">{T('f.order.hint')}</p>
        </div>

        <div class="field">
          <label for="units_planned">{T('f.unitsPlanned')}</label>
          <input type="number" id="units_planned" name="units_planned" step="1" min="1" />
        </div>
        <div class="field">
          <label for="unit_size_g">{T('f.unitSize')}</label>
          <input type="number" id="unit_size_g" name="unit_size_g" step="0.001" min="0" />
        </div>
        <div class="field">
          <label for="packaged_on">{T('f.packagedOn')}</label>
          <input type="date" id="packaged_on" name="packaged_on" value={today} />
        </div>
        <div class="field">
          <label for="excise_province">{T('f.province')}</label>
          <select id="excise_province" name="excise_province">
            <option value="">—</option>
            {PROVINCES.map((p) => <option value={p}>{p}</option>)}
          </select>
          <p class="hint">{T('f.province.hint')}</p>
        </div>
        <div class="field wide check">
          <label>
            <input type="checkbox" name="is_excised" value="1" />
            <span>{T('f.excised')}</span>
          </label>
        </div>
        <div class="field wide">
          <label for="notes">{T('f.notes')}</label>
          <textarea id="notes" name="notes" rows="2"></textarea>
        </div>
      </div>
    </div>

    <QuickAdd kinds={['product']} seeds={comboSeeds} materials={materials ?? []} />

    <div style="display:flex; gap:10px; margin-top:18px;">
      <button type="submit" class="btn btn-primary">{T('new.submit')}</button>
      <a href="/portail/atelier/emballage" class="btn btn-secondary" style="text-decoration:none;">Annuler</a>
    </div>
  </form>
</PortailLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; }
  .field.wide { grid-column: 1 / -1; }
  .field em { color: var(--p-accent); font-style: normal; }
  .field.check label { display: flex; align-items: center; gap: 8px; font-weight: 400; }
  .field.check input { width: auto; }
</style>
