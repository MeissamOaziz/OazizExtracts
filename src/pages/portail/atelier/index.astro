---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient } from '../../../lib/supabase';
import { currentOpsStaff, REF_TABLES, tableLabel, canManage } from '../../../lib/ops';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frAtelier, enAtelier } from '../../../i18n/portail/atelier';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentOpsStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frAtelier, enAtelier);

// Reference-data counts, so the hub shows the module is actually populated.
const counts = await Promise.all(
  REF_TABLES.map(async (spec) => {
    const { count } = await supabase.from(spec.table).select('id', { count: 'exact', head: true });
    return { spec, count: count ?? 0 };
  }),
);

const { count: openCountRaw } = await supabase
  .from('ops_orders')
  .select('id', { count: 'exact', head: true })
  .in('status', ['draft', 'submitted', 'in_production', 'ready_to_ship']);
const openCount = openCountRaw ?? 0;

const { count: lotCountRaw } = await supabase
  .from('ops_lots').select('id', { count: 'exact', head: true });
const lotCount = lotCountRaw ?? 0;

const { count: stageCountRaw } = await supabase
  .from('ops_wo_stages').select('id', { count: 'exact', head: true })
  .not('status', 'in', '("done","cancelled")');
const stageCount = stageCountRaw ?? 0;

const { count: pkgCountRaw } = await supabase
  .from('ops_packaging_runs').select('id', { count: 'exact', head: true })
  .eq('status', 'draft');
const pkgCount = pkgCountRaw ?? 0;

const { count: desCountRaw } = await supabase
  .from('ops_destructions').select('id', { count: 'exact', head: true })
  .eq('status', 'planned');
const desCount = desCountRaw ?? 0;

const manage = canManage(staff.ops_role);
---
<PortailLayout title={T('title')} staffName={staff.full_name} wide>
  <h1>{T('greeting')}</h1>
  <p style="color: var(--p-muted); margin-bottom: 24px; max-width: 60ch;">{T('subtitle')}</p>

  <div class="card" style="border-left: 3px solid var(--p-accent); margin-bottom: 24px;">
    <strong style="display:block; margin-bottom:4px;">{T('phase.notice.title')}</strong>
    <span style="color: var(--p-muted); font-size: .9rem;">{T('phase.notice.body')}</span>
  </div>

  <div class="ops-grid">
    <a href="/portail/atelier/commandes" class="card ops-card">
      <div class="ops-head">
        <h2>{T('section.orders')}</h2>
        {openCount > 0 && <span class="ops-count">{openCount}</span>}
      </div>
      <p>{T('section.orders.desc')}</p>
    </a>
    <a href="/portail/atelier/commandes/nouvelle" class="card ops-card">
      <div class="ops-head"><h2>{T('section.newOrder')}</h2></div>
      <p>{T('section.newOrder.desc')}</p>
    </a>
    <a href="/portail/atelier/planning" class="card ops-card">
      <div class="ops-head">
        <h2>{T('section.planning')}</h2>
        {stageCount > 0 && <span class="ops-count">{stageCount}</span>}
      </div>
      <p>{T('section.planning.desc')}</p>
    </a>
    <a href="/portail/atelier/emballage" class="card ops-card">
      <div class="ops-head">
        <h2>{T('section.packaging')}</h2>
        {pkgCount > 0 && <span class="ops-count">{pkgCount}</span>}
      </div>
      <p>{T('section.packaging.desc')}</p>
    </a>
    <a href="/portail/atelier/destructions" class="card ops-card">
      <div class="ops-head">
        <h2>{T('section.destructions')}</h2>
        {desCount > 0 && <span class="ops-count">{desCount}</span>}
      </div>
      <p>{T('section.destructions.desc')}</p>
    </a>
    <a href="/portail/atelier/inventaire" class="card ops-card">
      <div class="ops-head"><h2>{T('section.inventory')}</h2></div>
      <p>{T('section.inventory.desc')}</p>
    </a>
    <a href="/portail/atelier/lots" class="card ops-card">
      <div class="ops-head">
        <h2>{T('section.lots')}</h2>
        {lotCount > 0 && <span class="ops-count">{lotCount}</span>}
      </div>
      <p>{T('section.lots.desc')}</p>
    </a>
  </div>

  <h2 style="font-size: 1.05rem; margin: 34px 0 12px;">{T('section.settings')}</h2>
  <p style="color: var(--p-muted); font-size: .9rem; margin-bottom: 16px; max-width: 66ch;">
    {T('section.settings.desc')}
  </p>

  <div class="ref-grid">
    {counts.map(({ spec, count }) => (
      <a href={`/portail/atelier/parametres/${spec.slug}`} class="card ref-card">
        <div class="ref-head">
          <h3>{tableLabel(spec, locale)}</h3>
          <span class="ref-count">{count}</span>
        </div>
      </a>
    ))}
  </div>

  {!manage && (
    <p style="color: var(--p-muted); font-size: .85rem; margin-top: 20px;">{T('readonly.notice')}</p>
  )}
</PortailLayout>

<style>
  .ops-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 8px;
  }
  .ops-card { display: block; text-decoration: none; color: inherit; transition: border-color .15s ease; }
  .ops-card:hover { border-color: var(--p-accent); }
  .ops-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
  .ops-card h2 { margin: 0; font-size: 1rem; }
  .ops-card p { color: var(--p-muted); font-size: .87rem; margin: 0; line-height: 1.5; }
  .ops-count {
    font-variant-numeric: tabular-nums; font-size: .8rem; font-weight: 600; color: #fff;
    background: var(--p-accent); border-radius: 5px; padding: 1px 8px;
  }
  .ref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .ref-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color .15s ease, transform .15s ease;
  }
  .ref-card:hover { border-color: var(--p-accent); transform: translateY(-1px); }
  .ref-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .ref-card h3 { margin: 0; font-size: .98rem; }
  .ref-count {
    font-variant-numeric: tabular-nums;
    font-size: .82rem;
    color: var(--p-muted);
    background: var(--p-bg);
    border: 1px solid var(--p-border);
    border-radius: 5px;
    padding: 1px 7px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ref-card { transition: none; }
    .ref-card:hover { transform: none; }
  }
</style>
