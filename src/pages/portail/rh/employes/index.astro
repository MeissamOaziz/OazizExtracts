---
export const prerender = false;

import PortailLayout from '../../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff, getAdminClient } from '../../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../../lib/portail-i18n';
import { frRhEmployees, enRhEmployees } from '../../../../i18n/portail/rh-employees';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frRhEmployees, enRhEmployees);

const url = new URL(Astro.request.url);
const info = url.searchParams.get('info');
const errCode = url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  invalid_email: T('error.invalid_email'),
  missing: T('error.missing'),
  send_failed: T('error.send_failed'),
  unknown: T('error.unknown'),
};

const admin = getAdminClient();
const { data: packages } = await admin
  .from('hr_employee_packages')
  .select('id, status, language, new_employee_name, new_employee_email, sent_at')
  .order('sent_at', { ascending: false });

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString(locale === 'en' ? 'en-CA' : 'fr-CA', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---
<PortailLayout title={T('title')} staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href="/portail/rh" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">{T('backLink')}</a>
  </div>
  <h1>{T('title')}</h1>
  <p style="color: var(--p-muted); margin-bottom: 24px;">{T('subtitle')}</p>

  {info === 'sent' && <div class="flash flash-success">{T('info.sent')}</div>}
  {errCode && <div class="flash flash-error">{errorMessages[errCode] ?? errorMessages.unknown}</div>}

  <div class="card" style="margin-bottom: 24px; max-width: 560px;">
    <h2>{T('section.send')}</h2>
    <form method="POST" action="/api/portail/rh/employees/send" style="margin-top: 14px;">
      <div class="form-row">
        <label for="new_employee_name">{T('label.employeeName')}</label>
        <input type="text" id="new_employee_name" name="new_employee_name" required />
      </div>
      <div class="form-row">
        <label for="new_employee_email">{T('label.employeeEmail')}</label>
        <input type="email" id="new_employee_email" name="new_employee_email" required />
      </div>
      <div class="form-row">
        <label for="language">{T('label.language')}</label>
        <select id="language" name="language">
          <option value="fr">{T('lang.fr')}</option>
          <option value="en">{T('lang.en')}</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">{T('sendBtn')}</button>
    </form>
  </div>

  <div class="card">
    <h2>{T('section.list')}</h2>
    {(!packages || packages.length === 0) ? (
      <p style="color: var(--p-muted); margin-top: 12px;">{T('emptyList')}</p>
    ) : (
      <table class="data" style="margin-top: 12px;">
        <thead>
          <tr>
            <th>{T('th.employee')}</th><th>{T('th.email')}</th><th>{T('th.language')}</th>
            <th>{T('th.status')}</th><th>{T('th.sentAt')}</th><th>{T('th.actions')}</th>
          </tr>
        </thead>
        <tbody>
          {packages.map((p) => (
            <tr>
              <td>{p.new_employee_name}</td>
              <td>{p.new_employee_email}</td>
              <td>{p.language === 'en' ? T('lang.en') : T('lang.fr')}</td>
              <td>{T(`status.${p.status}` as keyof typeof frRhEmployees)}</td>
              <td>{formatDate(p.sent_at)}</td>
              <td style="text-align:right;">
                <a href={`/portail/rh/employes/${p.id}`} class="btn btn-secondary" style="font-size:.78rem;padding:4px 10px;">{T('viewBtn')}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</PortailLayout>
