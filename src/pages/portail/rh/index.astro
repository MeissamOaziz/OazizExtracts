---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff, getAdminClient } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frRhIndex, enRhIndex } from '../../../i18n/portail/rh-index';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frRhIndex, enRhIndex);

const admin = getAdminClient();
const { data: recent } = await admin
  .from('hr_generated_documents')
  .select('id, kind, generated_at, sent_to')
  .order('generated_at', { ascending: false })
  .limit(20);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString(locale === 'en' ? 'en-CA' : 'fr-CA', { year: 'numeric', month: '2-digit', day: '2-digit' });
}

const cards = [
  { href: '/portail/rh/attestation', title: T('card.attestation.title'), desc: T('card.attestation.desc') },
  { href: '/portail/rh/incident', title: T('card.incident.title'), desc: T('card.incident.desc') },
  { href: '/portail/rh/evaluation', title: T('card.evaluation.title'), desc: T('card.evaluation.desc') },
  { href: '/portail/rh/employes', title: T('card.employees.title'), desc: T('card.employees.desc') },
];
---
<PortailLayout title={T('title')} staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href="/portail" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">{T('backLink')}</a>
  </div>
  <h1>{T('title')}</h1>
  <p style="color: var(--p-muted); margin-bottom: 24px;">{T('subtitle')}</p>

  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; margin-bottom: 28px;">
    {cards.map((c) => (
      <a href={c.href} class="card hub-card">
        <h2 style="margin-bottom: 8px;">{c.title}</h2>
        <p style="color: var(--p-muted); font-size: .9rem; margin: 0;">{c.desc}</p>
      </a>
    ))}
  </div>

  <div class="card">
    <h2>{T('section.recent')}</h2>
    {(!recent || recent.length === 0) ? (
      <p style="color: var(--p-muted); margin-top: 12px;">{T('emptyRecent')}</p>
    ) : (
      <table class="data" style="margin-top: 12px;">
        <thead>
          <tr><th>{T('th.date')}</th><th>{T('th.kind')}</th><th>{T('th.sentTo')}</th><th></th></tr>
        </thead>
        <tbody>
          {recent.map((d) => (
            <tr>
              <td>{formatDate(d.generated_at)}</td>
              <td>{T(`kind.${d.kind}` as keyof typeof frRhIndex)}</td>
              <td>{d.sent_to?.join(', ') || '—'}</td>
              <td style="text-align:right;">
                <a href={`/api/portail/rh/documents/${d.id}/file`} class="btn btn-secondary" style="font-size:.78rem;padding:4px 10px;">{T('downloadBtn')}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</PortailLayout>
<style>
  .hub-card { display: block; text-decoration: none; color: inherit; transition: border-color .15s ease, box-shadow .15s ease; }
  .hub-card:hover { border-color: var(--p-accent); box-shadow: 0 2px 6px rgba(16,24,40,.08); }
</style>
