---
export const prerender = false;

import PortailLayout from '../../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff, getAdminClient } from '../../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../../lib/portail-i18n';
import {
  effectivePermissions, cleanOverrides, isRole, PERMISSIONS, ROLES, ROLE_PRESETS,
} from '../../../../lib/access';
import { frAdminUsers, enAdminUsers } from '../../../../i18n/portail/admin-users';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');
if (!effectivePermissions(staff).has('admin')) return Astro.redirect('/portail?error=forbidden');

const { id } = Astro.params;
if (!id) return Astro.redirect('/portail/admin/utilisateurs');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frAdminUsers, enAdminUsers);

const admin = getAdminClient();
const { data: user } = await admin
  .from('staff')
  .select('id, full_name, email, title, is_active, portal_role, portal_permission_overrides')
  .eq('id', id)
  .maybeSingle();
if (!user) return Astro.redirect('/portail/admin/utilisateurs');

const overrides = cleanOverrides(user.portal_permission_overrides);
const role = isRole(user.portal_role) ? user.portal_role : null;
const rolePreset = role ? new Set(ROLE_PRESETS[role]) : new Set<string>();
const effective = effectivePermissions(user);
const isSelf = user.id === staff.id;

const url = new URL(Astro.request.url);
const info = url.searchParams.get('info');
const errCode = url.searchParams.get('error');
const infoMessages: Record<string, string> = { saved: T('info.saved'), invited: T('info.invited') };
const errorMessages: Record<string, string> = {
  last_admin: T('error.last_admin'), self_deactivate: T('error.self_deactivate'),
  invite_failed: T('error.invite_failed'), missing: T('error.missing'), unknown: T('error.unknown'),
};

const presets = Object.fromEntries(ROLES.map((r) => [r, [...ROLE_PRESETS[r]]]));
const yes = T('yes');
const no = T('no');
---
<PortailLayout title={user.full_name} staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href="/portail/admin/utilisateurs" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">{T('edit.back')}</a>
  </div>
  <h1>{user.full_name}</h1>
  <p style="color: var(--p-muted); margin-bottom: 24px;">{user.email}</p>

  {info && infoMessages[info] && <div class="flash flash-success">{infoMessages[info]}</div>}
  {errCode && <div class="flash flash-error">{errorMessages[errCode] ?? errorMessages.unknown}</div>}

  <form method="POST" action={`/api/portail/admin/users/${user.id}/update`} class="card" style="max-width: 760px; margin-bottom: 20px;">
    <h2>{T('edit.details')}</h2>
    <div class="two-col" style="margin-top: 14px;">
      <div class="form-row"><label for="full_name">{T('label.fullName')}</label><input type="text" id="full_name" name="full_name" value={user.full_name} required /></div>
      <div class="form-row"><label for="title">{T('label.title')}</label><input type="text" id="title" name="title" value={user.title ?? ''} /></div>
    </div>
    <div class="form-row">
      <label for="portal_role">{T('label.role')}</label>
      <select id="portal_role" name="portal_role">
        <option value="" selected={!role}>{T('role.none')}</option>
        {ROLES.map((r) => <option value={r} selected={role === r}>{T(`role.${r}` as keyof typeof frAdminUsers)}</option>)}
      </select>
      <div class="hint">{T('edit.roleHint')}</div>
    </div>

    <h2 style="margin-top: 24px;">{T('edit.accessHeading')}</h2>
    <p id="admin-note" class="hint" style={`margin: 4px 0 10px;${role === 'admin' ? '' : 'display:none;'}`}>{T('adminAll')}</p>
    <table class="data" style="margin-top: 10px;">
      <thead>
        <tr><th>{T('edit.th.module')}</th><th>{T('edit.th.fromRole')}</th><th>{T('edit.th.override')}</th><th>{T('edit.th.effective')}</th></tr>
      </thead>
      <tbody>
        {PERMISSIONS.map((p) => {
          const o = overrides[p];
          return (
            <tr data-perm={p}>
              <td>{T(`perm.${p}` as keyof typeof frAdminUsers)}</td>
              <td class="from-role">{rolePreset.has(p) ? yes : no}</td>
              <td>
                <select name={`perm_${p}`} class="override-select" style="max-width:170px;">
                  <option value="default" selected={o === undefined}>{T('override.default')}</option>
                  <option value="grant" selected={o === true}>{T('override.grant')}</option>
                  <option value="deny" selected={o === false}>{T('override.deny')}</option>
                </select>
              </td>
              <td class="effective"><strong>{effective.has(p) ? yes : no}</strong></td>
            </tr>
          );
        })}
      </tbody>
    </table>

    <div class="check-row" style="margin-top: 20px;">
      <input type="checkbox" id="is_active" name="is_active" value="1" checked={user.is_active} disabled={isSelf} />
      <label for="is_active">{T('label.active')}</label>
    </div>
    <div class="hint" style="margin-bottom: 18px;">{T('active.hint')}</div>
    {isSelf && user.is_active && <input type="hidden" name="is_active" value="1" />}

    <button type="submit" class="btn btn-primary">{T('saveBtn')}</button>
  </form>

  <form method="POST" action={`/api/portail/admin/users/${user.id}/invite`}>
    <button type="submit" class="btn btn-secondary">{T('inviteBtn')}</button>
  </form>

  <script is:inline define:vars={{ presets, yes, no }}>
    (function () {
      const roleSel = document.getElementById('portal_role');
      const rows = Array.from(document.querySelectorAll('tr[data-perm]'));
      const adminNote = document.getElementById('admin-note');
      function refresh() {
        const role = roleSel.value;
        const preset = presets[role] || [];
        if (adminNote) adminNote.style.display = role === 'admin' ? '' : 'none';
        rows.forEach((row) => {
          const perm = row.getAttribute('data-perm');
          const select = row.querySelector('.override-select');
          const inPreset = preset.indexOf(perm) >= 0;
          row.querySelector('.from-role').textContent = inPreset ? yes : no;
          select.disabled = role === 'admin';
          let eff = inPreset;
          if (role && role !== 'admin') {
            if (select.value === 'grant') eff = true;
            else if (select.value === 'deny') eff = false;
          }
          if (!role) eff = false;
          row.querySelector('.effective').innerHTML = '<strong>' + (eff ? yes : no) + '</strong>';
        });
      }
      roleSel.addEventListener('change', refresh);
      rows.forEach((r) => r.querySelector('.override-select').addEventListener('change', refresh));
      refresh();
    })();
  </script>
</PortailLayout>
