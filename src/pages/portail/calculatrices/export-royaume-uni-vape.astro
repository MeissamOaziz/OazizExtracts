---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frExportRoyaumeUniVape, enExportRoyaumeUniVape } from '../../../i18n/portail/export-royaume-uni-vape';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frExportRoyaumeUniVape, enExportRoyaumeUniVape);

const clientStrings = {
  locale,
  tier500Label: T('tier500Label'),
  tier1000Label: T('tier1000Label'),
  tier2000Label: T('tier2000Label'),
  tier5000Label: T('tier5000Label'),
  warnMaterialQty: T('warnMaterialQty'),
  warnProductAvailable: T('warnProductAvailable'),
  warnCartFillWeight: T('warnCartFillWeight'),
  yieldCardTitle: T('yieldCardTitle'),
  yieldPostWash: T('yieldPostWash'),
  yieldPostPress: T('yieldPostPress'),
  yieldTotalAvailable: T('yieldTotalAvailable'),
  yieldCartsProducible: T('yieldCartsProducible'),
  yieldHint: T('yieldHint'),
  costPoolsTitle: T('costPoolsTitle'),
  costLineMaterial: T('costLineMaterial'),
  costLineLabTests: T('costLineLabTests'),
  costLineLabTestsSuffix: T('costLineLabTestsSuffix'),
  costLineOazizProcessing: T('costLineOazizProcessing'),
  costLineOneTime: T('costLineOneTime'),
  costLineAgMedica: T('costLineAgMedica'),
  costLineOtherRx: T('costLineOtherRx'),
  costLineBulkRosin: T('costLineBulkRosin'),
  bulkRosinUnitSuffix: T('bulkRosinUnitSuffix'),
  costLineTotalFixed: T('costLineTotalFixed'),
  costPerCartTitle: T('costPerCartTitle'),
  applicableNoteApplies: T('applicableNoteApplies'),
  applicableNoteNone: T('applicableNoteNone'),
  costTableColTier: T('costTableColTier'),
  costTableColTolling: T('costTableColTolling'),
  costTableColVariableRosin: T('costTableColVariableRosin'),
  costTableColFixedAmortized: T('costTableColFixedAmortized'),
  costTableColTotalCad: T('costTableColTotalCad'),
  costTableColTotalGbp: T('costTableColTotalGbp'),
  marginTitle: T('marginTitle'),
  marginColTier: T('marginColTier'),
  marginColWholesale: T('marginColWholesale'),
  marginColProfit: T('marginColProfit'),
  marginColMarginPct: T('marginColMarginPct'),
  marginColBatchProfit: T('marginColBatchProfit'),
};
---
<PortailLayout title={T('pageTitle')} staffName={staff.full_name}>
  <div class="calc-wizard">
    <div style="margin-bottom: 20px;">
      <a href="/portail/calculatrices" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
        {T('backLink')}
      </a>
    </div>
    <h1>{T('pageTitle')}</h1>
    <p style="color: var(--p-muted); margin-bottom: 20px;">
      {T('pageIntro')}
    </p>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('currenciesTitle')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="gbpToCad">{T('gbpToCadLabel')}</label>
          <input type="number" id="gbpToCad" value="1.92" step="0.01" />
        </div>
        <div class="form-row">
          <label>{T('cadToGbpLabel')}</label>
          <div id="cadToGbpDisplay" class="derived-value">—</div>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('startingMaterialTitle')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="totalInputG">{T('totalInputLabel')}</label>
          <input type="number" id="totalInputG" value="69000" step="100" />
        </div>
        <div class="form-row">
          <label for="costPerGCad">{T('costPerGLabel')}</label>
          <input type="number" id="costPerGCad" value="0.12" step="0.01" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('labTestsTitle')}</h2>
      <div class="form-row">
        <label for="numLots">{T('numLotsLabel')}</label>
        <input type="number" id="numLots" value="1" step="1" />
      </div>
      <p class="hint">{T('labTestsHint')}</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('oazizProcessingTitle')}</h2>
      <div class="form-row">
        <label for="oazizProcessingCadPerG">{T('oazizProcessingLabel')}</label>
        <input type="number" id="oazizProcessingCadPerG" value="4.75" step="0.05" />
      </div>
      <p class="hint">{T('oazizProcessingHint')}</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('yieldTitle')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="washYieldPct">{T('washYieldLabel')}</label>
          <input type="number" id="washYieldPct" value="10" step="0.5" />
        </div>
        <div class="form-row">
          <label for="pressYieldPct">{T('pressYieldLabel')}</label>
          <input type="number" id="pressYieldPct" value="60" step="1" />
        </div>
      </div>
      <div class="three-col">
        <div class="form-row">
          <label for="retainedOazizG">{T('retainedOazizLabel')}</label>
          <input type="number" id="retainedOazizG" value="150" step="10" />
        </div>
        <div class="form-row">
          <label for="retainedAgMedicaG">{T('retainedAgMedicaLabel')}</label>
          <input type="number" id="retainedAgMedicaG" value="150" step="10" />
        </div>
        <div class="form-row">
          <label for="retainedRxG">{T('retainedRxLabel')}</label>
          <input type="number" id="retainedRxG" value="150" step="10" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('oneTimeCostsTitle')}</h2>
      <div class="form-row">
        <label for="lpAuditFeeCad">{T('lpAuditFeeLabel')}</label>
        <input type="number" id="lpAuditFeeCad" value="1750" step="50" />
      </div>
      <div class="form-row">
        <label for="productValidationCadPerStrain">{T('productValidationLabel')}</label>
        <input type="number" id="productValidationCadPerStrain" value="17500" step="500" />
      </div>
      <div class="form-row">
        <label for="packagingFormeGbp">{T('packagingFormeLabel')}</label>
        <input type="number" id="packagingFormeGbp" value="270" step="10" />
      </div>
      <p class="hint">{T('oneTimeCostsHint')}</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('agMedicaCostsTitle')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="agMedicaProcessingCadPerG">{T('agMedicaProcessingLabel')}</label>
          <input type="number" id="agMedicaProcessingCadPerG" value="4.50" step="0.05" />
        </div>
        <div class="form-row">
          <label for="agMedicaShippingFlat">{T('agMedicaShippingLabel')}</label>
          <input type="number" id="agMedicaShippingFlat" value="4590" step="10" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('tollingTableTitle')}</h2>
      <p class="hint" style="margin-bottom: 12px;">{T('tollingTableHint')}</p>
      <div style="overflow-x:auto;">
        <table class="calc-table">
          <thead>
            <tr>
              <th>{T('tollingColTier')}</th>
              <th>{T('tollingColFill')}</th>
              <th>{T('tollingColCart')}</th>
              <th>{T('tollingColPick')}</th>
              <th>{T('tollingColPack')}</th>
              <th>{T('tollingColTotal')}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{T('tier500Label')}</td>
              <td>4,29 $</td>
              <td>4,23 $</td>
              <td>2,471625 $</td>
              <td>0,95 $</td>
              <td>11,941625 $</td>
            </tr>
            <tr>
              <td>{T('tier1000Label')}</td>
              <td>3,705 $</td>
              <td>4,23 $</td>
              <td>2,471625 $</td>
              <td>0,95 $</td>
              <td>11,356625 $</td>
            </tr>
            <tr>
              <td>{T('tier2000Label')}</td>
              <td>3,12 $</td>
              <td>4,23 $</td>
              <td>2,471625 $</td>
              <td>0,95 $</td>
              <td>10,771625 $</td>
            </tr>
            <tr>
              <td>{T('tier5000Label')}</td>
              <td>2,34 $</td>
              <td>4,08 $</td>
              <td>2,471625 $</td>
              <td>0,95 $</td>
              <td>9,841625 $</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('otherRxTitle')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="incomingOutgoingTestingCad">{T('incomingOutgoingLabel')}</label>
          <input type="number" id="incomingOutgoingTestingCad" value="5850" step="50" />
        </div>
        <div class="form-row">
          <label for="rxLabTestingCad">{T('rxLabTestingLabel')}</label>
          <input type="number" id="rxLabTestingCad" value="1750" step="50" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('cartBreakdownTitle')}</h2>
      <div class="form-row">
        <label for="cartFillWeightG">{T('cartFillWeightLabel')}</label>
        <input type="number" id="cartFillWeightG" value="1" step="0.1" />
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('marginAnalysisSectionTitle')}</h2>
      <div class="form-row">
        <label for="wholesalePriceGbpPerUnit">{T('wholesalePriceLabel')}</label>
        <input type="number" id="wholesalePriceGbpPerUnit" value="25" step="0.5" />
      </div>
    </div>

    <div id="result"></div>
  </div>
</PortailLayout>

<script type="application/json" id="calc-i18n-data" set:html={JSON.stringify(clientStrings)}></script>

<style is:global>
  .derived-value {
    padding: 9px 12px;
    border: 1px solid var(--p-border);
    border-radius: 6px;
    background: var(--p-bg);
    color: var(--p-muted);
    font-size: .95rem;
    font-variant-numeric: tabular-nums;
  }

  .three-col { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 12px; }
  @media (max-width: 600px) { .three-col { grid-template-columns: 1fr; } }

  .yield-row { display: flex; gap: 16px; margin-bottom: 8px; flex-wrap: wrap; }
  .yield-item { flex: 1; min-width: 160px; font-size: .85rem; color: var(--p-muted); }
  .yield-item strong { display: block; font-size: 1.05rem; color: var(--p-text); font-variant-numeric: tabular-nums; }

  .cost-line { display: flex; justify-content: space-between; padding: 6px 0; font-size: .88rem; gap: 12px; }
  .cost-line span:first-child { color: var(--p-muted); }
  .cost-line span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cost-line.subtotal { border-top: 1px solid var(--p-border); margin-top: 6px; padding-top: 8px; font-weight: 600; }

  table.calc-table { width: 100%; border-collapse: collapse; font-size: .85rem; font-variant-numeric: tabular-nums; }
  table.calc-table th, table.calc-table td { padding: 8px 10px; text-align: right; border-bottom: 1px solid var(--p-border); white-space: nowrap; }
  table.calc-table th:first-child, table.calc-table td:first-child { text-align: left; white-space: normal; min-width: 120px; }
  table.calc-table th { font-weight: 600; color: var(--p-muted); font-size: .68rem; text-transform: uppercase; }
  table.calc-table tr.applicable-row { background: rgba(208, 88, 38, .08); }
  table.calc-table tr.applicable-row td:first-child { font-weight: 700; color: var(--p-accent); }
  table.calc-table tr.applicable-row td { font-weight: 600; }

  .applicable-note { font-size: .78rem; color: var(--p-accent); font-weight: 600; margin-top: 6px; }
</style>

<script>
  type ClientStrings = {
    locale: 'fr' | 'en';
    tier500Label: string;
    tier1000Label: string;
    tier2000Label: string;
    tier5000Label: string;
    warnMaterialQty: string;
    warnProductAvailable: string;
    warnCartFillWeight: string;
    yieldCardTitle: string;
    yieldPostWash: string;
    yieldPostPress: string;
    yieldTotalAvailable: string;
    yieldCartsProducible: string;
    yieldHint: string;
    costPoolsTitle: string;
    costLineMaterial: string;
    costLineLabTests: string;
    costLineLabTestsSuffix: string;
    costLineOazizProcessing: string;
    costLineOneTime: string;
    costLineAgMedica: string;
    costLineOtherRx: string;
    costLineBulkRosin: string;
    bulkRosinUnitSuffix: string;
    costLineTotalFixed: string;
    costPerCartTitle: string;
    applicableNoteApplies: string;
    applicableNoteNone: string;
    costTableColTier: string;
    costTableColTolling: string;
    costTableColVariableRosin: string;
    costTableColFixedAmortized: string;
    costTableColTotalCad: string;
    costTableColTotalGbp: string;
    marginTitle: string;
    marginColTier: string;
    marginColWholesale: string;
    marginColProfit: string;
    marginColMarginPct: string;
    marginColBatchProfit: string;
  };

  const I18N: ClientStrings = JSON.parse(document.getElementById('calc-i18n-data')!.textContent!);
  const NUM_LOCALE = I18N.locale === 'en' ? 'en-CA' : 'fr-CA';

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isFinite(v) ? v : 0;
  }

  const fmtMoney2 = (n: number) =>
    isFinite(n) ? n.toLocaleString(NUM_LOCALE, { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtMoney0 = (n: number) =>
    isFinite(n) ? n.toLocaleString(NUM_LOCALE, { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }) : '—';
  const fmtGbp2 = (n: number) =>
    isFinite(n) ? n.toLocaleString(NUM_LOCALE, { style: 'currency', currency: 'GBP', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtPerG = (n: number) => (isFinite(n) ? '$' + n.toFixed(4) : '—');
  const fmtPct2 = (n: number) => (isFinite(n) ? (n * 100).toFixed(2) + '%' : '—');
  const fmtG = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString(NUM_LOCALE) + ' g' : '—');
  const fmtRate6 = (n: number) => (isFinite(n) ? n.toFixed(6) : '—');
  const fmtUnits = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString(NUM_LOCALE) : '—');

  type Tier = {
    label: string;
    min: number;
    max: number;
    fill: number;
    cart: number;
    pick: number;
    pack: number;
  };

  const TIERS: Tier[] = [
    { label: I18N.tier500Label, min: 500, max: 999, fill: 4.29, cart: 4.23, pick: 2.471625, pack: 0.95 },
    { label: I18N.tier1000Label, min: 1000, max: 1999, fill: 3.705, cart: 4.23, pick: 2.471625, pack: 0.95 },
    { label: I18N.tier2000Label, min: 2000, max: 4999, fill: 3.12, cart: 4.23, pick: 2.471625, pack: 0.95 },
    { label: I18N.tier5000Label, min: 5000, max: Infinity, fill: 2.34, cart: 4.08, pick: 2.471625, pack: 0.95 },
  ];

  function render() {
    const out = document.getElementById('result');
    if (!out) return;

    const gbpToCad = num('gbpToCad');
    const cadToGbp = gbpToCad > 0 ? 1 / gbpToCad : 0;
    const cadToGbpDisplay = document.getElementById('cadToGbpDisplay');
    if (cadToGbpDisplay) cadToGbpDisplay.textContent = fmtRate6(cadToGbp);

    const totalInputG = num('totalInputG');
    const costPerGCad = num('costPerGCad');
    const totalMaterialCost = totalInputG * costPerGCad;

    const numLots = num('numLots');
    const testACost = 1750;
    const testBCost = 3675;
    const costPerCoa = testACost + testBCost;
    const totalLabTestCost = numLots * costPerCoa;
    const labCostPerG = totalInputG > 0 ? totalLabTestCost / totalInputG : 0;

    const oazizProcessingCadPerG = num('oazizProcessingCadPerG');

    const washYieldPct = num('washYieldPct');
    const pressYieldPct = num('pressYieldPct');
    const retainedOazizG = num('retainedOazizG');
    const retainedAgMedicaG = num('retainedAgMedicaG');
    const retainedRxG = num('retainedRxG');

    const postWashYieldG = totalInputG * (washYieldPct / 100);
    const postPressYieldG = postWashYieldG * (pressYieldPct / 100);

    const totalOazizProcessingCost = postPressYieldG * oazizProcessingCadPerG;

    const totalProductAvailableG = postPressYieldG - retainedOazizG - retainedAgMedicaG - retainedRxG;

    const lpAuditFeeCad = num('lpAuditFeeCad');
    const productValidationCadPerStrain = num('productValidationCadPerStrain');
    const packagingFormeGbp = num('packagingFormeGbp');
    const totalOneTimeCosts =
      lpAuditFeeCad + productValidationCadPerStrain * numLots + packagingFormeGbp * gbpToCad;

    const agMedicaProcessingCadPerG = num('agMedicaProcessingCadPerG');
    const agMedicaShippingFlat = num('agMedicaShippingFlat');
    const totalAgMedicaCosts = postPressYieldG * agMedicaProcessingCadPerG + agMedicaShippingFlat;

    const incomingOutgoingTestingCad = num('incomingOutgoingTestingCad');
    const rxLabTestingCad = num('rxLabTestingCad');
    const totalOtherRxCosts = incomingOutgoingTestingCad + rxLabTestingCad;

    const cartFillWeightG = num('cartFillWeightG');
    const totalCartsProducible = cartFillWeightG > 0 ? totalProductAvailableG / cartFillWeightG : 0;

    const bulkRosinCostPerG =
      totalProductAvailableG > 0
        ? (totalMaterialCost + totalOazizProcessingCost + postPressYieldG * agMedicaProcessingCadPerG) /
          totalProductAvailableG
        : 0;

    const totalTrulyFixedCosts = totalLabTestCost + totalOneTimeCosts + agMedicaShippingFlat + totalOtherRxCosts;

    const wholesalePriceGbpPerUnit = num('wholesalePriceGbpPerUnit');
    const wholesalePriceCadPerUnit = wholesalePriceGbpPerUnit * gbpToCad;

    let warnHtml = '';
    if (totalInputG <= 0) {
      warnHtml += `<div class="warn-banner">${I18N.warnMaterialQty}</div>`;
    }
    if (totalProductAvailableG <= 0) {
      warnHtml += `<div class="warn-banner">${I18N.warnProductAvailable}</div>`;
    }
    if (cartFillWeightG <= 0) {
      warnHtml += `<div class="warn-banner">${I18N.warnCartFillWeight}</div>`;
    }

    const fixedPerCart = totalCartsProducible > 0 ? totalTrulyFixedCosts / totalCartsProducible : 0;
    const variableRosinPerCart = cartFillWeightG * bulkRosinCostPerG;

    const tierRows = TIERS.map((tier) => {
      const tollingPerUnit = tier.fill + tier.cart + tier.pick + tier.pack;
      const totalCostPerCartCad = tollingPerUnit + variableRosinPerCart + fixedPerCart;
      const totalCostPerCartGbp = totalCostPerCartCad * cadToGbp;
      const applies = totalCartsProducible >= tier.min && totalCartsProducible <= tier.max;
      return { tier, tollingPerUnit, totalCostPerCartCad, totalCostPerCartGbp, applies };
    });

    const costTableRows = tierRows
      .map(
        (r) => `<tr class="${r.applies ? 'applicable-row' : ''}">
          <td>${r.tier.label}${r.applies ? ' ★' : ''}</td>
          <td>${fmtMoney2(r.tollingPerUnit)}</td>
          <td>${fmtMoney2(variableRosinPerCart)}</td>
          <td>${fmtMoney2(fixedPerCart)}</td>
          <td>${fmtMoney2(r.totalCostPerCartCad)}</td>
          <td>${fmtGbp2(r.totalCostPerCartGbp)}</td>
        </tr>`
      )
      .join('');

    const marginRows = tierRows
      .map((r) => {
        const profitPerCart = wholesalePriceCadPerUnit - r.totalCostPerCartCad;
        const marginPct = wholesalePriceCadPerUnit > 0 ? profitPerCart / wholesalePriceCadPerUnit : 0;
        const totalBatchProfit = profitPerCart * totalCartsProducible;
        return `<tr class="${r.applies ? 'applicable-row' : ''}">
          <td>${r.tier.label}${r.applies ? ' ★' : ''}</td>
          <td>${fmtMoney2(wholesalePriceCadPerUnit)}</td>
          <td>${fmtMoney2(profitPerCart)}</td>
          <td>${fmtPct2(marginPct)}</td>
          <td>${fmtMoney0(totalBatchProfit)}</td>
        </tr>`;
      })
      .join('');

    const appliedTier = tierRows.find((r) => r.applies);
    const applicableNote = appliedTier
      ? `<p class="applicable-note">${I18N.applicableNoteApplies
          .replace('{units}', fmtUnits(totalCartsProducible))
          .replace('{tier}', appliedTier.tier.label)}</p>`
      : `<p class="hint">${I18N.applicableNoteNone.replace('{units}', fmtUnits(totalCartsProducible))}</p>`;

    const yieldHint = I18N.yieldHint
      .replace('{oaziz}', fmtG(retainedOazizG))
      .replace('{agMedica}', fmtG(retainedAgMedicaG))
      .replace('{rx}', fmtG(retainedRxG));

    out.innerHTML = `
      ${warnHtml}

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.yieldCardTitle}</h2>
        <div class="yield-row">
          <div class="yield-item">${I18N.yieldPostWash}<strong>${fmtG(postWashYieldG)}</strong></div>
          <div class="yield-item">${I18N.yieldPostPress}<strong>${fmtG(postPressYieldG)}</strong></div>
          <div class="yield-item">${I18N.yieldTotalAvailable}<strong>${fmtG(totalProductAvailableG)}</strong></div>
          <div class="yield-item">${I18N.yieldCartsProducible}<strong>${fmtUnits(totalCartsProducible)}</strong></div>
        </div>
        <p class="hint">
          ${yieldHint}
        </p>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.costPoolsTitle}</h2>
        <div class="cost-line"><span>${I18N.costLineMaterial}</span><span>${fmtMoney2(totalMaterialCost)}</span></div>
        <div class="cost-line"><span>${I18N.costLineLabTests}</span><span>${fmtMoney2(totalLabTestCost)} · ${fmtPerG(labCostPerG)}${I18N.costLineLabTestsSuffix}</span></div>
        <div class="cost-line"><span>${I18N.costLineOazizProcessing}</span><span>${fmtMoney2(totalOazizProcessingCost)}</span></div>
        <div class="cost-line"><span>${I18N.costLineOneTime}</span><span>${fmtMoney2(totalOneTimeCosts)}</span></div>
        <div class="cost-line"><span>${I18N.costLineAgMedica}</span><span>${fmtMoney2(totalAgMedicaCosts)}</span></div>
        <div class="cost-line"><span>${I18N.costLineOtherRx}</span><span>${fmtMoney2(totalOtherRxCosts)}</span></div>
        <div class="cost-line subtotal"><span>${I18N.costLineBulkRosin}</span><span>${fmtPerG(bulkRosinCostPerG)}${I18N.bulkRosinUnitSuffix}</span></div>
        <div class="cost-line subtotal"><span>${I18N.costLineTotalFixed}</span><span>${fmtMoney2(totalTrulyFixedCosts)}</span></div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.costPerCartTitle}</h2>
        ${applicableNote}
        <div style="overflow-x:auto; margin-top: 10px;">
          <table class="calc-table">
            <thead>
              <tr>
                <th>${I18N.costTableColTier}</th>
                <th>${I18N.costTableColTolling}</th>
                <th>${I18N.costTableColVariableRosin}</th>
                <th>${I18N.costTableColFixedAmortized}</th>
                <th>${I18N.costTableColTotalCad}</th>
                <th>${I18N.costTableColTotalGbp}</th>
              </tr>
            </thead>
            <tbody>${costTableRows}</tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <h2>${I18N.marginTitle}</h2>
        ${applicableNote}
        <div style="overflow-x:auto; margin-top: 10px;">
          <table class="calc-table">
            <thead>
              <tr>
                <th>${I18N.marginColTier}</th>
                <th>${I18N.marginColWholesale}</th>
                <th>${I18N.marginColProfit}</th>
                <th>${I18N.marginColMarginPct}</th>
                <th>${I18N.marginColBatchProfit}</th>
              </tr>
            </thead>
            <tbody>${marginRows}</tbody>
          </table>
        </div>
      </div>
    `;
  }

  document.addEventListener('input', (e) => {
    if (!(e.target as HTMLElement)?.closest('.calc-wizard')) return;
    render();
  });
  render();
</script>
