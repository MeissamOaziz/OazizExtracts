---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frFormulationHash, enFormulationHash } from '../../../i18n/portail/formulation-hash';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frFormulationHash, enFormulationHash);

// Strings needed by the client-side render() functions (JSON data island — see
// the <script type="application/json"> below). Keep in sync with every I18N.xxx
// reference in the <script> block further down.
const clientStrings = {
  locale,
  batchSizeWarning: T('batchSizeWarning'),
  feasibleOk: T('feasibleOk'),
  sqdcInfeasible: T('sqdcInfeasible'),
  cbdCapExceeded: T('cbdCapExceeded'),
  recipeCardTitle: T('recipeCardTitle'),
  ingredientKief: T('ingredientKief'),
  ingredientDistCbd: T('ingredientDistCbd'),
  ingredientTerp: T('ingredientTerp'),
  ingredientIsolate: T('ingredientIsolate'),
  ingredientDistThc: T('ingredientDistThc'),
  sanityThc: T('sanityThc'),
  sanityCbd: T('sanityCbd'),
  sanityCbdAssumed: T('sanityCbdAssumed'),
  sanityTotalCost: T('sanityTotalCost'),
  sanityCostPerG: T('sanityCostPerG'),
  econCardTitleSqdc: T('econCardTitleSqdc'),
  econCardTitleDom: T('econCardTitleDom'),
  econNewMethod: T('econNewMethod'),
  econCurrentMethod: T('econCurrentMethod'),
  econRevenue: T('econRevenue'),
  econMaterialsCost: T('econMaterialsCost'),
  econGrossProfit: T('econGrossProfit'),
  econGrossMargin: T('econGrossMargin'),
  econAllInCost: T('econAllInCost'),
  deltaLabel: T('deltaLabel'),
  deltaCheaper: T('deltaCheaper'),
  deltaMoreExpensive: T('deltaMoreExpensive'),
  deltaMoreProfit: T('deltaMoreProfit'),
  deltaLessProfit: T('deltaLessProfit'),
  deltaOnBatch: T('deltaOnBatch'),
  scenarioCardTitle: T('scenarioCardTitle'),
  scenarioHint: T('scenarioHint'),
  scenarioColScenario: T('scenarioColScenario'),
  scenarioColKief: T('scenarioColKief'),
  scenarioColDistillat: T('scenarioColDistillat'),
  scenarioColIsolat: T('scenarioColIsolat'),
  scenarioColCostPerG: T('scenarioColCostPerG'),
  scenarioColBatchCost: T('scenarioColBatchCost'),
  scenarioColProfit: T('scenarioColProfit'),
  scenarioColMargin: T('scenarioColMargin'),
  scenarioConservative: T('scenarioConservative'),
  scenarioNominal: T('scenarioNominal'),
  scenarioFavorable: T('scenarioFavorable'),
  scenarioTerpSuffix: T('scenarioTerpSuffix'),
  benchmarkRowLabel: T('benchmarkRowLabel'),
  domInfeasible: T('domInfeasible'),
  domCapExceeded: T('domCapExceeded'),
  enterSellPrice: T('enterSellPrice'),
  batchCompareCardTitle: T('batchCompareCardTitle'),
  batchCompareHint: T('batchCompareHint'),
  batchCol8kg: T('batchCol8kg'),
  batchCol10kg: T('batchCol10kg'),
  rowKiefG: T('rowKiefG'),
  rowDistThcG: T('rowDistThcG'),
  rowCostPerG: T('rowCostPerG'),
};
---
<PortailLayout title={T('pageTitleTag')} staffName={staff.full_name}>
  <div class="calc-wizard">
    <div style="margin-bottom: 20px;">
      <a href="/portail/calculatrices" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
        {T('backLink')}
      </a>
    </div>
    <h1>{T('pageTitle')}</h1>
    <p style="color: var(--p-muted); margin-bottom: 20px;">
      {T('pageIntro')}
    </p>

    <div class="tab-bar" role="tablist">
      <button type="button" class="tab-btn selected" data-tab="sqdc">{T('tabSqdc')}</button>
      <button type="button" class="tab-btn" data-tab="dom">{T('tabDom')}</button>
    </div>

    <div id="tab-sqdc">
      <p style="color: var(--p-muted); margin-bottom: 24px;">
        {T('sqdcIntro')}
      </p>

      <div class="card" style="margin-bottom: 16px;">
        <h2 set:html={T('cardRawMaterials')} />
        <div class="two-col">
          <div class="form-row">
            <label for="kiefCost">{T('kiefCostLabel')}</label>
            <input type="number" id="kiefCost" value="0.80" step="0.01" />
          </div>
          <div class="form-row">
            <label for="kiefThc">{T('kiefThcLabel')}</label>
            <input type="number" id="kiefThc" value="33.5" step="0.1" />
          </div>
        </div>
        <div class="two-col">
          <div class="form-row">
            <label for="distCost">{T('distCostCbdLabel')}</label>
            <input type="number" id="distCost" value="1.00" step="0.01" />
          </div>
          <div class="form-row">
            <label for="distCbd">{T('distCbdLabel')}</label>
            <input type="number" id="distCbd" value="84.5" step="0.1" />
          </div>
        </div>
        <div class="form-row">
          <label for="isolateCost">{T('isolateCostLabel')}</label>
          <input type="number" id="isolateCost" value="4.50" step="0.01" />
        </div>
        <div class="two-col">
          <div class="form-row">
            <label for="terpCostMl">{T('terpCostLabel')}</label>
            <input type="number" id="terpCostMl" value="30" step="0.5" />
          </div>
          <div class="form-row">
            <label for="terpDensity">{T('terpDensityLabel')}</label>
            <input type="number" id="terpDensity" value="0.90" step="0.01" />
          </div>
        </div>
        <p class="hint">{T('densityHint')}</p>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>{T('cardTargetsCompliance')}</h2>
        <div class="two-col">
          <div class="form-row">
            <label for="maxThc">{T('maxThcLabel')}</label>
            <input type="number" id="maxThc" value="29.5" step="0.1" />
          </div>
          <div class="form-row">
            <label for="maxCbd">{T('maxCbdLabel')}</label>
            <input type="number" id="maxCbd" value="4.0" step="0.1" />
          </div>
        </div>
        <div class="two-col">
          <div class="form-row">
            <label for="cbdFillLevel">{T('cbdFillLevelLabel')}</label>
            <input type="number" id="cbdFillLevel" value="3.75" step="0.05" />
          </div>
          <div class="form-row">
            <label for="terpFraction">{T('terpFractionLabel')}</label>
            <input type="number" id="terpFraction" value="0" step="0.1" />
          </div>
        </div>
        <p class="hint">{T('fillLevelHint')}</p>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2 set:html={T('cardBatchPrice')} />
        <div class="two-col">
          <div class="form-row">
            <label for="batchKg">{T('batchKgLabel')}</label>
            <input type="number" id="batchKg" value="50" step="1" />
          </div>
          <div class="form-row">
            <label for="sellPrice">{T('sellPriceLabel')}</label>
            <input type="number" id="sellPrice" value="1.50" step="0.01" />
          </div>
        </div>
        <div class="form-row">
          <label for="currentCost">{T('currentCostLabel')}</label>
          <input type="number" id="currentCost" value="0.97" step="0.01" />
        </div>
      </div>

      <div id="result-sqdc"></div>
    </div>

    <div id="tab-dom" hidden>
      <p style="color: var(--p-muted); margin-bottom: 24px;" set:html={T('domIntro')} />

      <div class="card" style="margin-bottom: 16px;">
        <h2 set:html={T('cardRawMaterials')} />
        <div class="two-col">
          <div class="form-row">
            <label for="dom_kiefCost">{T('kiefCostLabel')}</label>
            <input type="number" id="dom_kiefCost" value="0.80" step="0.01" />
          </div>
          <div class="form-row">
            <label for="dom_kiefThc">{T('kiefThcLabel')}</label>
            <input type="number" id="dom_kiefThc" value="33.5" step="0.1" />
          </div>
        </div>
        <div class="two-col">
          <div class="form-row">
            <label for="dom_distCost">{T('distCostThcLabel')}</label>
            <input type="number" id="dom_distCost" value="1.60" step="0.01" />
          </div>
          <div class="form-row">
            <label for="dom_distThc">{T('distThcLabel')}</label>
            <input type="number" id="dom_distThc" value="84" step="0.1" />
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>{T('cardSpecCompliance')}</h2>
        <div class="two-col">
          <div class="form-row">
            <label for="dom_thcTarget">{T('domThcTargetLabel')}</label>
            <input type="number" id="dom_thcTarget" value="48" step="0.5" />
          </div>
          <div class="form-row">
            <label for="dom_maxThc">{T('domMaxThcLabel')}</label>
            <input type="number" id="dom_maxThc" value="50" step="0.5" />
          </div>
        </div>
        <p class="hint">{T('domHintLowerTarget')}</p>
        <p class="hint">{T('domHintCbdCap')}</p>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2 set:html={T('cardBatchPrice')} />
        <div class="two-col">
          <div class="form-row">
            <label for="dom_batchKg">{T('batchKgLabel')}</label>
            <input type="number" id="dom_batchKg" value="10" step="1" />
          </div>
          <div class="form-row">
            <label for="dom_sellPrice">{T('domSellPriceLabel')}</label>
            <input type="number" id="dom_sellPrice" value="0" step="0.01" />
          </div>
        </div>
      </div>

      <div id="result-dom"></div>
    </div>
  </div>
</PortailLayout>

<script type="application/json" id="calc-i18n-data" set:html={JSON.stringify(clientStrings)}></script>

<style is:global>
  .tab-bar { display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid var(--p-border); }
  .tab-btn {
    border: none;
    background: none;
    padding: 10px 4px;
    margin-bottom: -1px;
    font-family: inherit;
    font-size: .92rem;
    font-weight: 600;
    color: var(--p-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .tab-btn + .tab-btn { margin-left: 12px; }
  .tab-btn:hover { color: var(--p-text); }
  .tab-btn.selected { color: var(--p-accent); border-bottom-color: #d05826; }

  .formulation-recipe { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .formulation-ingredient { background: var(--p-bg); border: 1px solid var(--p-border); border-radius: 10px; padding: 12px 14px; }
  .formulation-ingredient-name { font-size: .78rem; font-weight: 600; color: var(--p-muted); margin-bottom: 6px; }
  .formulation-ingredient-pct { font-size: 1.2rem; font-weight: 700; }
  .formulation-ingredient-mass { font-size: .78rem; color: var(--p-muted); margin-top: 2px; }

  .feasibility-banner { padding: 10px 14px; border-radius: 8px; font-size: .87rem; margin-bottom: 16px; font-weight: 600; }
  .feasibility-ok { background: #f0fdf4; border: 1px solid #bbf7d0; color: var(--p-success); }
  .feasibility-bad { background: #fef2f2; border: 1px solid #fecaca; color: var(--p-danger); }

  .sanity-row { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .sanity-item { flex: 1; min-width: 160px; font-size: .85rem; color: var(--p-muted); }
  .sanity-item strong { display: block; font-size: 1.05rem; color: var(--p-text); font-variant-numeric: tabular-nums; }

  .econ-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 8px; }
  @media (max-width: 600px) { .econ-compare { grid-template-columns: 1fr; } }
  .econ-col { border: 1px solid var(--p-border); border-radius: 10px; padding: 16px; }
  .econ-col.new-method { border-color: rgba(208, 88, 38, .3); background: rgba(208, 88, 38, .04); }
  .econ-col h3 { font-size: .85rem; font-weight: 700; margin-bottom: 10px; }
  .econ-line { display: flex; justify-content: space-between; padding: 4px 0; font-size: .85rem; }
  .econ-line span:first-child { color: var(--p-muted); }
  .econ-line.total { border-top: 1px solid var(--p-border); margin-top: 6px; padding-top: 8px; font-weight: 700; }

  .delta-banner { margin-top: 16px; padding: 12px 14px; border-radius: 8px; font-size: .88rem; text-align: center; font-weight: 600; }
  .delta-positive { background: #f0fdf4; border: 1px solid #bbf7d0; color: var(--p-success); }
  .delta-negative { background: #fef2f2; border: 1px solid #fecaca; color: var(--p-danger); }

  table.scenario-table { width: 100%; border-collapse: collapse; font-size: .82rem; font-variant-numeric: tabular-nums; }
  table.scenario-table th, table.scenario-table td { padding: 8px 8px; text-align: right; border-bottom: 1px solid var(--p-border); white-space: nowrap; }
  table.scenario-table th:first-child, table.scenario-table td:first-child { text-align: left; white-space: normal; min-width: 150px; }
  table.scenario-table th { font-weight: 600; color: var(--p-muted); font-size: .68rem; text-transform: uppercase; }
  table.scenario-table tbody tr.benchmark-row { background: var(--p-bg); font-style: italic; }

  table.batch-compare { width: 100%; border-collapse: collapse; font-size: .87rem; font-variant-numeric: tabular-nums; margin-top: 8px; }
  table.batch-compare th, table.batch-compare td { padding: 8px 10px; text-align: right; border-bottom: 1px solid var(--p-border); }
  table.batch-compare th:first-child, table.batch-compare td:first-child { text-align: left; }
  table.batch-compare th { font-weight: 600; color: var(--p-muted); font-size: .72rem; text-transform: uppercase; }
</style>

<script>
  const I18N = JSON.parse(document.getElementById('calc-i18n-data')!.textContent!);

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isFinite(v) ? v : 0;
  }
  function pct(id: string): number {
    return num(id) / 100;
  }

  const localeTag = I18N.locale === 'en' ? 'en-CA' : 'fr-CA';
  const fmtMoney2 = (n: number) =>
    isFinite(n) ? n.toLocaleString(localeTag, { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtMoney0 = (n: number) =>
    isFinite(n) ? n.toLocaleString(localeTag, { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }) : '—';
  const fmtPerG = (n: number) => (isFinite(n) ? '$' + n.toFixed(4) : '—');
  const fmtPct1 = (n: number) => (isFinite(n) ? (n * 100).toFixed(1) + '%' : '—');
  const fmtPct2 = (n: number) => (isFinite(n) ? (n * 100).toFixed(2) + '%' : '—');
  const fmtG = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString(localeTag) + ' g' : '—');

  // ---------- Tabs ----------
  document.querySelectorAll<HTMLElement>('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.tab-btn').forEach((b) => b.classList.remove('selected'));
      btn.classList.add('selected');
      const tab = btn.dataset.tab;
      (document.getElementById('tab-sqdc') as HTMLElement).hidden = tab !== 'sqdc';
      (document.getElementById('tab-dom') as HTMLElement).hidden = tab !== 'dom';
    });
  });

  // ---------- SQDC (dilution blend) ----------
  type Recipe = {
    kiefFraction: number;
    distFraction: number;
    terpFraction: number;
    isolateFraction: number;
    feasible: boolean;
    resultingThc: number;
    resultingCbd: number;
    costPerG: number;
  };

  function computeRecipe(
    maxThc: number,
    kiefThc: number,
    cbdFillLevel: number,
    distCbd: number,
    terpFraction: number,
    kiefCost: number,
    distCost: number,
    terpCostPerG: number,
    isolateCost: number
  ): Recipe {
    const kiefFraction = kiefThc > 0 ? maxThc / kiefThc : 0;
    const distFraction = distCbd > 0 ? cbdFillLevel / distCbd : 0;
    const isolateFraction = 1 - kiefFraction - distFraction - terpFraction;
    const costPerG = kiefFraction * kiefCost + distFraction * distCost + terpFraction * terpCostPerG + isolateFraction * isolateCost;
    return {
      kiefFraction,
      distFraction,
      terpFraction,
      isolateFraction,
      feasible: isolateFraction >= 0,
      resultingThc: kiefFraction * kiefThc,
      resultingCbd: distFraction * distCbd,
      costPerG,
    };
  }

  const SCENARIOS = [
    { label: I18N.scenarioConservative, kiefThc: 0.34, distCbd: 0.83 },
    { label: I18N.scenarioNominal, kiefThc: 0.335, distCbd: 0.845 },
    { label: I18N.scenarioFavorable, kiefThc: 0.33, distCbd: 0.86 },
  ];

  function renderSqdc() {
    const out = document.getElementById('result-sqdc');
    if (!out) return;

    const kiefCost = num('kiefCost');
    const kiefThc = pct('kiefThc');
    const distCost = num('distCost');
    const distCbd = pct('distCbd');
    const isolateCost = num('isolateCost');
    const terpCostPerG = num('terpDensity') > 0 ? num('terpCostMl') / num('terpDensity') : 0;

    const maxThc = pct('maxThc');
    const maxCbd = pct('maxCbd');
    const cbdFillLevel = pct('cbdFillLevel');
    const terpFraction = pct('terpFraction');

    const batchKg = num('batchKg');
    const batchG = batchKg * 1000;
    const sellPrice = num('sellPrice');
    const currentCostPerGram = num('currentCost');

    if (batchKg <= 0) {
      out.innerHTML = `<div class="warn-banner">${I18N.batchSizeWarning}</div>`;
      return;
    }

    const r = computeRecipe(maxThc, kiefThc, cbdFillLevel, distCbd, terpFraction, kiefCost, distCost, terpCostPerG, isolateCost);

    const kiefMass = r.kiefFraction * batchG;
    const distMass = r.distFraction * batchG;
    const terpMass = r.terpFraction * batchG;
    const isolateMass = r.isolateFraction * batchG;

    const kiefCostTotal = kiefMass * kiefCost;
    const distCostTotal = distMass * distCost;
    const terpCostTotal = terpMass * terpCostPerG;
    const isolateCostTotal = isolateMass * isolateCost;
    const totalCost = kiefCostTotal + distCostTotal + terpCostTotal + isolateCostTotal;

    const revenue = batchG * sellPrice;
    const newProfit = revenue - totalCost;
    const newMargin = revenue > 0 ? newProfit / revenue : 0;
    const currentCostTotal = batchG * currentCostPerGram;
    const currentProfit = revenue - currentCostTotal;
    const currentMargin = revenue > 0 ? currentProfit / revenue : 0;
    const deltaPerG = currentCostPerGram - r.costPerG;
    const deltaTotal = newProfit - currentProfit;

    let feasibilityHtml = r.feasible
      ? `<div class="feasibility-banner feasibility-ok">${I18N.feasibleOk}</div>`
      : `<div class="feasibility-banner feasibility-bad">${I18N.sqdcInfeasible}</div>`;
    if (r.feasible && cbdFillLevel > maxCbd) {
      const cbdCapMsg = I18N.cbdCapExceeded
        .replace('{fill}', fmtPct2(cbdFillLevel))
        .replace('{cap}', fmtPct2(maxCbd));
      feasibilityHtml += `<div class="feasibility-banner feasibility-bad">${cbdCapMsg}</div>`;
    }

    const scenarioRows = SCENARIOS
      .flatMap((s) => [
        { ...s, terpLevel: 0, terpLabel: '' },
        { ...s, terpLevel: 0.01, terpLabel: I18N.scenarioTerpSuffix },
      ])
      .map((s) => {
        const sr = computeRecipe(maxThc, s.kiefThc, cbdFillLevel, s.distCbd, s.terpLevel, kiefCost, distCost, terpCostPerG, isolateCost);
        const batchCost = sr.costPerG * batchG;
        const profit = revenue - batchCost;
        const margin = revenue > 0 ? profit / revenue : 0;
        return `<tr>
          <td>${s.label}${s.terpLabel}</td>
          <td>${fmtPct1(sr.kiefFraction)}</td>
          <td>${fmtPct1(sr.distFraction)}</td>
          <td>${fmtPct1(sr.isolateFraction)}</td>
          <td>${fmtPerG(sr.costPerG)}</td>
          <td>${fmtMoney0(batchCost)}</td>
          <td>${fmtMoney0(profit)}</td>
          <td>${fmtPct1(margin)}</td>
        </tr>`;
      })
      .join('');

    const benchmarkRow = `<tr class="benchmark-row">
      <td>${I18N.benchmarkRowLabel}</td>
      <td>—</td><td>—</td><td>—</td>
      <td>${fmtPerG(currentCostPerGram)}</td>
      <td>${fmtMoney0(currentCostTotal)}</td>
      <td>${fmtMoney0(currentProfit)}</td>
      <td>${fmtPct1(currentMargin)}</td>
    </tr>`;

    const deltaMsg = `${deltaPerG >= 0 ? '✓' : '⚠'} ${I18N.deltaLabel} ${fmtPerG(Math.abs(deltaPerG))}/g ${deltaPerG >= 0 ? I18N.deltaCheaper : I18N.deltaMoreExpensive}
          — ${fmtMoney0(Math.abs(deltaTotal))} ${deltaTotal >= 0 ? I18N.deltaMoreProfit : I18N.deltaLessProfit} ${I18N.deltaOnBatch}`;

    out.innerHTML = `
      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.recipeCardTitle}</h2>
        ${feasibilityHtml}
        <div class="formulation-recipe">
          <div class="formulation-ingredient">
            <div class="formulation-ingredient-name">${I18N.ingredientKief}</div>
            <div class="formulation-ingredient-pct">${fmtPct1(r.kiefFraction)}</div>
            <div class="formulation-ingredient-mass">${fmtG(kiefMass)} · ${fmtMoney2(kiefCostTotal)}</div>
          </div>
          <div class="formulation-ingredient">
            <div class="formulation-ingredient-name">${I18N.ingredientDistCbd}</div>
            <div class="formulation-ingredient-pct">${fmtPct1(r.distFraction)}</div>
            <div class="formulation-ingredient-mass">${fmtG(distMass)} · ${fmtMoney2(distCostTotal)}</div>
          </div>
          <div class="formulation-ingredient">
            <div class="formulation-ingredient-name">${I18N.ingredientTerp}</div>
            <div class="formulation-ingredient-pct">${fmtPct1(r.terpFraction)}</div>
            <div class="formulation-ingredient-mass">${fmtG(terpMass)} · ${fmtMoney2(terpCostTotal)}</div>
          </div>
          <div class="formulation-ingredient">
            <div class="formulation-ingredient-name">${I18N.ingredientIsolate}</div>
            <div class="formulation-ingredient-pct">${fmtPct1(r.isolateFraction)}</div>
            <div class="formulation-ingredient-mass">${fmtG(isolateMass)} · ${fmtMoney2(isolateCostTotal)}</div>
          </div>
        </div>
        <div class="sanity-row">
          <div class="sanity-item">${I18N.sanityThc}<strong>${fmtPct2(r.resultingThc)}</strong></div>
          <div class="sanity-item">${I18N.sanityCbd}<strong>${fmtPct2(r.resultingCbd)}</strong></div>
          <div class="sanity-item">${I18N.sanityTotalCost}<strong>${fmtMoney2(totalCost)}</strong></div>
          <div class="sanity-item">${I18N.sanityCostPerG}<strong>${fmtPerG(r.costPerG)}</strong></div>
        </div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.econCardTitleSqdc}</h2>
        <div class="econ-compare">
          <div class="econ-col new-method">
            <h3>${I18N.econNewMethod}</h3>
            <div class="econ-line"><span>${I18N.econRevenue}</span><span>${fmtMoney0(revenue)}</span></div>
            <div class="econ-line"><span>${I18N.econMaterialsCost}</span><span>${fmtMoney0(totalCost)}</span></div>
            <div class="econ-line total"><span>${I18N.econGrossProfit}</span><span>${fmtMoney0(newProfit)}</span></div>
            <div class="econ-line"><span>${I18N.econGrossMargin}</span><span>${fmtPct1(newMargin)}</span></div>
          </div>
          <div class="econ-col">
            <h3>${I18N.econCurrentMethod}</h3>
            <div class="econ-line"><span>${I18N.econRevenue}</span><span>${fmtMoney0(revenue)}</span></div>
            <div class="econ-line"><span>${I18N.econAllInCost}</span><span>${fmtMoney0(currentCostTotal)}</span></div>
            <div class="econ-line total"><span>${I18N.econGrossProfit}</span><span>${fmtMoney0(currentProfit)}</span></div>
            <div class="econ-line"><span>${I18N.econGrossMargin}</span><span>${fmtPct1(currentMargin)}</span></div>
          </div>
        </div>
        <div class="delta-banner ${deltaPerG >= 0 ? 'delta-positive' : 'delta-negative'}">
          ${deltaMsg}
        </div>
      </div>

      <div class="card">
        <h2>${I18N.scenarioCardTitle}</h2>
        <p class="hint" style="margin-bottom: 12px;">
          ${I18N.scenarioHint}
        </p>
        <div style="overflow-x:auto;">
          <table class="scenario-table">
            <thead>
              <tr>
                <th>${I18N.scenarioColScenario}</th><th>${I18N.scenarioColKief}</th><th>${I18N.scenarioColDistillat}</th><th>${I18N.scenarioColIsolat}</th>
                <th>${I18N.scenarioColCostPerG}</th><th>${I18N.scenarioColBatchCost}</th><th>${I18N.scenarioColProfit}</th><th>${I18N.scenarioColMargin}</th>
              </tr>
            </thead>
            <tbody>${scenarioRows}${benchmarkRow}</tbody>
          </table>
        </div>
      </div>
    `;
  }

  // ---------- DOM (boost blend) ----------
  function renderDom() {
    const out = document.getElementById('result-dom');
    if (!out) return;

    const kiefCost = num('dom_kiefCost');
    const kiefThc = pct('dom_kiefThc');
    const distCost = num('dom_distCost');
    const distThc = pct('dom_distThc');

    const thcTarget = pct('dom_thcTarget');
    const maxThc = pct('dom_maxThc');

    const batchKg = num('dom_batchKg');
    const batchG = batchKg * 1000;
    const sellPrice = num('dom_sellPrice');

    if (batchKg <= 0) {
      out.innerHTML = `<div class="warn-banner">${I18N.batchSizeWarning}</div>`;
      return;
    }

    const denom = distThc - kiefThc;
    const kiefFraction = denom !== 0 ? (distThc - thcTarget) / denom : NaN;
    const distFraction = 1 - kiefFraction;
    const feasible = isFinite(kiefFraction) && kiefFraction >= 0 && kiefFraction <= 1;

    const resultingThc = kiefFraction * kiefThc + distFraction * distThc;
    const resultingCbd = 0;

    const kiefMass = kiefFraction * batchG;
    const distMass = distFraction * batchG;
    const kiefCostTotal = kiefMass * kiefCost;
    const distCostTotal = distMass * distCost;
    const totalCost = kiefCostTotal + distCostTotal;
    const costPerG = totalCost / batchG;

    const revenue = batchG * sellPrice;
    const profit = revenue - totalCost;
    const marginHtml = sellPrice === 0 ? I18N.enterSellPrice : fmtPct1(profit / revenue);

    const feasibilityHtml = feasible
      ? `<div class="feasibility-banner feasibility-ok">${I18N.feasibleOk}</div>`
      : `<div class="feasibility-banner feasibility-bad">${I18N.domInfeasible}</div>`;

    const capHtml = resultingThc > maxThc
      ? `<div class="feasibility-banner feasibility-bad">${I18N.domCapExceeded.replace('{cap}', fmtPct1(maxThc))}</div>`
      : '';

    const kief8 = kiefFraction * 8000;
    const dist8 = distFraction * 8000;
    const cost8 = costPerG * 8000;
    const kief10 = kiefFraction * 10000;
    const dist10 = distFraction * 10000;
    const cost10 = costPerG * 10000;

    out.innerHTML = `
      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.recipeCardTitle}</h2>
        ${feasibilityHtml}
        ${capHtml}
        <div class="formulation-recipe">
          <div class="formulation-ingredient">
            <div class="formulation-ingredient-name">${I18N.ingredientKief}</div>
            <div class="formulation-ingredient-pct">${fmtPct1(kiefFraction)}</div>
            <div class="formulation-ingredient-mass">${fmtG(kiefMass)} · ${fmtMoney2(kiefCostTotal)}</div>
          </div>
          <div class="formulation-ingredient">
            <div class="formulation-ingredient-name">${I18N.ingredientDistThc}</div>
            <div class="formulation-ingredient-pct">${fmtPct1(distFraction)}</div>
            <div class="formulation-ingredient-mass">${fmtG(distMass)} · ${fmtMoney2(distCostTotal)}</div>
          </div>
        </div>
        <div class="sanity-row">
          <div class="sanity-item">${I18N.sanityThc}<strong>${fmtPct2(resultingThc)}</strong></div>
          <div class="sanity-item">${I18N.sanityCbdAssumed}<strong>${fmtPct2(resultingCbd)}</strong></div>
          <div class="sanity-item">${I18N.sanityTotalCost}<strong>${fmtMoney2(totalCost)}</strong></div>
          <div class="sanity-item">${I18N.sanityCostPerG}<strong>${fmtPerG(costPerG)}</strong></div>
        </div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.econCardTitleDom}</h2>
        <div class="econ-compare" style="grid-template-columns: 1fr;">
          <div class="econ-col new-method">
            <div class="econ-line"><span>${I18N.econRevenue}</span><span>${fmtMoney0(revenue)}</span></div>
            <div class="econ-line"><span>${I18N.econMaterialsCost}</span><span>${fmtMoney0(totalCost)}</span></div>
            <div class="econ-line total"><span>${I18N.econGrossProfit}</span><span>${fmtMoney0(profit)}</span></div>
            <div class="econ-line"><span>${I18N.econGrossMargin}</span><span>${marginHtml}</span></div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2>${I18N.batchCompareCardTitle}</h2>
        <p class="hint" style="margin-bottom: 12px;">${I18N.batchCompareHint}</p>
        <table class="batch-compare">
          <thead><tr><th></th><th>${I18N.batchCol8kg}</th><th>${I18N.batchCol10kg}</th></tr></thead>
          <tbody>
            <tr><td>${I18N.rowKiefG}</td><td>${fmtG(kief8)}</td><td>${fmtG(kief10)}</td></tr>
            <tr><td>${I18N.rowDistThcG}</td><td>${fmtG(dist8)}</td><td>${fmtG(dist10)}</td></tr>
            <tr><td>${I18N.rowCostPerG}</td><td>${fmtPerG(costPerG)}</td><td>${fmtPerG(costPerG)}</td></tr>
            <tr><td>${I18N.sanityTotalCost}</td><td>${fmtMoney2(cost8)}</td><td>${fmtMoney2(cost10)}</td></tr>
          </tbody>
        </table>
      </div>
    `;
  }

  document.addEventListener('input', (e) => {
    if (!(e.target as HTMLElement)?.closest('.calc-wizard')) return;
    renderSqdc();
    renderDom();
  });
  renderSqdc();
  renderDom();
</script>
