---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frExportAllemagneTcheque, enExportAllemagneTcheque } from '../../../i18n/portail/export-allemagne-tcheque';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frExportAllemagneTcheque, enExportAllemagneTcheque);

const clientStrings = {
  locale,
  volumeWarning: T('result.volumeWarning'),
  headlineHeading: T('result.headline.heading'),
  headlineHint: T('result.headline.hint'),
  headlineTotalCostLabel: T('result.headline.totalCostLabel'),
  headlineSellPriceTotalLabel: T('result.headline.sellPriceTotalLabel'),
  headlineSellPricePerGramLabel: T('result.headline.sellPricePerGramLabel'),
  headlineProfitLabel: T('result.headline.profitLabel'),
  headlineVolumeSub: T('result.headline.volumeSub'),
  upstreamHeading: T('result.upstream.heading'),
  upstreamFlower: T('result.upstream.flower'),
  upstreamShippingToGwng: T('result.upstream.shippingToGwng'),
  upstreamGwngHandling: T('result.upstream.gwngHandling'),
  upstreamShippingToCzech: T('result.upstream.shippingToCzech'),
  upstreamTotal: T('result.upstream.total'),
  setupHeading: T('result.setup.heading'),
  setupGrowerRegistry: T('result.setup.growerRegistry'),
  setupProductRegistration: T('result.setup.productRegistration'),
  setupGermanSetupFee: T('result.setup.germanSetupFee'),
  setupTotal: T('result.setup.total'),
  processingHeading: T('result.processing.heading'),
  processingRetentionSample: T('result.processing.retentionSample'),
  processingRetentionSampleSuffix: T('result.processing.retentionSampleSuffix'),
  processingGacpToGmp: T('result.processing.gacpToGmp'),
  processingSalesCommission: T('result.processing.salesCommission'),
  processingRemediationLabel: T('result.processing.remediationLabel'),
  processingRemediationIncluded: T('result.processing.remediationIncluded'),
  processingRemediationNotIncluded: T('result.processing.remediationNotIncluded'),
  monthlyHeading: T('result.monthly.heading'),
  monthlyEntrepreneurLabel: T('result.monthly.entrepreneurLabel'),
  monthlyPharmacyDelivery: T('result.monthly.pharmacyDelivery'),
  summaryHeading: T('result.summary.heading'),
  summaryHint: T('result.summary.hint'),
  summaryThScenario: T('result.summary.thScenario'),
  summaryThTotalCad: T('result.summary.thTotalCad'),
  scenarioWithCommissionNoRemediation: T('result.scenario.withCommissionNoRemediation'),
  scenarioNoCommissionNoRemediation: T('result.scenario.noCommissionNoRemediation'),
  scenarioWithCommissionWithRemediation: T('result.scenario.withCommissionWithRemediation'),
  scenarioNoCommissionWithRemediation: T('result.scenario.noCommissionWithRemediation'),
  detailsSummary: T('result.details.summary'),
  detailsWithCommission: T('result.details.withCommission'),
  detailsWithoutCommission: T('result.details.withoutCommission'),
};
---
<PortailLayout title={T('pageTitle')} staffName={staff.full_name}>
  <div class="calc-wizard">
    <div style="margin-bottom: 20px;">
      <a href="/portail/calculatrices" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
        {T('backLink')}
      </a>
    </div>
    <h1>{T('heading')}</h1>
    <p style="color: var(--p-muted); margin-bottom: 20px;">
      {T('intro')}
    </p>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('currency.heading')}</h2>
      <div class="form-row">
        <label for="cadToEur">{T('currency.fxRate')}</label>
        <input type="number" id="cadToEur" value="0.67" step="0.01" />
      </div>
      <p class="hint">{T('currency.fxHint')}</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('volume.heading')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="shipmentVolumeG">{T('volume.shipmentVolume')}</label>
          <input type="number" id="shipmentVolumeG" value="19950" step="1" />
        </div>
        <div class="form-row">
          <label for="bagSizeG">{T('volume.bagSize')}</label>
          <input type="number" id="bagSizeG" value="150" step="1" />
        </div>
      </div>
      <div class="form-row">
        <label for="numStrains">{T('volume.numStrains')}</label>
        <input type="number" id="numStrains" value="1" step="1" />
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('upstream.heading')}</h2>
      <div class="form-row">
        <label for="flowerPurchaseCostCad">{T('upstream.flowerCost')}</label>
        <input type="number" id="flowerPurchaseCostCad" value="3.25" step="0.01" />
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="shippingSupplierToGwngFlat">{T('upstream.shippingSupplierToGwng')}</label>
          <input type="number" id="shippingSupplierToGwngFlat" value="200" step="1" />
        </div>
        <div class="form-row">
          <label for="gwngHandlingFeeCadPerG">{T('upstream.gwngHandling')}</label>
          <input type="number" id="gwngHandlingFeeCadPerG" value="0.10" step="0.01" />
        </div>
      </div>
      <div class="form-row">
        <label for="shippingGwngToCzechCadPerG">{T('upstream.shippingGwngToCzech')}</label>
        <input type="number" id="shippingGwngToCzechCadPerG" value="0.15" step="0.01" />
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('setup.heading')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="growerRegistryFeeEur">{T('setup.growerRegistry')}</label>
          <input type="number" id="growerRegistryFeeEur" value="1200" step="1" />
        </div>
        <div class="form-row">
          <label for="productRegistrationFeeEur">{T('setup.productRegistration')}</label>
          <input type="number" id="productRegistrationFeeEur" value="10" step="1" />
        </div>
      </div>
      <div class="form-row">
        <label for="germanSetupFeeEur">{T('setup.germanSetupFee')}</label>
        <input type="number" id="germanSetupFeeEur" value="2500" step="1" />
      </div>
      <p class="hint">{T('setup.hint')}</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('processing.heading')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="retentionSampleG">{T('processing.retentionSample')}</label>
          <input type="number" id="retentionSampleG" value="600" step="1" />
        </div>
        <div class="form-row">
          <label for="gacpToGmpProcessingEurPerG">{T('processing.gacpToGmp')}</label>
          <input type="number" id="gacpToGmpProcessingEurPerG" value="0.50" step="0.01" />
        </div>
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="remediationSurchargeEurPerG">{T('processing.remediationSurcharge')}</label>
          <input type="number" id="remediationSurchargeEurPerG" value="0.10" step="0.01" />
        </div>
        <div class="form-row">
          <label for="salesCommissionEurPerG">{T('processing.salesCommission')}</label>
          <input type="number" id="salesCommissionEurPerG" value="0.50" step="0.01" />
        </div>
      </div>
      <div class="checkbox-row">
        <input type="checkbox" id="includeRemediation" />
        <label for="includeRemediation">{T('processing.includeRemediation')}</label>
      </div>
      <p class="hint">{T('processing.hint')}</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('monthly.heading')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="germanEntrepreneurFeeEurPerMonth">{T('monthly.entrepreneurFee')}</label>
          <input type="number" id="germanEntrepreneurFeeEurPerMonth" value="2500" step="1" />
        </div>
        <div class="form-row">
          <label for="shipmentsPerMonth">{T('monthly.shipmentsPerMonth')}</label>
          <input type="number" id="shipmentsPerMonth" value="1" step="1" />
        </div>
      </div>
      <div class="form-row">
        <label for="pharmacyDeliveryFeeEurPerG">{T('monthly.pharmacyDeliveryFee')}</label>
        <input type="number" id="pharmacyDeliveryFeeEurPerG" value="0.10" step="0.01" />
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('price.heading')}</h2>
      <div class="form-row">
        <label for="oazizMarkupPct">{T('price.markup')}</label>
        <input type="number" id="oazizMarkupPct" value="50" step="1" />
      </div>
    </div>

    <div id="result"></div>
  </div>
</PortailLayout>

<script type="application/json" id="calc-i18n-data" set:html={JSON.stringify(clientStrings)}></script>

<style is:global>
  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px 0;
  }
  .checkbox-row input[type="checkbox"] { margin: 0; width: 16px; height: 16px; }
  .checkbox-row label { margin: 0; font-weight: 600; cursor: pointer; }

  .headline-card {
    border: 1px solid rgba(208, 88, 38, .35);
    background: rgba(208, 88, 38, .05);
  }
  .headline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-top: 8px;
  }
  .headline-stat-label { font-size: .78rem; font-weight: 600; color: var(--p-muted); margin-bottom: 4px; }
  .headline-stat-value { font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .headline-stat-sub { font-size: .8rem; color: var(--p-muted); margin-top: 2px; }

  table.export-table { width: 100%; border-collapse: collapse; font-size: .87rem; font-variant-numeric: tabular-nums; }
  table.export-table th, table.export-table td { padding: 8px 10px; text-align: right; border-bottom: 1px solid var(--p-border); }
  table.export-table th:first-child, table.export-table td:first-child { text-align: left; }
  table.export-table th { font-weight: 600; color: var(--p-muted); font-size: .72rem; text-transform: uppercase; }
  table.export-table tbody tr.primary-row { background: rgba(208, 88, 38, .06); font-weight: 600; }
  table.export-table tfoot td { font-weight: 700; border-top: 2px solid var(--p-border); border-bottom: none; }

  .breakdown-line { display: flex; justify-content: space-between; padding: 4px 0; font-size: .85rem; }
  .breakdown-line span:first-child { color: var(--p-muted); }
  .breakdown-line.total { border-top: 1px solid var(--p-border); margin-top: 6px; padding-top: 8px; font-weight: 700; }
</style>

<script>
  const I18N = JSON.parse(document.getElementById('calc-i18n-data')!.textContent!);
  const NUM_LOCALE = I18N.locale === 'en' ? 'en-CA' : 'fr-CA';

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isFinite(v) ? v : 0;
  }
  function checked(id: string): boolean {
    const el = document.getElementById(id) as HTMLInputElement | null;
    return !!el?.checked;
  }

  const fmtMoney2 = (n: number) =>
    isFinite(n) ? n.toLocaleString(NUM_LOCALE, { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtPerG = (n: number) => (isFinite(n) ? '$' + n.toFixed(4) : '—');
  const fmtPct1 = (n: number) => (isFinite(n) ? (n * 100).toFixed(1) + '%' : '—');
  const fmtG = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString(NUM_LOCALE) + ' g' : '—');
  const fmtNum = (n: number) => (isFinite(n) ? n.toLocaleString(NUM_LOCALE, { maximumFractionDigits: 2 }) : '—');

  const fmtEur2 = (n: number) => (isFinite(n) ? n.toLocaleString(NUM_LOCALE, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €' : '—');
  const fmtEurPerG = (n: number) => (isFinite(n) ? n.toFixed(4) + ' €' : '—');

  function render() {
    const out = document.getElementById('result');
    if (!out) return;

    const cadToEur = num('cadToEur');
    const eurToCad = cadToEur > 0 ? 1 / cadToEur : 0;

    const shipmentVolumeG = num('shipmentVolumeG');
    const bagSizeG = num('bagSizeG');
    const numStrains = num('numStrains');
    const bagsPerShipment = bagSizeG > 0 ? shipmentVolumeG / bagSizeG : 0;

    if (shipmentVolumeG <= 0) {
      out.innerHTML = `<div class="warn-banner">${I18N.volumeWarning}</div>`;
      return;
    }

    // ---------- Upstream (CAD) ----------
    const flowerPurchaseCostCad = num('flowerPurchaseCostCad');
    const shippingSupplierToGwngFlat = num('shippingSupplierToGwngFlat');
    const gwngHandlingFeeCadPerG = num('gwngHandlingFeeCadPerG');
    const shippingGwngToCzechCadPerG = num('shippingGwngToCzechCadPerG');

    const flowerPurchaseTotalCad = flowerPurchaseCostCad * shipmentVolumeG;
    const shippingSupplierToGwngCad = shippingSupplierToGwngFlat * (shipmentVolumeG / 25000);
    const gwngHandlingTotalCad = gwngHandlingFeeCadPerG * shipmentVolumeG;
    const shippingGwngToCzechCad = shippingGwngToCzechCadPerG * shipmentVolumeG;
    const upstreamTotalCad = flowerPurchaseTotalCad + shippingSupplierToGwngCad + gwngHandlingTotalCad + shippingGwngToCzechCad;

    // ---------- One-time setup (EUR) — informational only ----------
    const growerRegistryFeeEur = num('growerRegistryFeeEur');
    const productRegistrationFeeEur = num('productRegistrationFeeEur');
    const germanSetupFeeEur = num('germanSetupFeeEur');
    const totalSetupCostsEur = growerRegistryFeeEur + productRegistrationFeeEur + germanSetupFeeEur;

    // ---------- Czech processing (EUR) ----------
    const retentionSampleG = num('retentionSampleG');
    const gacpToGmpProcessingEurPerG = num('gacpToGmpProcessingEurPerG');
    const remediationSurchargeEurPerG = num('remediationSurchargeEurPerG');
    const salesCommissionEurPerG = num('salesCommissionEurPerG');
    const includeRemediation = checked('includeRemediation');

    const retentionSampleTotalG = retentionSampleG * numStrains;
    const saleableVolumeG = shipmentVolumeG - retentionSampleTotalG;
    const gacpToGmpTotalEur = gacpToGmpProcessingEurPerG * shipmentVolumeG;
    const remediationTotalEur = remediationSurchargeEurPerG * shipmentVolumeG;
    const salesCommissionTotalEur = salesCommissionEurPerG * saleableVolumeG;

    // ---------- German fixed monthly (EUR), allocated per shipment ----------
    const germanEntrepreneurFeeEurPerMonth = num('germanEntrepreneurFeeEurPerMonth');
    const shipmentsPerMonth = num('shipmentsPerMonth');
    const pharmacyDeliveryFeeEurPerG = num('pharmacyDeliveryFeeEurPerG');

    const germanEntrepreneurPerShipmentEur = shipmentsPerMonth > 0 ? germanEntrepreneurFeeEurPerMonth / shipmentsPerMonth : 0;
    const pharmacyDeliveryTotalEur = pharmacyDeliveryFeeEurPerG * shipmentVolumeG;

    // ---------- Retention sample cost (lost flower value) — CAD ----------
    const retentionSampleCostCad = retentionSampleTotalG * flowerPurchaseCostCad;

    // ---------- EUR figures converted to CAD (CAD amount = EUR amount × eurToCad, i.e. × 1/cadToEur) ----------
    const gacpToGmpTotalCad = gacpToGmpTotalEur * eurToCad;
    const remediationTotalCad = remediationTotalEur * eurToCad;
    const salesCommissionTotalCad = salesCommissionTotalEur * eurToCad;
    const pharmacyDeliveryTotalCad = pharmacyDeliveryTotalEur * eurToCad;
    const germanEntrepreneurPerShipmentCad = germanEntrepreneurPerShipmentEur * eurToCad;

    const totalCostPerShipmentCad_withCommission =
      flowerPurchaseTotalCad + shippingSupplierToGwngCad + gwngHandlingTotalCad + shippingGwngToCzechCad +
      gacpToGmpTotalCad + retentionSampleCostCad + salesCommissionTotalCad + pharmacyDeliveryTotalCad + germanEntrepreneurPerShipmentCad;

    const totalCostWithRemediation_withCommission = totalCostPerShipmentCad_withCommission + remediationTotalCad;
    const totalCostPerShipmentCad_exclCommission = totalCostPerShipmentCad_withCommission - salesCommissionTotalCad;
    const totalCostWithRemediation_exclCommission = totalCostPerShipmentCad_exclCommission + remediationTotalCad;

    const perGramCad_withCommission = totalCostPerShipmentCad_withCommission / shipmentVolumeG;
    const perGramEur_withCommission = perGramCad_withCommission * cadToEur;

    // ---------- Effective remediation total actually applied (for the "used" cost basis) ----------
    const remediationAppliedCad = includeRemediation ? remediationTotalCad : 0;
    const totalCostUsed_withCommission = totalCostPerShipmentCad_withCommission + remediationAppliedCad;
    const totalCostUsed_exclCommission = totalCostPerShipmentCad_exclCommission + remediationAppliedCad;

    // ---------- Oaziz selling price to pharmacies — primary scenario: with commission, no remediation ----------
    const oazizMarkupPct = num('oazizMarkupPct');
    const markupFactor = 1 + oazizMarkupPct / 100;
    const sellPriceTotalCad = totalCostPerShipmentCad_withCommission * markupFactor;
    const sellPriceTotalEur = totalCostPerShipmentCad_withCommission * cadToEur * markupFactor;
    const sellPricePerGramCad = sellPriceTotalCad / shipmentVolumeG;
    const sellPricePerGramEur = sellPriceTotalEur / shipmentVolumeG;
    const profitTotalCad = sellPriceTotalCad - totalCostPerShipmentCad_withCommission;

    // ---------- 4 scenarios table ----------
    type Scenario = { label: string; totalCad: number; primary: boolean };
    const scenarios: Scenario[] = [
      { label: I18N.scenarioWithCommissionNoRemediation, totalCad: totalCostPerShipmentCad_withCommission, primary: true },
      { label: I18N.scenarioNoCommissionNoRemediation, totalCad: totalCostPerShipmentCad_exclCommission, primary: false },
      { label: I18N.scenarioWithCommissionWithRemediation, totalCad: totalCostWithRemediation_withCommission, primary: false },
      { label: I18N.scenarioNoCommissionWithRemediation, totalCad: totalCostWithRemediation_exclCommission, primary: false },
    ];

    const scenarioRows = scenarios
      .map((s) => {
        const perGCad = s.totalCad / shipmentVolumeG;
        const perGEur = perGCad * cadToEur;
        return `<tr class="${s.primary ? 'primary-row' : ''}">
          <td>${s.label}${s.primary ? ' ★' : ''}</td>
          <td>${fmtMoney2(s.totalCad)}</td>
          <td>${fmtPerG(perGCad)}</td>
          <td>${fmtEurPerG(perGEur)}</td>
        </tr>`;
      })
      .join('');

    const headlineHint = I18N.headlineHint.replace('{pct}', fmtPct1(oazizMarkupPct / 100));
    const headlineVolumeSub = I18N.headlineVolumeSub
      .replace('{volume}', fmtG(shipmentVolumeG))
      .replace('{bags}', fmtNum(bagsPerShipment))
      .replace('{bagSize}', fmtG(bagSizeG));
    const processingRetentionSample = I18N.processingRetentionSample
      .replace('{retained}', fmtG(retentionSampleTotalG))
      .replace('{saleable}', fmtG(saleableVolumeG));
    const processingRemediationLabel = I18N.processingRemediationLabel.replace(
      '{status}',
      includeRemediation ? I18N.processingRemediationIncluded : I18N.processingRemediationNotIncluded
    );
    const monthlyEntrepreneurLabel = I18N.monthlyEntrepreneurLabel.replace('{n}', fmtNum(shipmentsPerMonth));

    out.innerHTML = `
      <div class="card headline-card" style="margin-bottom: 16px;">
        <h2>${I18N.headlineHeading}</h2>
        <p class="hint" style="margin-bottom: 8px;">${headlineHint}</p>
        <div class="headline-grid">
          <div>
            <div class="headline-stat-label">${I18N.headlineTotalCostLabel}</div>
            <div class="headline-stat-value">${fmtMoney2(totalCostPerShipmentCad_withCommission)}</div>
            <div class="headline-stat-sub">${fmtPerG(perGramCad_withCommission)}/g · ${fmtEurPerG(perGramEur_withCommission)}/g</div>
          </div>
          <div>
            <div class="headline-stat-label">${I18N.headlineSellPriceTotalLabel}</div>
            <div class="headline-stat-value">${fmtMoney2(sellPriceTotalCad)}</div>
            <div class="headline-stat-sub">${fmtEur2(sellPriceTotalEur)}</div>
          </div>
          <div>
            <div class="headline-stat-label">${I18N.headlineSellPricePerGramLabel}</div>
            <div class="headline-stat-value">${fmtPerG(sellPricePerGramCad)}</div>
            <div class="headline-stat-sub">${fmtEurPerG(sellPricePerGramEur)}/g</div>
          </div>
          <div>
            <div class="headline-stat-label">${I18N.headlineProfitLabel}</div>
            <div class="headline-stat-value">${fmtMoney2(profitTotalCad)}</div>
            <div class="headline-stat-sub">${headlineVolumeSub}</div>
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.upstreamHeading}</h2>
        <div class="breakdown-line"><span>${I18N.upstreamFlower}</span><span>${fmtMoney2(flowerPurchaseTotalCad)}</span></div>
        <div class="breakdown-line"><span>${I18N.upstreamShippingToGwng}</span><span>${fmtMoney2(shippingSupplierToGwngCad)}</span></div>
        <div class="breakdown-line"><span>${I18N.upstreamGwngHandling}</span><span>${fmtMoney2(gwngHandlingTotalCad)}</span></div>
        <div class="breakdown-line"><span>${I18N.upstreamShippingToCzech}</span><span>${fmtMoney2(shippingGwngToCzechCad)}</span></div>
        <div class="breakdown-line total"><span>${I18N.upstreamTotal}</span><span>${fmtMoney2(upstreamTotalCad)}</span></div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.setupHeading}</h2>
        <div class="breakdown-line"><span>${I18N.setupGrowerRegistry}</span><span>${fmtEur2(growerRegistryFeeEur)}</span></div>
        <div class="breakdown-line"><span>${I18N.setupProductRegistration}</span><span>${fmtEur2(productRegistrationFeeEur)}</span></div>
        <div class="breakdown-line"><span>${I18N.setupGermanSetupFee}</span><span>${fmtEur2(germanSetupFeeEur)}</span></div>
        <div class="breakdown-line total"><span>${I18N.setupTotal}</span><span>${fmtEur2(totalSetupCostsEur)}</span></div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.processingHeading}</h2>
        <div class="breakdown-line"><span>${processingRetentionSample}</span><span>${fmtMoney2(retentionSampleCostCad)} ${I18N.processingRetentionSampleSuffix}</span></div>
        <div class="breakdown-line"><span>${I18N.processingGacpToGmp}</span><span>${fmtEur2(gacpToGmpTotalEur)} (${fmtMoney2(gacpToGmpTotalCad)})</span></div>
        <div class="breakdown-line"><span>${I18N.processingSalesCommission}</span><span>${fmtEur2(salesCommissionTotalEur)} (${fmtMoney2(salesCommissionTotalCad)})</span></div>
        <div class="breakdown-line"><span>${processingRemediationLabel}</span><span>${fmtEur2(remediationTotalEur)} (${fmtMoney2(remediationTotalCad)})</span></div>
      </div>

      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.monthlyHeading}</h2>
        <div class="breakdown-line"><span>${monthlyEntrepreneurLabel}</span><span>${fmtEur2(germanEntrepreneurPerShipmentEur)} (${fmtMoney2(germanEntrepreneurPerShipmentCad)})</span></div>
        <div class="breakdown-line"><span>${I18N.monthlyPharmacyDelivery}</span><span>${fmtEur2(pharmacyDeliveryTotalEur)} (${fmtMoney2(pharmacyDeliveryTotalCad)})</span></div>
      </div>

      <div class="card">
        <h2>${I18N.summaryHeading}</h2>
        <p class="hint" style="margin-bottom: 12px;">${I18N.summaryHint}</p>
        <div style="overflow-x:auto;">
          <table class="export-table">
            <thead>
              <tr><th>${I18N.summaryThScenario}</th><th>${I18N.summaryThTotalCad}</th><th>$/g</th><th>€/g</th></tr>
            </thead>
            <tbody>${scenarioRows}</tbody>
          </table>
        </div>
        <details style="margin-top: 14px;">
          <summary>${I18N.detailsSummary}</summary>
          <div class="details-body">
            <div class="breakdown-line"><span>${I18N.detailsWithCommission}</span><span>${fmtMoney2(totalCostUsed_withCommission)}</span></div>
            <div class="breakdown-line"><span>${I18N.detailsWithoutCommission}</span><span>${fmtMoney2(totalCostUsed_exclCommission)}</span></div>
          </div>
        </details>
      </div>
    `;
  }

  document.addEventListener('input', (e) => {
    if (!(e.target as HTMLElement)?.closest('.calc-wizard')) return;
    render();
  });
  render();
</script>
