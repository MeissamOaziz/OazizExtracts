---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}
---
<PortailLayout title="Export Australie — Vape" staffName={staff.full_name}>
  <div class="calc-wizard">
    <div style="margin-bottom: 20px;">
      <a href="/portail/calculatrices" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
        ← Retour aux calculatrices
      </a>
    </div>
    <h1>Export Australie — Vape</h1>
    <p style="color: var(--p-muted); margin-bottom: 20px;">
      Modélise le parcours Oaziz Extracts (Montréal) → transformation vape → partenaire de distribution
      australien → marché australien, sur la base d'estimations internes et de la soumission logistique
      Beam Suntory.
    </p>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Devises</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="cadToAud">Taux de conversion CAD → AUD</label>
          <input type="number" id="cadToAud" value="1.10" step="0.01" />
        </div>
        <div class="form-row">
          <label>Taux AUD → CAD (dérivé)</label>
          <div id="audToCadDisplay" class="derived-value">—</div>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Matière de départ</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="totalInputG">Grammes de matière première (trim/têtes)</label>
          <input type="number" id="totalInputG" value="30000" step="1000" />
        </div>
        <div class="form-row">
          <label for="costPerGCad">Coût par gramme (CA$/g)</label>
          <input type="number" id="costPerGCad" value="0.15" step="0.01" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Tests de laboratoire</h2>
      <div class="form-row">
        <label for="numLots">Nombre de lots/souches</label>
        <input type="number" id="numLots" value="1" step="1" />
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="oazizCoaCad">Coût COA Oaziz (CA$, par lot)</label>
          <input type="number" id="oazizCoaCad" value="1500" step="50" />
        </div>
        <div class="form-row">
          <label for="australianCoaCad">Coût COA australien (CA$, par lot)</label>
          <input type="number" id="australianCoaCad" value="3000" step="50" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Transformation Oaziz</h2>
      <div class="form-row">
        <label for="oazizProcessingCadPerG">Transformation, emballage et transport par gramme (CA$/g)</label>
        <input type="number" id="oazizProcessingCadPerG" value="4.00" step="0.05" />
      </div>
      <p class="hint">Appliqué sur les grammes de matière première en entrée (et non sur le rendement extrait).</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Rendement</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="washYieldPct">Rendement du lavage (%)</label>
          <input type="number" id="washYieldPct" value="10" step="0.5" />
        </div>
        <div class="form-row">
          <label for="pressYieldPct">Rendement de presse (%)</label>
          <input type="number" id="pressYieldPct" value="60" step="1" />
        </div>
      </div>
      <p class="hint">Échantillons retenus (Oaziz + contingence) : 7,5 % chacun du rendement post-presse — fixe, non modifiable.</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Coûts uniques</h2>
      <div class="form-row">
        <label for="lpAuditFeeCad">Frais d'audit LP (CA$)</label>
        <input type="number" id="lpAuditFeeCad" value="1750" step="50" />
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="productValidationCad">Validation du produit (CA$, par souche)</label>
          <input type="number" id="productValidationCad" value="17500" step="500" />
        </div>
        <div class="form-row">
          <label for="stabilityStudyCad">Étude de stabilité (CA$, par souche)</label>
          <input type="number" id="stabilityStudyCad" value="12500" step="500" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Emballage et remplissage australien</h2>
      <div class="form-row">
        <label for="fillingTier">Palier de remplissage</label>
        <select id="fillingTier">
          <option value="low">Low (A$14 × taux)</option>
          <option value="high" selected>High (A$18 × taux)</option>
          <option value="custom">Custom</option>
        </select>
      </div>
      <div class="form-row" id="customFillRow" hidden>
        <label for="customFillCostCad">Coût de remplissage personnalisé par unité (CA$)</label>
        <input type="number" id="customFillCostCad" value="18" step="0.5" />
      </div>
      <p class="hint">1 unité = 1 gramme de remplissage (correspond à la feuille source).</p>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Majoration</h2>
      <div class="form-row">
        <label for="oazizMarkupPct">Majoration Oaziz (%)</label>
        <input type="number" id="oazizMarkupPct" value="30" step="1" />
      </div>
    </div>

    <div id="result"></div>
  </div>
</PortailLayout>

<style is:global>
  .derived-value {
    padding: 9px 12px;
    border: 1px solid var(--p-border);
    border-radius: 6px;
    background: var(--p-bg);
    color: var(--p-muted);
    font-size: .95rem;
    font-variant-numeric: tabular-nums;
  }

  .cost-line { display: flex; justify-content: space-between; padding: 6px 0; font-size: .88rem; gap: 12px; }
  .cost-line span:first-child { color: var(--p-muted); }
  .cost-line span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cost-line.subtotal { border-top: 1px solid var(--p-border); margin-top: 6px; padding-top: 8px; font-weight: 600; }

  .landed-highlight {
    margin-top: 16px;
    padding: 16px;
    border-radius: 10px;
    background: rgba(208, 88, 38, .08);
    border: 1px solid rgba(208, 88, 38, .3);
  }
  .landed-highlight .cost-line { font-size: 1rem; font-weight: 700; color: var(--p-accent); }
  .landed-highlight .cost-line span:first-child { color: var(--p-accent); }
  .landed-highlight .cost-line.small { font-size: .82rem; font-weight: 500; color: var(--p-muted); margin-top: 2px; }
  .landed-highlight .cost-line.small span:first-child { color: var(--p-muted); }

  table.cost-summary { width: 100%; border-collapse: collapse; font-size: .87rem; font-variant-numeric: tabular-nums; margin-top: 8px; }
  table.cost-summary th, table.cost-summary td { padding: 8px 10px; text-align: right; border-bottom: 1px solid var(--p-border); }
  table.cost-summary th:first-child, table.cost-summary td:first-child { text-align: left; }
  table.cost-summary th { font-weight: 600; color: var(--p-muted); font-size: .72rem; text-transform: uppercase; }
  table.cost-summary tbody tr.total-row { font-weight: 700; }
</style>

<script>
  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isFinite(v) ? v : 0;
  }

  const fmtMoney2 = (n: number) =>
    isFinite(n) ? n.toLocaleString('fr-CA', { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtMoney0 = (n: number) =>
    isFinite(n) ? n.toLocaleString('fr-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }) : '—';
  const fmtAud2 = (n: number) =>
    isFinite(n) ? n.toLocaleString('fr-CA', { style: 'currency', currency: 'AUD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtPerUnitCad = (n: number) => (isFinite(n) ? '$' + n.toFixed(4) : '—');
  const fmtPerUnitAud = (n: number) => (isFinite(n) ? 'A$' + n.toFixed(4) : '—');
  const fmtRate = (n: number) => (isFinite(n) ? n.toFixed(4) : '—');
  const fmtG = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString('fr-CA') + ' g' : '—');
  const fmtUnits = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString('fr-CA') : '—');

  document.getElementById('fillingTier')?.addEventListener('change', render);

  function render() {
    const out = document.getElementById('result');
    if (!out) return;

    const cadToAud = num('cadToAud');
    const audToCad = cadToAud > 0 ? 1 / cadToAud : 0;
    const audToCadDisplay = document.getElementById('audToCadDisplay');
    if (audToCadDisplay) audToCadDisplay.textContent = fmtRate(audToCad);

    const totalInputG = num('totalInputG');
    const costPerGCad = num('costPerGCad');

    if (totalInputG <= 0) {
      out.innerHTML = `<div class="warn-banner">La quantité de matière première doit être supérieure à 0.</div>`;
      return;
    }

    const totalMaterialCost = totalInputG * costPerGCad;

    const numLots = num('numLots');
    const oazizCoaCad = num('oazizCoaCad');
    const australianCoaCad = num('australianCoaCad');
    const totalLabTestCost = numLots * (oazizCoaCad + australianCoaCad);

    const oazizProcessingCadPerG = num('oazizProcessingCadPerG');
    const totalProcessingCost = totalInputG * oazizProcessingCadPerG;

    const washYieldPct = num('washYieldPct');
    const pressYieldPct = num('pressYieldPct');
    const postWashYieldG = totalInputG * (washYieldPct / 100);
    const postPressYieldG = postWashYieldG * (pressYieldPct / 100);
    const retainedOazizG = postPressYieldG * 0.075;
    const retainedContingencyG = postPressYieldG * 0.075;
    const totalProductAvailableG = postPressYieldG - retainedOazizG - retainedContingencyG;

    const lpAuditFeeCad = num('lpAuditFeeCad');
    const productValidationCad = num('productValidationCad');
    const stabilityStudyCad = num('stabilityStudyCad');
    const totalOneTimeCosts = lpAuditFeeCad + productValidationCad * numLots + stabilityStudyCad * numLots;

    const fillingTierEl = document.getElementById('fillingTier') as HTMLSelectElement | null;
    const fillingTier = fillingTierEl ? fillingTierEl.value : 'high';
    const customFillRow = document.getElementById('customFillRow') as HTMLElement | null;
    if (customFillRow) customFillRow.hidden = fillingTier !== 'custom';
    const customFillCostCad = num('customFillCostCad');

    const fillCostPerUnitCad =
      fillingTier === 'low' ? 14 * audToCad :
      fillingTier === 'high' ? 18 * audToCad :
      customFillCostCad;

    const totalUnitsAvailable = totalProductAvailableG;
    const totalFillingCost = fillCostPerUnitCad * totalUnitsAvailable;

    const oazizMarkupPct = num('oazizMarkupPct');

    const totalBatchCostCad = totalMaterialCost + totalLabTestCost + totalProcessingCost + totalOneTimeCosts + totalFillingCost;
    const totalCostPerUnitCad = totalUnitsAvailable > 0 ? totalBatchCostCad / totalUnitsAvailable : 0;
    const totalCostPerUnitAud = totalCostPerUnitCad * cadToAud;

    const finalCostPerUnitInclMarkupCad = totalCostPerUnitCad * (1 + oazizMarkupPct / 100);
    const finalCostPerUnitInclMarkupAud = finalCostPerUnitInclMarkupCad * cadToAud;

    const perUnit = (total: number) => (totalUnitsAvailable > 0 ? total / totalUnitsAvailable : 0);

    const components = [
      { label: 'Matière première', total: totalMaterialCost },
      { label: 'Tests de laboratoire', total: totalLabTestCost },
      { label: 'Transformation Oaziz', total: totalProcessingCost },
      { label: 'Coûts uniques (démarrage)', total: totalOneTimeCosts },
      { label: 'Remplissage australien', total: totalFillingCost },
    ];

    const rows = components
      .map((c) => {
        const perUnitCad = perUnit(c.total);
        const perUnitAud = perUnitCad * cadToAud;
        return `<tr>
          <td>${c.label}</td>
          <td>${fmtMoney0(c.total)}</td>
          <td>${fmtPerUnitCad(perUnitCad)}</td>
          <td>${fmtPerUnitAud(perUnitAud)}</td>
        </tr>`;
      })
      .join('');

    const totalRow = `<tr class="total-row">
      <td>Coût total du lot</td>
      <td>${fmtMoney0(totalBatchCostCad)}</td>
      <td>${fmtPerUnitCad(totalCostPerUnitCad)}</td>
      <td>${fmtPerUnitAud(totalCostPerUnitAud)}</td>
    </tr>`;

    out.innerHTML = `
      <div class="card" style="margin-bottom: 16px;">
        <h2>Rendement — de la matière première au produit disponible</h2>
        <div class="cost-line"><span>Matière première (entrée)</span><span>${fmtG(totalInputG)}</span></div>
        <div class="cost-line"><span>Post-lavage (${washYieldPct}%)</span><span>${fmtG(postWashYieldG)}</span></div>
        <div class="cost-line"><span>Post-presse (${pressYieldPct}%)</span><span>${fmtG(postPressYieldG)}</span></div>
        <div class="cost-line"><span>Échantillon retenu Oaziz (7,5 %)</span><span>− ${fmtG(retainedOazizG)}</span></div>
        <div class="cost-line"><span>Échantillon retenu contingence (7,5 %)</span><span>− ${fmtG(retainedContingencyG)}</span></div>
        <div class="cost-line subtotal"><span>Produit disponible (unités)</span><span>${fmtUnits(totalUnitsAvailable)} g / unités</span></div>
      </div>

      <div class="card">
        <h2>Résumé des coûts</h2>
        <div style="overflow-x:auto;">
          <table class="cost-summary">
            <thead>
              <tr>
                <th>Composante</th><th>Total (CA$)</th><th>Coût/unité (CA$)</th><th>Coût/unité (AU$)</th>
              </tr>
            </thead>
            <tbody>${rows}${totalRow}</tbody>
          </table>
        </div>

        <div class="landed-highlight">
          <div class="cost-line"><span>★ COÛT / UNITÉ INCL. MAJORATION (FOB MONTRÉAL)</span><span>${fmtMoney2(finalCostPerUnitInclMarkupCad)}</span></div>
          <div class="cost-line small"><span>Équivalent</span><span>${fmtAud2(finalCostPerUnitInclMarkupAud)}</span></div>
          <div class="cost-line small"><span>Coût / unité avant majoration</span><span>${fmtPerUnitCad(totalCostPerUnitCad)} · ${fmtPerUnitAud(totalCostPerUnitAud)}</span></div>
        </div>
      </div>
    `;
  }

  document.addEventListener('input', (e) => {
    if (!(e.target as HTMLElement)?.closest('.calc-wizard')) return;
    render();
  });
  render();
</script>
