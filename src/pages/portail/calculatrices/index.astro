---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}

const calculators = [
  {
    href: '/portail/calculatrices/cout-production',
    title: 'Coût de production',
    desc: "Décompose le coût complet d'un lot (matières, main-d'œuvre, frais généraux, COA) et calcule le prix de vente par palier de marge — Kief, IWE, Hash, Rosin, Vape, Topiques et Hash à partir de kief acheté.",
  },
  {
    href: '/portail/calculatrices/formulation-hash',
    title: 'Formulation de Hash (SQDC & DOM)',
    desc: "SQDC : dilue le kief avec distillat CBD + isolat + terpène pour respecter les cibles THC/CBD au coût le plus bas. DOM : ajoute du distillat THC au kief pour atteindre une cible de puissance plus élevée.",
  },
  {
    href: '/portail/calculatrices/export-allemagne-gacp-gmp',
    title: 'Export Allemagne — GACP → GMP',
    desc: "Coût complet et rentabilité de l'export de fleur GACP vers l'Allemagne via un partenaire de conversion GMP (BfArM) — frais de service, mise à l'échelle, amortissement des coûts de démarrage.",
  },
  {
    href: '/portail/calculatrices/export-royaume-uni-fleur',
    title: 'Export Royaume-Uni — Fleur',
    desc: "Coût total d'un lot de fleur exporté au Royaume-Uni (AgMedica → RX Distributor) et comparaison du coût par gramme selon la taille d'unité d'emballage (10g / 100g / 200g).",
  },
  {
    href: '/portail/calculatrices/export-suisse',
    title: 'Export Suisse — Kief / Blocs pressés',
    desc: "Coût complet et prix de vente d'un lot de kief pressé exporté en Suisse via Vertical 7 — décompte des coûts, majoration, marge brute et portion de profit partagé.",
  },
  {
    href: '/portail/calculatrices/export-allemagne-tcheque',
    title: 'Export Allemagne (via Rép. tchèque)',
    desc: "Coût complet de l'export de fleur vers l'Allemagne via GWNG et la République tchèque — coûts en amont, transformation GACP→GMP, commission de vente, et prix suggéré aux pharmacies.",
  },
  {
    href: '/portail/calculatrices/export-australie-vape',
    title: 'Export Australie — Vape',
    desc: "Coût complet FOB Montréal d'un lot de vape exporté vers l'Australie, du trim brut au coût par unité incluant la majoration Oaziz.",
  },
  {
    href: '/portail/calculatrices/export-royaume-uni-vape',
    title: 'Export Royaume-Uni — Vape',
    desc: "Coût complet de production de cartouches vape pour le marché britannique (AgMedica → RX UK → Grow Group), du trim brut au coût par cartouche selon le palier de volume, avec analyse de marge.",
  },
  {
    href: '/portail/calculatrices/softgel-osg',
    title: 'Prix des softgels OSG (CBD/CBN)',
    desc: "Cascade de prix pour les capsules softgel CBD et CBN produites par Olds Softgel Ltd. (OSG) — coût, majoration Oaziz, prix final distributeur, avec module d'embouteillage optionnel.",
  },
];
---
<PortailLayout title="Calculatrices" staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href="/portail" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
      ← Retour au tableau de bord
    </a>
  </div>
  <h1>Calculatrices</h1>
  <p style="color: var(--p-muted); margin-bottom: 24px;">
    Outils internes de calcul de coûts et de prix.
  </p>

  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
    {calculators.map((calc) => (
      <a href={calc.href} class="card calc-card">
        <h2 style="margin-bottom: 8px;">{calc.title}</h2>
        <p style="color: var(--p-muted); font-size: .9rem; margin: 0;">{calc.desc}</p>
      </a>
    ))}
  </div>
</PortailLayout>
<style>
  .calc-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .calc-card:hover {
    border-color: var(--p-accent);
    box-shadow: 0 2px 6px rgba(16,24,40,.08);
  }
</style>
