    <div class="card leaf-card" id="leaf-rosin" hidden style="margin-bottom: 16px;">
      <h2>{T('leafRosinTitle')}</h2>
      <div class="form-row">
        <label for="rosin_trimCost">{T('trimCostLabel')}</label>
        <input type="number" id="rosin_trimCost" value="0" step="0.01" />
