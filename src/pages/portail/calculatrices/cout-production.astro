          </div>
          <div class="form-row">
            <label for="iweHash_costCure">{T('costCureLabel')}</label>
            <input type="number" id="iweHash_costCure" value="28" step="0.5" />
          </div>
        </div>
      </details>
    </div>

    <div class="card leaf-card" id="leaf-mix" hidden style="margin-bottom: 16px;">
      <h2>{T('leafMixTitle')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="mix_distCost">{T('distCostLabel')}</label>
          <input type="number" id="mix_distCost" value="1.40" step="0.01" />
        </div>
        <div class="form-row">
          <label for="mix_trimCost">{T('trimCostLabel')}</label>
          <input type="number" id="mix_trimCost" value="0" step="0.01" />
        </div>
      </div>
      <div class="form-row">
        <label for="mix_terpCost">{T('terpCostLabel')}</label>
        <input type="number" id="mix_terpCost" value="0" step="0.01" />
