        <div class="details-body two-col">
          <div class="form-row">
            <label for="mix_pctTrimUsedBase">{T('mixPctTrimUsedBaseLabel')}</label>
            <input type="number" id="mix_pctTrimUsedBase" value="80" step="0.5" />
