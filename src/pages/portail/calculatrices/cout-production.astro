            <label for="mix_rateIwe">{T('rateIweWashLabel')}</label>
            <input type="number" id="mix_rateIwe" value="1700" step="1" />
          </div>
          <div class="form-row">
            <label for="mix_costIwe">{T('costIweWashLabel')}</label>
            <input type="number" id="mix_costIwe" value="28" step="0.5" />
