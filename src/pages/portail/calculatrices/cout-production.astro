          <input type="number" id="mix_pctDrysift" value="70" step="0.5" />
        </div>
        <div class="form-row">
          <label for="mix_pctIwe" class="sublabel">{T('mixPctIweLabel')}</label>
          <input type="number" id="mix_pctIwe" value="16" step="0.5" />
        </div>
        <div class="form-row">
