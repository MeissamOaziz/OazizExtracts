---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frCoutProduction, enCoutProduction } from '../../../i18n/portail/cout-production';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frCoutProduction, enCoutProduction);

// Strings needed by the client-side <script> (it is bundled/processed, not
// is:inline, so it can't receive server data via define:vars — see the JSON
// data island below instead).
const clientStrings = {
  locale,
  questions: {
    productType: [
      { value: 'kief', label: T('qProductTypeKiefLabel'), desc: T('qProductTypeKiefDesc') },
      { value: 'iweRaw', label: T('qProductTypeIweRawLabel'), desc: T('qProductTypeIweRawDesc') },
      { value: 'hash', label: T('qProductTypeHashLabel'), desc: T('qProductTypeHashDesc') },
      { value: 'rosin', label: T('qProductTypeRosinLabel'), desc: T('qProductTypeRosinDesc') },
      { value: 'vape', label: T('qProductTypeVapeLabel'), desc: T('qProductTypeVapeDesc') },
      { value: 'topicals', label: T('qProductTypeTopicalsLabel'), desc: T('qProductTypeTopicalsDesc') },
    ],
    hashSource: [
      { value: 'trim', label: T('qHashSourceTrimLabel'), desc: T('qHashSourceTrimDesc') },
      { value: 'fleur', label: T('qHashSourceFleurLabel'), desc: T('qHashSourceFleurDesc') },
      { value: 'kiefAchete', label: T('qHashSourceKiefAcheteLabel'), desc: T('qHashSourceKiefAcheteDesc') },
    ],
    hashMethod: [
      { value: 'drysift', label: T('qHashMethodDrysiftLabel'), desc: T('qHashMethodDrysiftDesc') },
      { value: 'iwe', label: T('qHashMethodIweLabel'), desc: T('qHashMethodIweDesc') },
      { value: 'mix', label: T('qHashMethodMixLabel'), desc: T('qHashMethodMixDesc') },
    ],
  },
  leaves: {
    kief: T('leafDisplayKief'),
    iweRaw: T('leafDisplayIweRaw'),
    drysift: T('leafDisplayDrysift'),
    iweHash: T('leafDisplayIweHash'),
    mix: T('leafDisplayMix'),
    highyield: T('leafDisplayHighyield'),
    purchasedKief: T('leafDisplayPurchasedKief'),
    rosin: T('leafDisplayRosin'),
    vape: T('leafDisplayVape'),
    topicals: T('leafDisplayTopicals'),
  },
  lines: {
    trim: T('lineTrim'),
    distillat: T('lineDistillat'),
    overheadCoa: T('lineOverheadCoa'),
    laborTumble: T('lineLaborTumble'),
    laborIweWash: T('lineLaborIweWash'),
    laborGrind: T('lineLaborGrind'),
    laborCure: T('lineLaborCure'),
    laborShred: T('lineLaborShred'),
    laborPress: T('lineLaborPress'),
    laborMelangeGrind: T('lineLaborMelangeGrind'),
    laborKiefHash: T('lineLaborKiefHash'),
    laborXaman: T('lineLaborXaman'),
    laborMelange: T('lineLaborMelange'),
    fleur: T('lineFleur'),
    ingredients: T('lineIngredients'),
    kiefAchete: T('lineKiefAchete'),
    cbg: T('lineCbg'),
    cbn: T('lineCbn'),
    rosinTrimFeed: T('lineRosinTrimFeed'),
    mixDistillat: T('lineMixDistillat'),
    mixDrysiftKief: T('lineMixDrysiftKief'),
    mixIwe: T('lineMixIwe'),
    mixTerpenes: T('lineMixTerpenes'),
  },
  resultPlaceholder: T('resultPlaceholder'),
  batchWarning: T('batchWarning'),
  resultEyebrow: T('resultEyebrow'),
  costPerBatchStat: T('costPerBatchStat'),
  costPerGStat: T('costPerGStat'),
  marginsSuggestedLabel: T('marginsSuggestedLabel'),
  viewBreakdownLabel: T('viewBreakdownLabel'),
  naAbbrev: T('naAbbrev'),
};
---
<PortailLayout title={T('pageTitle')} staffName={staff.full_name}>
  <div class="calc-wizard">
    <div style="margin-bottom: 20px;">
      <a href="/portail/calculatrices" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
        {T('backLink')}
      </a>
    </div>
    <h1>{T('pageTitle')}</h1>
    <p style="color: var(--p-muted); margin-bottom: 24px;">
      {T('intro')}
    </p>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('generalParamsTitle')}</h2>
      <div class="form-row">
        <label for="batch">{T('batchLabel')}</label>
        <input type="number" id="batch" value="10000" min="1" step="1" />
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="overheadPct">{T('overheadLabel')}</label>
          <input type="number" id="overheadPct" value="24" step="0.1" />
        </div>
        <div class="form-row">
          <label for="coaCost">{T('coaCostLabel')}</label>
          <input type="number" id="coaCost" value="1600" step="1" />
        </div>
      </div>
      <label style="margin-bottom: 8px;">{T('marginsCompareLabel')}</label>
      <div class="four-col">
        <div class="form-row">
          <label for="m1" class="sublabel">{T('m1Label')}</label>
          <input type="number" id="m1" value="25" step="0.5" />
        </div>
        <div class="form-row">
          <label for="m2" class="sublabel">{T('m2Label')}</label>
          <input type="number" id="m2" value="30" step="0.5" />
        </div>
        <div class="form-row">
          <label for="m3" class="sublabel">{T('m3Label')}</label>
          <input type="number" id="m3" value="35" step="0.5" />
        </div>
        <div class="form-row">
          <label for="m4" class="sublabel">{T('m4Label')}</label>
          <input type="number" id="m4" value="40" step="0.5" />
        </div>
      </div>
    </div>

    <div class="card question-card" style="margin-bottom: 16px;">
      <h2>{T('q1Title')}</h2>
      <div class="choice-grid" data-question="productType"></div>
    </div>

    <div class="card question-card" id="q-hashSource" hidden style="margin-bottom: 16px;">
      <h2>{T('q2Title')}</h2>
      <div class="choice-grid" data-question="hashSource"></div>
    </div>

    <div class="card question-card" id="q-hashMethod" hidden style="margin-bottom: 16px;">
      <h2>{T('q3Title')}</h2>
      <div class="choice-grid" data-question="hashMethod"></div>
    </div>

    <!-- Leaf input cards — exactly one visible at a time, once the questions above resolve to a product. -->

    <div class="card leaf-card" id="leaf-kief" hidden style="margin-bottom: 16px;">
      <h2>{T('leafKiefTitle')}</h2>
      <div class="form-row">
        <label for="kief_trimCost">{T('trimCostLabel')}</label>
        <input type="number" id="kief_trimCost" value="0" step="0.01" />
      </div>
      <details>
        <summary>{T('advancedAssumptions')}</summary>
        <div class="details-body two-col">
          <div class="form-row">
            <label for="kief_pctTrimUsed">{T('trimPctUsedLabel')}</label>
            <input type="number" id="kief_pctTrimUsed" value="80" step="0.5" />
          </div>
          <div class="form-row">
            <label for="kief_rateTumble">{T('rateTumbleLabel')}</label>
            <input type="number" id="kief_rateTumble" value="3500" step="1" />
          </div>
          <div class="form-row">
            <label for="kief_costTumble">{T('costTumbleLabel')}</label>
            <input type="number" id="kief_costTumble" value="28" step="0.5" />
          </div>
        </div>
      </details>
    </div>

    <div class="card leaf-card" id="leaf-iweRaw" hidden style="margin-bottom: 16px;">
