<script type="application/json" id="calc-i18n-data" set:html={JSON.stringify(clientStrings)}></script>
<script>
  type LaborResult = { hrs: number; cost: number };

  const I18N = JSON.parse(document.getElementById('calc-i18n-data')!.textContent!);

  function labor(need: number, rate: number, costPerHr: number): LaborResult {
    const hrs = rate > 0 ? need / rate : 0;
    return { hrs, cost: hrs * costPerHr };
  }

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isFinite(v) ? v : 0;
  }

  function pct(id: string): number {
    return num(id) / 100;
  }

  const fmtMoney2 = (n: number) =>
    isFinite(n) ? n.toLocaleString(I18N.locale === 'en' ? 'en-CA' : 'fr-CA', { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtPerG = (n: number) => (isFinite(n) ? '$' + n.toFixed(4) : '—');
  const fmtPct = (n: number) => (isFinite(n) ? (n * 100).toFixed(0) + '%' : '—');

  function generalParams() {
    const batch = num('batch');
    const overhead = pct('overheadPct');
    const coaCost = num('coaCost');
    const coaPerG = batch > 0 ? coaCost / batch : 0;
    const margins = [pct('m1'), pct('m2'), pct('m3'), pct('m4')];
    return { batch, overhead, coaPerG, margins };
  }

  const LEAVES: Record<string, { label: string; compute: (g: ReturnType<typeof generalParams>) => { batchCost: number; perG: number; lines: Array<{ label: string; value: number }> } }> = {
    kief: {
      label: I18N.leaves.kief,
      compute: (g) => {
        const trimCost = num('kief_trimCost');
        const pctTrimUsed = pct('kief_pctTrimUsed');
        const trimNeed = g.batch * pctTrimUsed * 5;
        const trimCostTotal = trimNeed * trimCost;
        const l = labor(trimNeed, num('kief_rateTumble'), num('kief_costTumble'));
        const batchCost = (trimCostTotal + l.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.trim, value: trimCostTotal },
            { label: I18N.lines.laborTumble, value: l.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - trimCostTotal - l.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    iweRaw: {
      label: I18N.leaves.iweRaw,
      compute: (g) => {
        const trimCost = num('iweRaw_trimCost');
        const trimNeed = g.batch * 10;
        const trimCostTotal = trimNeed * trimCost;
        const l = labor(trimNeed, num('iweRaw_rateIwe'), num('iweRaw_costIwe'));
        const batchCost = (trimCostTotal + l.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.trim, value: trimCostTotal },
            { label: I18N.lines.laborIweWash, value: l.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - trimCostTotal - l.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    drysift: {
      label: I18N.leaves.drysift,
      compute: (g) => {
        const distCost = num('drysift_distCost');
        const trimCost = num('drysift_trimCost');
        const distNeed = g.batch * pct('drysift_pctDistUsed');
        const distCostTotal = distNeed * distCost;
        const trimNeed = g.batch * pct('drysift_pctTrimUsed') * 5;
        const trimCostTotal = trimNeed * trimCost;
        const lTumble = labor(trimNeed, num('drysift_rateTumble'), num('drysift_costTumble'));
        const lGrind = labor(g.batch, num('drysift_rateGrind'), num('drysift_costGrind'));
        const batchCost = (distCostTotal + trimCostTotal + lTumble.cost + lGrind.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.distillat, value: distCostTotal },
            { label: I18N.lines.trim, value: trimCostTotal },
            { label: I18N.lines.laborTumble, value: lTumble.cost },
            { label: I18N.lines.laborGrind, value: lGrind.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - distCostTotal - trimCostTotal - lTumble.cost - lGrind.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    iweHash: {
      label: I18N.leaves.iweHash,
      compute: (g) => {
        const distCost = num('iweHash_distCost');
        const trimCost = num('iweHash_trimCost');
        const distNeed = g.batch * pct('iweHash_pctDistUsed');
        const distCostTotal = distNeed * distCost;
        const trimNeed = g.batch * 10;
        const trimCostTotal = trimNeed * trimCost;
        const lIwe = labor(trimNeed, num('iweHash_rateIwe'), num('iweHash_costIwe'));
        const lCure = labor(g.batch, num('iweHash_rateCure'), num('iweHash_costCure'));
        const batchCost = (distCostTotal + trimCostTotal + lIwe.cost + lCure.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.distillat, value: distCostTotal },
            { label: I18N.lines.trim, value: trimCostTotal },
            { label: I18N.lines.laborIweWash, value: lIwe.cost },
            { label: I18N.lines.laborCure, value: lCure.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - distCostTotal - trimCostTotal - lIwe.cost - lCure.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    mix: {
      label: I18N.leaves.mix,
      compute: (g) => {
        const distCost = num('mix_distCost');
        const trimCost = num('mix_trimCost');
        const terpCost = num('mix_terpCost');

        const trimNeedDS = g.batch * pct('mix_pctTrimUsedBase') * 5;
        const trimCostDS = trimNeedDS * trimCost;
        const lTumble = labor(trimNeedDS, num('mix_rateTumble'), num('mix_costTumble'));
        const dsKiefBatch = (trimCostDS + lTumble.cost) * (1 + g.overhead);
        const dsKiefPerG = dsKiefBatch / g.batch + g.coaPerG;

        const trimNeedIwe = g.batch * 10;
        const trimCostIwe = trimNeedIwe * trimCost;
        const lIwe = labor(trimNeedIwe, num('mix_rateIwe'), num('mix_costIwe'));
        const iweBatch = (trimCostIwe + lIwe.cost) * (1 + g.overhead);
        const iwePerG = iweBatch / g.batch + g.coaPerG;

        const mixDistCost = g.batch * pct('mix_pctDist') * distCost;
        const mixDrysiftCost = g.batch * pct('mix_pctDrysift') * dsKiefPerG;
        const mixIweCost = g.batch * pct('mix_pctIwe') * iwePerG;
        const mixTerpCost = g.batch * pct('mix_pctTerp') * terpCost;
        const mixTotal = mixDistCost + mixDrysiftCost + mixIweCost + mixTerpCost;

        const lGrind = labor(g.batch, num('mix_rateGrind'), num('mix_costGrind'));
        const batchCost = (mixTotal + lGrind.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.mixDistillat, value: mixDistCost },
            { label: I18N.lines.mixDrysiftKief, value: mixDrysiftCost },
            { label: I18N.lines.mixIwe, value: mixIweCost },
            { label: I18N.lines.mixTerpenes, value: mixTerpCost },
            { label: I18N.lines.laborMelangeGrind, value: lGrind.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - mixTotal - lGrind.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    highyield: {
      label: I18N.leaves.highyield,
      compute: (g) => {
        const distCost = num('hy_distCost');
        const flowerCost = num('hy_flowerCost');
        const distNeed = g.batch * pct('hy_pctDistUsed');
        const distCostTotal = distNeed * distCost;
        const flowerNeed = g.batch * pct('hy_pctFlowerUsed') * 0.9999;
        const flowerCostTotal = flowerNeed * flowerCost;
        const lShred = labor(flowerNeed, num('hy_rateShred'), num('hy_costShred'));
        const lGrind = labor(g.batch, num('hy_rateGrind'), num('hy_costGrind'));
        const batchCost = (distCostTotal + flowerCostTotal + lShred.cost + lGrind.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.distillat, value: distCostTotal },
            { label: I18N.lines.fleur, value: flowerCostTotal },
            { label: I18N.lines.laborShred, value: lShred.cost },
            { label: I18N.lines.laborGrind, value: lGrind.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - distCostTotal - flowerCostTotal - lShred.cost - lGrind.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    purchasedKief: {
      label: I18N.leaves.purchasedKief,
      compute: (g) => {
        const kiefBuyPrice = num('pk_kiefBuyPrice');
        const distCost = num('pk_distCost');
        const cbgcbnCost = num('pk_cbgcbnCost');
        const cbgG = num('pk_cbgG');
        const cbnG = num('pk_cbnG');
        const distWeight = g.batch * pct('pk_distPct');
        const kiefWeight = g.batch - distWeight - cbgG - cbnG;
        const kiefCostTotal = kiefWeight * kiefBuyPrice;
        const distCostTotal = distWeight * distCost;
        const cbgCost = cbgG * cbgcbnCost;
        const cbnCost = cbnG * cbgcbnCost;
        const materialsTotal = kiefCostTotal + distCostTotal + cbgCost + cbnCost;
        const l = labor(kiefWeight, num('pk_rateKiefHash'), num('pk_costKiefHash'));
        const batchCost = (materialsTotal + l.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.kiefAchete, value: kiefCostTotal },
            { label: I18N.lines.distillat, value: distCostTotal },
            { label: I18N.lines.cbg, value: cbgCost },
            { label: I18N.lines.cbn, value: cbnCost },
            { label: I18N.lines.laborKiefHash, value: l.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - materialsTotal - l.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    rosin: {
      label: I18N.leaves.rosin,
      compute: (g) => {
        const trimCost = num('rosin_trimCost');
        const trimNeedIwe = g.batch * 10;
        const lIwe = labor(trimNeedIwe, num('rosin_rateIwe'), num('rosin_costIwe'));
        const rosinTrimNeed = g.batch / (0.1 * 0.6);
        const rosinTrimCost = rosinTrimNeed * trimCost;
        const rosinIweNeed = rosinTrimNeed * 0.1;
        const lPress = labor(rosinIweNeed, num('rosin_ratePress'), num('rosin_costPress'));
        const labourPortion = (lPress.cost + lIwe.cost) * (1 + g.overhead);
        const batchCost = labourPortion + rosinTrimCost * 1.1;
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.rosinTrimFeed, value: rosinTrimCost * 1.1 },
            { label: I18N.lines.laborIweWash, value: lIwe.cost },
            { label: I18N.lines.laborPress, value: lPress.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - (rosinTrimCost * 1.1 + lIwe.cost + lPress.cost) + g.coaPerG * g.batch },
          ],
        };
      },
    },
    vape: {
      label: I18N.leaves.vape,
      compute: (g) => {
        const distCost = num('vape_distCost');
        const mixDistCost = g.batch * pct('vape_pctDist') * distCost;
        const l = labor(g.batch, num('vape_rateMix'), num('vape_costMix'));
        const batchCost = (mixDistCost + l.cost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.distillat, value: mixDistCost },
            { label: I18N.lines.laborMelange, value: l.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - mixDistCost - l.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
    topicals: {
      label: I18N.leaves.topicals,
      compute: (g) => {
        const ingredientCost = num('topicals_ingredientCost');
        const l = labor(g.batch, num('topicals_rateXaman'), num('topicals_costXaman'));
        const batchCost = (l.cost + ingredientCost) * (1 + g.overhead);
        return {
          batchCost,
          perG: batchCost / g.batch + g.coaPerG,
          lines: [
            { label: I18N.lines.ingredients, value: ingredientCost },
            { label: I18N.lines.laborXaman, value: l.cost },
            { label: I18N.lines.overheadCoa, value: batchCost - ingredientCost - l.cost + g.coaPerG * g.batch },
          ],
        };
      },
    },
  };

  type QuestionKey = 'productType' | 'hashSource' | 'hashMethod';

  const QUESTIONS: Record<QuestionKey, Array<{ value: string; label: string; desc: string }>> = {
    productType: I18N.questions.productType,
    hashSource: I18N.questions.hashSource,
    hashMethod: I18N.questions.hashMethod,
  };

  const state: { productType: string | null; hashSource: string | null; hashMethod: string | null } = {
    productType: null,
    hashSource: null,
    hashMethod: null,
  };

  function renderChoiceGrid(question: QuestionKey) {
    const container = document.querySelector<HTMLElement>(`.choice-grid[data-question="${question}"]`);
    if (!container) return;
    const selected = state[question];
    container.innerHTML = QUESTIONS[question]
      .map(
        (opt) => `
        <button type="button" class="choice-btn${opt.value === selected ? ' selected' : ''}" data-value="${opt.value}">
          ${opt.label}<span>${opt.desc}</span>
        </button>`
      )
      .join('');
  }

  function leafFromState(): string | null {
    switch (state.productType) {
      case 'kief':
      case 'iweRaw':
      case 'rosin':
      case 'vape':
      case 'topicals':
        return state.productType;
      case 'hash':
        if (state.hashSource === 'fleur') return 'highyield';
        if (state.hashSource === 'kiefAchete') return 'purchasedKief';
        if (state.hashSource === 'trim') {
          if (state.hashMethod === 'drysift') return 'drysift';
          if (state.hashMethod === 'iwe') return 'iweHash';
          if (state.hashMethod === 'mix') return 'mix';
        }
        return null;
      default:
        return null;
    }
  }

  function updateVisibility() {
    const hashSourceCard = document.getElementById('q-hashSource') as HTMLElement;
    const hashMethodCard = document.getElementById('q-hashMethod') as HTMLElement;
    hashSourceCard.hidden = state.productType !== 'hash';
    hashMethodCard.hidden = !(state.productType === 'hash' && state.hashSource === 'trim');

    renderChoiceGrid('productType');
    renderChoiceGrid('hashSource');
    renderChoiceGrid('hashMethod');

    const leaf = leafFromState();
    document.querySelectorAll<HTMLElement>('.leaf-card').forEach((el) => {
      el.hidden = el.id !== `leaf-${leaf}`;
    });
    render();
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('.choice-btn') as HTMLElement | null;
    if (!btn) return;
    const grid = btn.closest<HTMLElement>('.choice-grid[data-question]');
    if (!grid) return;
    const key = grid.dataset.question as QuestionKey;
    (state as any)[key] = btn.dataset.value;
    if (key === 'productType') {
      state.hashSource = null;
      state.hashMethod = null;
    }
    if (key === 'hashSource') {
      state.hashMethod = null;
    }
    updateVisibility();
  });

  document.addEventListener('input', (e) => {
    if ((e.target as HTMLElement)?.closest('.calc-wizard')) render();
  });

  function render() {
    const out = document.getElementById('result');
    if (!out) return;
    const leafKey = leafFromState();
    if (!leafKey) {
      out.innerHTML = `<div class="result-placeholder">${I18N.resultPlaceholder}</div>`;
      return;
    }
    const g = generalParams();
    if (g.batch <= 0) {
      out.innerHTML = `<div class="warn-banner">${I18N.batchWarning}</div>`;
      return;
    }
    const leaf = LEAVES[leafKey];
    const result = leaf.compute(g);

    const marginChips = g.margins
      .map(
        (m) => `
        <div class="result-margin-chip">
          <span class="result-margin-pct">${fmtPct(m)}</span>
          <span class="result-margin-price">${fmtPerG(result.perG * (1 + m))}/g</span>
        </div>`
      )
      .join('');

    const breakdownLines = result.lines
      .map((l) => `<div class="breakdown-line"><span class="label">${l.label}</span><span>${fmtMoney2(l.value)}</span></div>`)
      .join('');

    if (leafKey === 'purchasedKief') {
      const kiefWeight = g.batch - g.batch * pct('pk_distPct') - num('pk_cbgG') - num('pk_cbnG');
      const distCostTotal = g.batch * pct('pk_distPct') * num('pk_distCost');
      const cbgCost = num('pk_cbgG') * num('pk_cbgcbnCost');
      const cbnCost = num('pk_cbnG') * num('pk_cbgcbnCost');
      const lKiefHash = labor(kiefWeight, num('pk_rateKiefHash'), num('pk_costKiefHash'));
      const targetSellPrice = num('pk_targetSellPrice');
      const cells = g.margins
        .map((m) => {
          if (kiefWeight === 0) return `<td>${I18N.naAbbrev}</td>`;
          const maxKief =
            ((((targetSellPrice / (1 + m) - g.coaPerG) * g.batch) / (1 + g.overhead) - lKiefHash.cost - distCostTotal - cbgCost - cbnCost) /
              kiefWeight);
          return `<td>${isFinite(maxKief) ? fmtPerG(maxKief) + '/g' : I18N.naAbbrev}</td>`;
        })
        .join('');
      const headers = g.margins.map((m) => `<th>${fmtPct(m)}</th>`).join('');
      const reverseSolveEl = document.getElementById('reverseSolveResult');
      if (reverseSolveEl) {
        reverseSolveEl.innerHTML = `
          <table class="reverse-table">
            <thead><tr>${headers}</tr></thead>
            <tbody><tr>${cells}</tr></tbody>
          </table>`;
      }
    }

    out.innerHTML = `
      <div class="card result-hero">
        <div class="result-hero-title">${I18N.resultEyebrow}</div>
        <div class="result-hero-name">${leaf.label}</div>
        <div class="result-stats">
          <div class="result-stat">
            <span class="result-stat-label">${I18N.costPerBatchStat}</span>
            <span class="result-stat-value">${fmtMoney2(result.batchCost)}</span>
          </div>
          <div class="result-stat accent">
            <span class="result-stat-label">${I18N.costPerGStat}</span>
            <span class="result-stat-value">${fmtPerG(result.perG)}</span>
          </div>
        </div>
        <div class="result-margins-label">${I18N.marginsSuggestedLabel}</div>
        <div class="result-margins">${marginChips}</div>
        <details class="result-breakdown">
          <summary>${I18N.viewBreakdownLabel}</summary>
          <div class="details-body">${breakdownLines}</div>
        </details>
      </div>
    `;
  }

  renderChoiceGrid('productType');
  renderChoiceGrid('hashSource');
  renderChoiceGrid('hashMethod');
  render();
</script>
