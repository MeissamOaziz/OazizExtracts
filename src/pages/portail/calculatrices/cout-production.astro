      <details>
        <summary>{T('advancedAssumptions')}</summary>
        <div class="details-body two-col">
          <div class="form-row">
            <label for="topicals_rateXaman">{T('rateXamanLabel')}</label>
            <input type="number" id="topicals_rateXaman" value="4166.67" step="1" />
          </div>
          <div class="form-row">
            <label for="topicals_costXaman">{T('costXamanLabel')}</label>
            <input type="number" id="topicals_costXaman" value="28" step="0.5" />
          </div>
        </div>
      </details>
    </div>

    <div id="result"></div>
  </div>
</PortailLayout>

