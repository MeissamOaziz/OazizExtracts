---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}
---
<PortailLayout title="Export Royaume-Uni — Fleur" staffName={staff.full_name}>
  <div class="calc-wizard">
    <div style="margin-bottom: 20px;">
      <a href="/portail/calculatrices" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
        ← Retour aux calculatrices
      </a>
    </div>
    <h1>Export Royaume-Uni — Fleur</h1>
    <p style="color: var(--p-muted); margin-bottom: 20px;">
      Modélise le parcours Oaziz Extracts → AgMedica (Canada) → RX Distributor (Royaume-Uni) → détail/pharmacie UK,
      sur la base de la soumission de RX UK Partner et des coûts AgMedica. Compare le coût par gramme selon la
      taille d'unité d'emballage.
    </p>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Devises (FX)</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="gbpToCad">Taux de conversion GBP → CAD</label>
          <input type="number" id="gbpToCad" value="1.95" step="0.01" />
        </div>
        <div class="form-row">
          <label>Taux CAD → GBP (dérivé)</label>
          <div id="cadToGbpDisplay" class="derived-value">—</div>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>Hypothèses du lot</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="lotSizeG">Taille du lot (g)</label>
          <input type="number" id="lotSizeG" value="40000" step="1000" />
        </div>
        <div class="form-row">
          <label for="flowerCostCad">Coût de la fleur par gramme (CA$/g)</label>
          <input type="number" id="flowerCostCad" value="2" step="0.05" />
        </div>
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="exportPermitCadPerG">Coût du permis d'exportation par gramme (CA$/g)</label>
          <input type="number" id="exportPermitCadPerG" value="0.25" step="0.01" />
        </div>
        <div class="form-row">
          <label for="shippingCadPerG">Coût d'expédition par gramme, Canada → UK (CA$/g)</label>
          <input type="number" id="shippingCadPerG" value="1.25" step="0.01" />
        </div>
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="highNorthCoaCad">Coût COA High North (CA$, forfaitaire par lot)</label>
          <input type="number" id="highNorthCoaCad" value="1500" step="50" />
        </div>
        <div class="form-row">
          <label for="permitsGmpCoaCad">Permis entrants/sortants + COA GMP (CA$, forfaitaire par lot)</label>
          <input type="number" id="permitsGmpCoaCad" value="5850" step="50" />
        </div>
      </div>
    </div>

    <div id="result"></div>
  </div>
</PortailLayout>

<style is:global>
  .derived-value {
    padding: 9px 12px;
    border: 1px solid var(--p-border);
    border-radius: 6px;
    background: var(--p-bg);
    color: var(--p-muted);
    font-size: .95rem;
    font-variant-numeric: tabular-nums;
  }

  .cost-line { display: flex; justify-content: space-between; padding: 6px 0; font-size: .88rem; gap: 12px; }
  .cost-line span:first-child { color: var(--p-muted); }
  .cost-line span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cost-line.subtotal { border-top: 1px solid var(--p-border); margin-top: 6px; padding-top: 8px; font-weight: 600; }

  .landed-highlight {
    margin-top: 16px;
    padding: 16px;
    border-radius: 10px;
    background: rgba(208, 88, 38, .08);
    border: 1px solid rgba(208, 88, 38, .3);
  }
  .landed-highlight .cost-line { font-size: 1rem; font-weight: 700; color: var(--p-accent); }
  .landed-highlight .cost-line span:first-child { color: var(--p-accent); }
  .landed-highlight .cost-line.small { font-size: .82rem; font-weight: 500; color: var(--p-muted); margin-top: 2px; }
  .landed-highlight .cost-line.small span:first-child { color: var(--p-muted); }

  table.unit-compare { width: 100%; border-collapse: collapse; font-size: .87rem; font-variant-numeric: tabular-nums; margin-top: 8px; }
  table.unit-compare th, table.unit-compare td { padding: 8px 10px; text-align: right; border-bottom: 1px solid var(--p-border); }
  table.unit-compare th:first-child, table.unit-compare td:first-child { text-align: left; }
  table.unit-compare th { font-weight: 600; color: var(--p-muted); font-size: .72rem; text-transform: uppercase; }
  table.unit-compare tbody tr.best-row { background: rgba(21, 128, 61, .07); font-weight: 600; }
</style>

<script>
  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isFinite(v) ? v : 0;
  }

  const fmtCad2 = (n: number) =>
    isFinite(n) ? n.toLocaleString('fr-CA', { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtCad0 = (n: number) =>
    isFinite(n) ? n.toLocaleString('fr-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }) : '—';
  const fmtGbp2 = (n: number) =>
    isFinite(n) ? n.toLocaleString('fr-CA', { style: 'currency', currency: 'GBP', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtPerGCad = (n: number) => (isFinite(n) ? '$' + n.toFixed(4) : '—');
  const fmtPerGGbp = (n: number) => (isFinite(n) ? '£' + n.toFixed(4) : '—');
  const fmtRate = (n: number) => (isFinite(n) ? n.toFixed(4) : '—');
  const fmtG = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString('fr-CA') + ' g' : '—');
  const fmtUnits = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString('fr-CA') : '—');

  type UnitOption = { label: string; unitG: number; packagingCostCad: number };
  const UNIT_OPTIONS: UnitOption[] = [
    { label: '10 g', unitG: 10, packagingCostCad: 1.56 },
    { label: '100 g', unitG: 100, packagingCostCad: 1.17 },
    { label: '200 g', unitG: 200, packagingCostCad: 1.17 },
  ];

  function render() {
    const out = document.getElementById('result');
    if (!out) return;

    const gbpToCad = num('gbpToCad');
    const cadToGbp = gbpToCad > 0 ? 1 / gbpToCad : 0;

    const cadToGbpDisplay = document.getElementById('cadToGbpDisplay');
    if (cadToGbpDisplay) cadToGbpDisplay.textContent = fmtRate(cadToGbp);

    const lotSizeG = num('lotSizeG');
    const flowerCostCad = num('flowerCostCad');
    const exportPermitCadPerG = num('exportPermitCadPerG');
    const shippingCadPerG = num('shippingCadPerG');
    const highNorthCoaCad = num('highNorthCoaCad');
    const permitsGmpCoaCad = num('permitsGmpCoaCad');

    if (lotSizeG <= 0) {
      out.innerHTML = `<div class="warn-banner">La taille du lot doit être supérieure à 0.</div>`;
      return;
    }

    const totalFlowerCost = lotSizeG * flowerCostCad;
    const exportPermitTotal = exportPermitCadPerG * lotSizeG;
    const shippingTotal = shippingCadPerG * lotSizeG;

    const totalLotCostCad = totalFlowerCost + exportPermitTotal + shippingTotal + highNorthCoaCad + permitsGmpCoaCad;
    const costPerGramCad = totalLotCostCad / lotSizeG;
    const costPerGramGbp = costPerGramCad * cadToGbp;

    const unitRows = UNIT_OPTIONS.map((opt) => {
      const unitsFromLot = lotSizeG / opt.unitG;
      const totalCostPerUnitCad = totalLotCostCad / unitsFromLot + opt.packagingCostCad;
      const totalCostPerUnitGbp = totalCostPerUnitCad * cadToGbp;
      const totalCostPerGramCad = totalCostPerUnitCad / opt.unitG;
      const totalCostPerGramGbp = totalCostPerGramCad * cadToGbp;
      return { ...opt, unitsFromLot, totalCostPerUnitCad, totalCostPerUnitGbp, totalCostPerGramCad, totalCostPerGramGbp };
    });

    const bestPerGram = Math.min(...unitRows.map((r) => r.totalCostPerGramCad));

    const unitRowsHtml = unitRows
      .map(
        (r) => `<tr class="${r.totalCostPerGramCad === bestPerGram ? 'best-row' : ''}">
          <td>${r.label}</td>
          <td>${fmtUnits(r.unitsFromLot)}</td>
          <td>${fmtCad2(r.totalCostPerUnitCad)}</td>
          <td>${fmtGbp2(r.totalCostPerUnitGbp)}</td>
          <td>${fmtPerGCad(r.totalCostPerGramCad)}</td>
          <td>${fmtPerGGbp(r.totalCostPerGramGbp)}</td>
        </tr>`
      )
      .join('');

    out.innerHTML = `
      <div class="card" style="margin-bottom: 16px;">
        <h2>Décompte du coût total du lot</h2>
        <div class="cost-line"><span>Coût de la fleur (${fmtG(lotSizeG)} × ${fmtPerGCad(flowerCostCad)}/g)</span><span>${fmtCad0(totalFlowerCost)}</span></div>
        <div class="cost-line"><span>Permis d'exportation</span><span>${fmtCad0(exportPermitTotal)}</span></div>
        <div class="cost-line"><span>Expédition Canada → UK</span><span>${fmtCad0(shippingTotal)}</span></div>
        <div class="cost-line"><span>COA High North</span><span>${fmtCad0(highNorthCoaCad)}</span></div>
        <div class="cost-line"><span>Permis entrants/sortants + COA GMP</span><span>${fmtCad0(permitsGmpCoaCad)}</span></div>
        <div class="cost-line subtotal"><span>Coût total du lot</span><span>${fmtCad0(totalLotCostCad)}</span></div>

        <div class="landed-highlight">
          <div class="cost-line"><span>★ COÛT / GRAMME</span><span>${fmtPerGCad(costPerGramCad)} CA$</span></div>
          <div class="cost-line small"><span>Équivalent</span><span>${fmtPerGGbp(costPerGramGbp)} £/g</span></div>
        </div>
      </div>

      <div class="card">
        <h2>Comparaison par taille d'unité d'emballage</h2>
        <p class="hint" style="margin-bottom: 12px;">
          Coût du lot réparti sur le nombre d'unités obtenues, plus le coût d'emballage propre à chaque format
          (soumission RX UK). La ligne surlignée est le format le moins coûteux par gramme.
        </p>
        <div style="overflow-x:auto;">
          <table class="unit-compare">
            <thead>
              <tr>
                <th>Format</th><th>Unités du lot</th><th>Coût / unité</th><th>Coût / unité (£)</th>
                <th>Coût / g</th><th>Coût / g (£)</th>
              </tr>
            </thead>
            <tbody>${unitRowsHtml}</tbody>
          </table>
        </div>
        <p class="hint" style="margin-top: 14px;">
          * Prix hors TVA. * Emballage secondaire non inclus. * Test de stabilité : £750–£2,000 par souche par an (non inclus).
        </p>
      </div>
    `;
  }

  document.addEventListener('input', (e) => {
    if (!(e.target as HTMLElement)?.closest('.calc-wizard')) return;
    render();
  });
  render();
</script>
