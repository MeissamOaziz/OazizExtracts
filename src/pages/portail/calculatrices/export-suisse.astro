---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frExportSuisse, enExportSuisse } from '../../../i18n/portail/export-suisse';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frExportSuisse, enExportSuisse);

const clientStrings = {
  locale,
  warnVolume: T('warnVolume'),
  breakdownHeading: T('breakdownHeading'),
  kiefPurchaseLine: T('kiefPurchaseLine'),
  shippingSupplierLine: T('shippingSupplierLine'),
  vacuumSealLine: T('vacuumSealLine'),
  exportPermitLine: T('exportPermitLine'),
  vertical7Line: T('vertical7Line'),
  jarPackagingLine: T('jarPackagingLine'),
  packagingLabourLine: T('packagingLabourLine'),
  shippingToVertical7Line: T('shippingToVertical7Line'),
  shippingToSwitzerlandLine: T('shippingToSwitzerlandLine'),
  fullCoaLine: T('fullCoaLine'),
  totalCostLine: T('totalCostLine'),
  costPerGramLabel: T('costPerGramLabel'),
  summaryHeading: T('summaryHeading'),
  summaryVolumeLine: T('summaryVolumeLine'),
  summaryCostPerGramLine: T('summaryCostPerGramLine'),
  summaryMarkupLine: T('summaryMarkupLine'),
  summarySellPriceLine: T('summarySellPriceLine'),
  summaryRevenueLine: T('summaryRevenueLine'),
  summaryProfitLine: T('summaryProfitLine'),
  summaryMarginLine: T('summaryMarginLine'),
  splitLine: T('splitLine'),
  splitReferenceLine: T('splitReferenceLine'),
};
---
<PortailLayout title={T('pageTitle')} staffName={staff.full_name}>
  <div class="calc-wizard">
    <div style="margin-bottom: 20px;">
      <a href="/portail/calculatrices" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
        {T('backLink')}
      </a>
    </div>
    <h1>{T('heading')}</h1>
    <p style="color: var(--p-muted); margin-bottom: 20px;">
      {T('intro')}
    </p>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('transactionHeading')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="totalVolumeG">{T('totalVolumeLabel')}</label>
          <input type="number" id="totalVolumeG" value="20000" step="1000" />
        </div>
        <div class="form-row">
          <label for="blockSizeG">{T('blockSizeLabel')}</label>
          <input type="number" id="blockSizeG" value="100" step="10" />
        </div>
      </div>
      <div class="form-row">
        <label>{T('jarCountLabel')}</label>
        <div id="jarCountDisplay" class="derived-value">—</div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('costHeading')}</h2>
      <div class="two-col">
        <div class="form-row">
          <label for="kiefPurchaseCadPerG">{T('kiefPurchaseLabel')}</label>
          <input type="number" id="kiefPurchaseCadPerG" value="0.92" step="0.01" />
        </div>
        <div class="form-row">
          <label for="shippingSupplierFlat">{T('shippingSupplierLabel')}</label>
          <input type="number" id="shippingSupplierFlat" value="200" step="10" />
        </div>
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="vacuumSealCadPerG">{T('vacuumSealLabel')}</label>
          <input type="number" id="vacuumSealCadPerG" value="0.12" step="0.01" />
        </div>
        <div class="form-row">
          <label for="exportPermitFlat">{T('exportPermitLabel')}</label>
          <input type="number" id="exportPermitFlat" value="755" step="5" />
        </div>
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="vertical7CadPerG">{T('vertical7Label')}</label>
          <input type="number" id="vertical7CadPerG" value="0.10" step="0.01" />
        </div>
        <div class="form-row">
          <label for="jarPackagingCadPerJar">{T('jarPackagingLabel')}</label>
          <input type="number" id="jarPackagingCadPerJar" value="1.75" step="0.05" />
        </div>
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="packagingLabourCadPerG">{T('packagingLabourLabel')}</label>
          <input type="number" id="packagingLabourCadPerG" value="0.10" step="0.01" />
        </div>
        <div class="form-row">
          <label for="shippingToVertical7Flat">{T('shippingToVertical7Label')}</label>
          <input type="number" id="shippingToVertical7Flat" value="300" step="10" />
        </div>
      </div>
      <div class="two-col">
        <div class="form-row">
          <label for="shippingToSwitzerlandCadPerG">{T('shippingToSwitzerlandLabel')}</label>
          <input type="number" id="shippingToSwitzerlandCadPerG" value="0.20" step="0.01" />
        </div>
        <div class="form-row">
          <label for="fullCoaFlat">{T('fullCoaLabel')}</label>
          <input type="number" id="fullCoaFlat" value="1600" step="50" />
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 16px;">
      <h2>{T('priceHeading')}</h2>
      <div class="form-row">
        <label for="markupPct">{T('markupLabel')}</label>
        <input type="number" id="markupPct" value="40" step="1" />
      </div>
    </div>

    <div id="result"></div>
  </div>
</PortailLayout>

<script type="application/json" id="calc-i18n-data" set:html={JSON.stringify(clientStrings)}></script>

<style is:global>
  .derived-value {
    padding: 9px 12px;
    border: 1px solid var(--p-border);
    border-radius: 6px;
    background: var(--p-bg);
    color: var(--p-muted);
    font-size: .95rem;
    font-variant-numeric: tabular-nums;
  }

  .cost-line { display: flex; justify-content: space-between; padding: 6px 0; font-size: .88rem; gap: 12px; }
  .cost-line span:first-child { color: var(--p-muted); }
  .cost-line span:last-child { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cost-line.subtotal { border-top: 1px solid var(--p-border); margin-top: 6px; padding-top: 8px; font-weight: 600; }

  .landed-highlight {
    margin-top: 16px;
    padding: 16px;
    border-radius: 10px;
    background: rgba(208, 88, 38, .08);
    border: 1px solid rgba(208, 88, 38, .3);
  }
  .landed-highlight .cost-line { font-size: 1rem; font-weight: 700; color: var(--p-accent); }
  .landed-highlight .cost-line span:first-child { color: var(--p-accent); }
  .landed-highlight .cost-line.small { font-size: .82rem; font-weight: 500; color: var(--p-muted); margin-top: 2px; }
  .landed-highlight .cost-line.small span:first-child { color: var(--p-muted); }
</style>

<script>
  const I18N = JSON.parse(document.getElementById('calc-i18n-data')!.textContent!);
  const NUM_LOCALE = I18N.locale === 'en' ? 'en-CA' : 'fr-CA';

  function num(id: string): number {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return 0;
    const v = parseFloat(el.value);
    return isFinite(v) ? v : 0;
  }

  const fmtMoney2 = (n: number) =>
    isFinite(n) ? n.toLocaleString(NUM_LOCALE, { style: 'currency', currency: 'CAD', minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—';
  const fmtMoney0 = (n: number) =>
    isFinite(n) ? n.toLocaleString(NUM_LOCALE, { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }) : '—';
  const fmtPerG = (n: number) => (isFinite(n) ? '$' + n.toFixed(4) : '—');
  const fmtPct1 = (n: number) => (isFinite(n) ? (n * 100).toFixed(1) + '%' : '—');
  const fmtPct2 = (n: number) => (isFinite(n) ? (n * 100).toFixed(2) + '%' : '—');
  const fmtG = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString(NUM_LOCALE) + ' g' : '—');
  const fmtUnits = (n: number) => (isFinite(n) ? Math.round(n).toLocaleString(NUM_LOCALE) : '—');

  function render() {
    const out = document.getElementById('result');
    if (!out) return;

    const totalVolumeG = num('totalVolumeG');
    const blockSizeG = num('blockSizeG');
    const jarCount = blockSizeG > 0 ? totalVolumeG / blockSizeG : 0;

    const jarCountDisplay = document.getElementById('jarCountDisplay');
    if (jarCountDisplay) jarCountDisplay.textContent = fmtUnits(jarCount);

    const kiefPurchaseCadPerG = num('kiefPurchaseCadPerG');
    const shippingSupplierFlat = num('shippingSupplierFlat');
    const vacuumSealCadPerG = num('vacuumSealCadPerG');
    const exportPermitFlat = num('exportPermitFlat');
    const vertical7CadPerG = num('vertical7CadPerG');
    const jarPackagingCadPerJar = num('jarPackagingCadPerJar');
    const packagingLabourCadPerG = num('packagingLabourCadPerG');
    const shippingToVertical7Flat = num('shippingToVertical7Flat');
    const shippingToSwitzerlandCadPerG = num('shippingToSwitzerlandCadPerG');
    const fullCoaFlat = num('fullCoaFlat');

    const markupPct = num('markupPct');

    if (totalVolumeG <= 0) {
      out.innerHTML = `<div class="warn-banner">${I18N.warnVolume}</div>`;
      return;
    }

    const kiefPurchaseTotal = kiefPurchaseCadPerG * totalVolumeG;
    const vacuumSealTotal = vacuumSealCadPerG * totalVolumeG;
    const vertical7Total = vertical7CadPerG * totalVolumeG;
    const jarPackagingTotal = jarPackagingCadPerJar * jarCount;
    const packagingLabourTotal = packagingLabourCadPerG * totalVolumeG;
    const shippingToSwitzerlandTotal = shippingToSwitzerlandCadPerG * totalVolumeG;

    const totalCost =
      kiefPurchaseTotal +
      shippingSupplierFlat +
      vacuumSealTotal +
      exportPermitFlat +
      vertical7Total +
      jarPackagingTotal +
      packagingLabourTotal +
      shippingToVertical7Flat +
      shippingToSwitzerlandTotal +
      fullCoaFlat;

    const costPerGram = totalVolumeG > 0 ? totalCost / totalVolumeG : 0;
    const sellPricePerGram = costPerGram * (1 + markupPct / 100);
    const totalRevenue = sellPricePerGram * totalVolumeG;
    const grossProfit = totalRevenue - totalCost;
    const grossMarginPct = totalRevenue > 0 ? grossProfit / totalRevenue : 0;
    const fiftyFiftySplit = grossProfit / 2;

    out.innerHTML = `
      <div class="card" style="margin-bottom: 16px;">
        <h2>${I18N.breakdownHeading}</h2>
        <div class="cost-line"><span>${I18N.kiefPurchaseLine} (${fmtG(totalVolumeG)} × ${fmtPerG(kiefPurchaseCadPerG)}/g)</span><span>${fmtMoney0(kiefPurchaseTotal)}</span></div>
        <div class="cost-line"><span>${I18N.shippingSupplierLine}</span><span>${fmtMoney0(shippingSupplierFlat)}</span></div>
        <div class="cost-line"><span>${I18N.vacuumSealLine}</span><span>${fmtMoney0(vacuumSealTotal)}</span></div>
        <div class="cost-line"><span>${I18N.exportPermitLine}</span><span>${fmtMoney0(exportPermitFlat)}</span></div>
        <div class="cost-line"><span>${I18N.vertical7Line}</span><span>${fmtMoney0(vertical7Total)}</span></div>
        <div class="cost-line"><span>${I18N.jarPackagingLine} (${fmtUnits(jarCount)} × ${fmtMoney2(jarPackagingCadPerJar)})</span><span>${fmtMoney0(jarPackagingTotal)}</span></div>
        <div class="cost-line"><span>${I18N.packagingLabourLine}</span><span>${fmtMoney0(packagingLabourTotal)}</span></div>
        <div class="cost-line"><span>${I18N.shippingToVertical7Line}</span><span>${fmtMoney0(shippingToVertical7Flat)}</span></div>
        <div class="cost-line"><span>${I18N.shippingToSwitzerlandLine}</span><span>${fmtMoney0(shippingToSwitzerlandTotal)}</span></div>
        <div class="cost-line"><span>${I18N.fullCoaLine}</span><span>${fmtMoney0(fullCoaFlat)}</span></div>
        <div class="cost-line subtotal"><span>${I18N.totalCostLine}</span><span>${fmtMoney0(totalCost)}</span></div>

        <div class="landed-highlight">
          <div class="cost-line"><span>${I18N.costPerGramLabel}</span><span>${fmtPerG(costPerGram)}</span></div>
        </div>
      </div>

      <div class="card">
        <h2>${I18N.summaryHeading}</h2>
        <div class="cost-line"><span>${I18N.summaryVolumeLine}</span><span>${fmtG(totalVolumeG)}</span></div>
        <div class="cost-line"><span>${I18N.summaryCostPerGramLine}</span><span>${fmtPerG(costPerGram)}</span></div>
        <div class="cost-line"><span>${I18N.summaryMarkupLine}</span><span>${fmtPct1(markupPct / 100)}</span></div>
        <div class="cost-line"><span>${I18N.summarySellPriceLine}</span><span>${fmtPerG(sellPricePerGram)}</span></div>
        <div class="cost-line"><span>${I18N.summaryRevenueLine}</span><span>${fmtMoney0(totalRevenue)}</span></div>
        <div class="cost-line subtotal"><span>${I18N.summaryProfitLine}</span><span>${fmtMoney0(grossProfit)}</span></div>
        <div class="cost-line"><span>${I18N.summaryMarginLine}</span><span>${fmtPct2(grossMarginPct)}</span></div>

        <div class="landed-highlight">
          <div class="cost-line"><span>${I18N.splitLine}</span><span>${fmtMoney0(fiftyFiftySplit)}</span></div>
          <div class="cost-line small"><span>${I18N.splitReferenceLine}</span><span></span></div>
        </div>
      </div>
    `;
  }

  document.addEventListener('input', (e) => {
    if (!(e.target as HTMLElement)?.closest('.calc-wizard')) return;
    render();
  });
  render();
</script>
