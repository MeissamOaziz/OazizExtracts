---
export const prerender = false;

import PortailLayout from '../../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../../lib/supabase';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const { id } = Astro.params;
if (!id) return Astro.redirect('/portail');

// Load the submission we're editing.
const { data: submission } = await supabase
  .from('submissions')
  .select(`
    id, status, created_by_email, form_date, product_name, product_type, quantity,
    production_state, production_id, rnd_objective,
    production_staff_id
  `)
  .eq('id', id)
  .maybeSingle();

if (!submission) return new Response('Demande introuvable.', { status: 404 });

if (submission.created_by_email !== staff.email) {
  return Astro.redirect(`/portail/demande/${id}?error=not_creator`);
}

const { data: currentParticipants } = await supabase
  .from('submission_participants')
  .select('participant_staff_id')
  .eq('submission_id', id);
const currentPartIds = new Set((currentParticipants ?? []).map((r) => r.participant_staff_id));

const { data: allStaff } = await supabase
  .from('staff')
  .select('id, full_name, email, title')
  .eq('is_active', true)
  .order('full_name');

const roster = allStaff ?? [];
const findByEmail = (email: string) => roster.find((s) => s.email === email);
const jorge = findByEmail('jorge@oaziz.ca');
const stephane = findByEmail('stephane@oaziz.ca');

const url = new URL(Astro.request.url);
const errCode = url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  missing: 'Veuillez remplir tous les champs obligatoires.',
  no_participants: 'Sélectionnez au moins un participant.',
  not_creator: 'Seul le créateur peut modifier cette demande.',
  unknown: 'Une erreur est survenue lors de la mise à jour.',
};

const statusLabel: Record<string, string> = {
  draft: 'Brouillon',
  sent: 'Envoyé',
  signing: 'En signature',
  complete: 'Complet',
  finalized: 'Finalisé',
  cancelled: 'Annulé',
};
const isSigned = submission.status !== 'draft';
---
<PortailLayout title="Modifier la demande" staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href={`/portail/demande/${id}`} style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
      ← Retour à la demande
    </a>
  </div>
  <h1>Modifier la demande</h1>
  <p style="color: var(--p-muted); margin-bottom: 8px;">
    Statut actuel : <span class={`badge badge-${submission.status}`}>{statusLabel[submission.status]}</span>
  </p>

  {isSigned && (
    <div class="flash flash-error" style="margin: 16px 0;">
      <strong>⚠ Attention :</strong> cette demande a déjà été envoyée pour signature.
      Enregistrer les modifications va&nbsp;:
      <ul style="margin: 6px 0 0 20px;">
        <li>Supprimer tous les jetons de signature actuels (les liens envoyés cesseront de fonctionner)</li>
        <li>Effacer toutes les signatures déjà collectées</li>
        <li>Supprimer le PDF signé s'il existait</li>
        <li>Remettre la demande à l'état <strong>Brouillon</strong> — vous devrez cliquer « Envoyer pour signature » à nouveau</li>
      </ul>
    </div>
  )}

  {errCode && (
    <div class="flash flash-error">{errorMessages[errCode] ?? errorMessages.unknown}</div>
  )}

  <form method="POST" action={`/api/portail/submissions/${id}/update`} class="card" onsubmit={isSigned ? "return confirm('Confirmer la modification ? Toutes les signatures actuelles seront effacées.');" : undefined}>
    <div class="form-row">
      <label for="form_date">Date (JJ/MM/AAAA)</label>
      <input type="date" name="form_date" id="form_date" value={submission.form_date} required />
    </div>

    <div class="form-row">
      <label>Nom de l'initiateur</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px; color: var(--p-text);">
        {jorge?.full_name ?? 'Jorge Sousa'}
        <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">(fixé)</span>
      </div>
    </div>

    <div class="form-row">
      <label for="product_name">Nom du produit / souche</label>
      <input type="text" name="product_name" id="product_name" value={submission.product_name} required />
    </div>

    <div class="form-row">
      <label for="product_type">Type de produit</label>
      <input type="text" name="product_type" id="product_type" value={submission.product_type} required />
    </div>

    <div class="form-row">
      <label for="quantity">Quantité totale (g ou unités)</label>
      <input type="text" name="quantity" id="quantity" value={submission.quantity} required />
      <div class="hint">Divisée automatiquement entre les participants sur les formulaires R&D.</div>
    </div>

    <div class="form-row">
      <label for="rnd_objective">Objectif de l'étude</label>
      <textarea name="rnd_objective" id="rnd_objective" rows="4" style="width:100%;padding:9px 12px;border:1px solid var(--p-border);border-radius:6px;font-family:inherit;font-size:.95rem;resize:vertical;">{submission.rnd_objective ?? ''}</textarea>
    </div>

    <div class="form-row">
      <label>Participants</label>
      <div class="participants-grid">
        {roster.map((s) => (
          <label>
            <input type="checkbox" name="participants" value={s.id} checked={currentPartIds.has(s.id)} />
            <span>{s.full_name}</span>
          </label>
        ))}
      </div>
    </div>

    <h2 style="margin-top: 28px;">À remplir par le personnel de production</h2>

    <div class="form-row">
      <label for="production_staff_id">Personnel de production</label>
      <select name="production_staff_id" id="production_staff_id" required>
        {roster.map((s) => (
          <option value={s.id} selected={s.id === submission.production_staff_id}>{s.full_name}</option>
        ))}
      </select>
    </div>

    <div class="form-row">
      <label>État de production</label>
      <div style="display: flex; gap: 20px; padding-top: 4px;">
        <label style="display:inline-flex;align-items:center;gap:6px;font-weight:400;margin:0;">
          <input type="radio" name="production_state" value="vrac" checked={submission.production_state === 'vrac'} /> Vrac
        </label>
        <label style="display:inline-flex;align-items:center;gap:6px;font-weight:400;margin:0;">
          <input type="radio" name="production_state" value="emballe" checked={submission.production_state === 'emballe'} /> Emballé
        </label>
      </div>
    </div>

    <div class="form-row">
      <label for="production_id">Identifiant du lot (ID)</label>
      <input type="text" name="production_id" id="production_id" value={submission.production_id ?? ''} />
    </div>

    <h2 style="margin-top: 28px;">Rôles pour la signature</h2>
    <div class="form-row">
      <label>Vérification AQ</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px;">
        {stephane?.full_name ?? 'Stephane Paquin'} <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">(fixé)</span>
      </div>
    </div>
    <div class="form-row">
      <label>Personne obtenant le consentement</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px;">
        {jorge?.full_name ?? 'Jorge Sousa'} <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">(fixé)</span>
      </div>
    </div>

    <div style="display: flex; gap: 12px; margin-top: 28px;">
      <button type="submit" class="btn btn-primary">
        {isSigned ? 'Enregistrer et repasser en brouillon' : 'Enregistrer les modifications'}
      </button>
      <a href={`/portail/demande/${id}`} class="btn btn-secondary" style="margin-left:auto;">Annuler</a>
    </div>
  </form>
</PortailLayout>
