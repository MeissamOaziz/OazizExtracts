---
export const prerender = false;

import PortailLayout from '../../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../../lib/portail-i18n';
import { frDemandeEditer, enDemandeEditer } from '../../../../i18n/portail/demande-editer';
import { frCommon, enCommon } from '../../../../i18n/portail/common';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frDemandeEditer, enDemandeEditer);
const Tc = makeT(locale, frCommon, enCommon);

const { id } = Astro.params;
if (!id) return Astro.redirect('/portail/formulaires');

// Load the submission we're editing.
const { data: submission } = await supabase
  .from('submissions')
  .select(`
    id, status, created_by_email, form_date, product_name, product_type, quantity,
    production_state, production_id, rnd_objective,
    production_staff_id
  `)
  .eq('id', id)
  .maybeSingle();

if (!submission) return new Response('Demande introuvable.', { status: 404 });

if (submission.created_by_email !== staff.email) {
  return Astro.redirect(`/portail/demande/${id}?error=not_creator`);
}

const { data: currentParticipants } = await supabase
  .from('submission_participants')
  .select('participant_staff_id')
  .eq('submission_id', id);
const currentPartIds = new Set((currentParticipants ?? []).map((r) => r.participant_staff_id));

const { data: allStaff } = await supabase
  .from('staff')
  .select('id, full_name, email, title')
  .eq('is_active', true)
  .order('full_name');

const roster = allStaff ?? [];
const findByEmail = (email: string) => roster.find((s) => s.email === email);
const jorge = findByEmail('jorge@oaziz.ca');
const stephane = findByEmail('stephane@oaziz.ca');

const url = new URL(Astro.request.url);
const errCode = url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  missing: T('error.missing'),
  no_participants: T('error.no_participants'),
  not_creator: T('error.not_creator'),
  unknown: T('error.unknown'),
};

const statusKey = `status.${submission.status}` as keyof typeof frCommon;
const isSigned = submission.status !== 'draft';
---
<PortailLayout title={T('title')} staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href={`/portail/demande/${id}`} style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
      {T('backLink')}
    </a>
  </div>
  <h1>{T('heading')}</h1>
  <p style="color: var(--p-muted); margin-bottom: 8px;">
    {T('currentStatus')} <span class={`badge badge-${submission.status}`}>{Tc(statusKey)}</span>
  </p>

  {isSigned && (
    <div class="flash flash-error" style="margin: 16px 0;">
      <strong>{T('warning.label')}</strong> {T('warning.intro')}
      <ul style="margin: 6px 0 0 20px;">
        <li>{T('warning.item1')}</li>
        <li>{T('warning.item2')}</li>
        <li>{T('warning.item3')}</li>
        <li>{T('warning.item4Before')}<strong>{Tc('status.draft')}</strong>{T('warning.item4After')}</li>
      </ul>
    </div>
  )}

  {errCode && (
    <div class="flash flash-error">{errorMessages[errCode] ?? errorMessages.unknown}</div>
  )}

  <form method="POST" action={`/api/portail/submissions/${id}/update`} class="card" onsubmit={isSigned ? `return confirm(${JSON.stringify(T('confirmDialog'))});` : undefined}>
    <div class="form-row">
      <label for="form_date">{T('label.formDate')}</label>
      <input type="date" name="form_date" id="form_date" value={submission.form_date} required />
    </div>

    <div class="form-row">
      <label>{T('label.initiatorName')}</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px; color: var(--p-text);">
        {jorge?.full_name ?? 'Jorge Sousa'}
        <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">{T('fixedTag')}</span>
      </div>
    </div>

    <div class="form-row">
      <label for="product_name">{T('label.productName')}</label>
      <input type="text" name="product_name" id="product_name" value={submission.product_name} required />
    </div>

    <div class="form-row">
      <label for="product_type">{T('label.productType')}</label>
      <input type="text" name="product_type" id="product_type" value={submission.product_type} required />
    </div>

    <div class="form-row">
      <label for="quantity">{T('label.quantity')}</label>
      <input type="text" name="quantity" id="quantity" value={submission.quantity} required />
      <div class="hint">{T('hint.quantity')}</div>
    </div>

    <div class="form-row">
      <label for="rnd_objective">{T('label.objective')}</label>
      <textarea name="rnd_objective" id="rnd_objective" rows="4" style="width:100%;padding:9px 12px;border:1px solid var(--p-border);border-radius:6px;font-family:inherit;font-size:.95rem;resize:vertical;">{submission.rnd_objective ?? ''}</textarea>
    </div>

    <div class="form-row">
      <label>{T('label.participants')}</label>
      <div class="participants-grid">
        {roster.map((s) => (
          <label>
            <input type="checkbox" name="participants" value={s.id} checked={currentPartIds.has(s.id)} />
            <span>{s.full_name}</span>
          </label>
        ))}
      </div>
    </div>

    <h2 style="margin-top: 28px;">{T('heading.production')}</h2>

    <div class="form-row">
      <label for="production_staff_id">{T('label.productionStaff')}</label>
      <select name="production_staff_id" id="production_staff_id" required>
        {roster.map((s) => (
          <option value={s.id} selected={s.id === submission.production_staff_id}>{s.full_name}</option>
        ))}
      </select>
    </div>

    <div class="form-row">
      <label>{T('label.productionState')}</label>
      <div style="display: flex; gap: 20px; padding-top: 4px;">
        <label style="display:inline-flex;align-items:center;gap:6px;font-weight:400;margin:0;">
          <input type="radio" name="production_state" value="vrac" checked={submission.production_state === 'vrac'} /> {Tc('state.vrac')}
        </label>
        <label style="display:inline-flex;align-items:center;gap:6px;font-weight:400;margin:0;">
          <input type="radio" name="production_state" value="emballe" checked={submission.production_state === 'emballe'} /> {Tc('state.emballe')}
        </label>
      </div>
    </div>

    <div class="form-row">
      <label for="production_id">{T('label.productionId')}</label>
      <input type="text" name="production_id" id="production_id" value={submission.production_id ?? ''} />
    </div>

    <h2 style="margin-top: 28px;">{T('heading.signatureRoles')}</h2>
    <div class="form-row">
      <label>{Tc('role.qa_verifier')}</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px;">
        {stephane?.full_name ?? 'Stephane Paquin'} <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">{T('fixedTag')}</span>
      </div>
    </div>
    <div class="form-row">
      <label>{Tc('role.consent_obtainer')}</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px;">
        {jorge?.full_name ?? 'Jorge Sousa'} <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">{T('fixedTag')}</span>
      </div>
    </div>

    <div style="display: flex; gap: 12px; margin-top: 28px;">
      <button type="submit" class="btn btn-primary">
        {isSigned ? T('submit.draft') : T('submit.normal')}
      </button>
      <a href={`/portail/demande/${id}`} class="btn btn-secondary" style="margin-left:auto;">{Tc('btn.cancel')}</a>
    </div>
  </form>
</PortailLayout>
