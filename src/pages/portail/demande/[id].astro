---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frCommon, enCommon } from '../../../i18n/portail/common';
import { frDemandeDetail, enDemandeDetail } from '../../../i18n/portail/demande-detail';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frDemandeDetail, enDemandeDetail);
const Tc = makeT(locale, frCommon, enCommon);

const { id } = Astro.params;
if (!id) return Astro.redirect('/portail/formulaires');

const { data: submission } = await supabase
  .from('submissions')
  .select(`
    id, status, created_by_email, form_date, product_name, product_type, quantity,
    production_state, production_id, created_at, updated_at, sent_at, finalized_at,
    initiator:initiator_staff_id ( full_name, email ),
    production:production_staff_id ( full_name, email ),
    qa:qa_staff_id ( full_name, email ),
    consent_obtainer:consent_obtainer_staff_id ( full_name, email )
  `)
  .eq('id', id)
  .maybeSingle();

if (!submission) {
  return new Response(T('error.not_found'), { status: 404 });
}

const { data: participants } = await supabase
  .from('submission_participants')
  .select('participant:participant_staff_id ( id, full_name, email )')
  .eq('submission_id', id);

const { data: signers } = await supabase
  .from('v_signers_public')
  .select('id, role, staff_name, staff_email, document_kind, participant_name, status, signed_at, expires_at, signer_token_id, completed_at')
  .eq('submission_id', id)
  .order('role');

// Group signers by signer_token_id so the "Régénérer le lien" button appears once per person
type SignerRow = {
  id: string;
  role: string;
  staff_name: string;
  staff_email: string;
  document_kind: string;
  participant_name: string | null;
  status: string;
  signed_at: string | null;
  signer_token_id: string | null;
  completed_at: string | null;
};
const signerRowList: SignerRow[] = (signers ?? []) as SignerRow[];
const tokenPending = new Map<string, boolean>();
for (const row of signerRowList) {
  if (!row.signer_token_id) continue;
  // Token is "pending overall" if it has no completed_at.
  tokenPending.set(row.signer_token_id, !row.completed_at);
}

const isCreator = submission.created_by_email === staff.email;
const isDraft = submission.status === 'draft';

// Does the CURRENT user have a pending signer_token on this submission?
// If yes, offer the in-app "Signer" button.
const { getAdminClient } = await import('../../../lib/supabase');
const adminForPending = getAdminClient();
const { data: myPendingToken } = await adminForPending
  .from('signer_tokens')
  .select('id')
  .eq('submission_id', id)
  .eq('staff_id', staff.id)
  .is('completed_at', null)
  .maybeSingle();
const hasPendingForMe = !!myPendingToken;

const pageUrl = new URL(Astro.request.url);
const info = pageUrl.searchParams.get('info');
const errCode = pageUrl.searchParams.get('error');
const revealUrl = pageUrl.searchParams.get('reveal_url');
const revealFor = pageUrl.searchParams.get('reveal_for');
const revealEmailStatus = pageUrl.searchParams.get('reveal_email_status');
const infoMessages: Record<string, string> = {
  sent: T('info.sent'),
  edited: T('info.edited'),
  signed: T('info.signed'),
  resent: T('info.resent'),
};
const errorMessages: Record<string, string> = {
  not_creator: T('error.not_creator'),
  already_sent: T('error.already_sent'),
  already_signed_row: T('error.already_signed_row'),
  no_participants: T('error.no_participants'),
  not_found: T('error.not_found'),
  not_finalized: T('error.not_finalized'),
  nothing_to_sign: T('error.nothing_to_sign'),
  unknown: T('error.unknown'),
  token_insert: T('error.token_insert'),
  signer_insert: T('error.signer_insert'),
  delete: T('error.delete'),
};
const emailStatusLabel: Record<string, string> = {
  sent: T('emailStatus.sent'),
  skipped_no_key: T('emailStatus.skipped_no_key'),
  error: T('emailStatus.error'),
};

function fmtDate(iso?: string | null): string {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString('fr-CA', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---
<PortailLayout title={submission.product_name || T('untitled')} staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href="/portail/formulaires" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
      {T('backLink')}
    </a>
  </div>

  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:16px;">
    <div>
      <h1 style="margin-bottom: 4px;">{submission.product_name}</h1>
      <p style="color: var(--p-muted);">
        {submission.product_type} · {T('createdOn')} {fmtDate(submission.created_at)}
      </p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
      {hasPendingForMe && (
        <a href={`/portail/demande/${id}/signer`} class="btn btn-primary" title={T('signNowTitle')}>
          {T('signNow')}
        </a>
      )}
      {['finalized', 'complete', 'signing', 'sent'].includes(submission.status) && (
        <a href={`/api/portail/documents/${id}/download`} class="btn btn-secondary" title={T('downloadPdfTitle')}>
          {T('downloadPdf')}
        </a>
      )}
      {isCreator && submission.status === 'finalized' && (
        <form method="POST" action={`/api/portail/submissions/${id}/resend-final`} style="margin: 0;">
          <button type="submit" class="btn btn-secondary" title={T('resendFinalTitle')}>
            {T('resendFinal')}
          </button>
        </form>
      )}
      <span class={`badge badge-${submission.status}`}>{Tc(`status.${submission.status}` as keyof typeof frCommon) ?? submission.status}</span>
    </div>
  </div>

  {info && infoMessages[info] && (
    <div class="flash flash-success">{infoMessages[info]}</div>
  )}
  {errCode && (
    <div class="flash flash-error">{errorMessages[errCode] ?? errorMessages.unknown}</div>
  )}
  {revealUrl && (
    <div class="card" id="reveal-card" style="border-color: var(--p-accent); margin-bottom: 20px;">
      <h2 style="margin-bottom: 6px;">{T('reveal.heading')} {revealFor}</h2>
      <p style="color: var(--p-muted); margin-bottom: 12px; font-size: .9rem;">
        {emailStatusLabel[revealEmailStatus ?? ''] ?? T('reveal.defaultCopy')}
        <br/>{T('reveal.previousRevoked')}
      </p>
      <div style="display: flex; gap: 8px; align-items: stretch;">
        <input type="text" id="reveal-input" value={revealUrl} readonly onclick="this.select()" style="flex: 1; font-family: monospace; font-size: .85rem;" />
        <button type="button" id="reveal-copy" class="btn btn-secondary" data-copy-text={T('reveal.copy')} data-copied-text={T('reveal.copied')}>{T('reveal.copy')}</button>
      </div>
      <script is:inline>
        (function() {
          // Strip the reveal_* params from the address bar so a page reload doesn't re-flash the URL.
          try {
            const u = new URL(window.location.href);
            u.searchParams.delete('reveal_url');
            u.searchParams.delete('reveal_for');
            u.searchParams.delete('reveal_token_id');
            u.searchParams.delete('reveal_email_status');
            window.history.replaceState({}, '', u.toString());
          } catch (e) {}

          const btn = document.getElementById('reveal-copy');
          const input = document.getElementById('reveal-input');
          if (btn && input) {
            const copyText = btn.dataset.copyText || 'Copier';
            const copiedText = btn.dataset.copiedText || 'Copié ✓';
            btn.addEventListener('click', function() {
              input.select();
              try {
                navigator.clipboard.writeText(input.value).then(function() {
                  btn.textContent = copiedText;
                  setTimeout(function() { btn.textContent = copyText; }, 1800);
                });
              } catch (e) {
                document.execCommand('copy');
                btn.textContent = copiedText;
                setTimeout(function() { btn.textContent = copyText; }, 1800);
              }
            });
          }
        })();
      </script>
    </div>
  )}

  <div class="card" style="margin-bottom: 24px;">
    <h2>{T('section.details')}</h2>
    <table class="data" style="margin-top: 12px;">
      <tbody>
        <tr><th style="width: 260px;">{T('field.formDate')}</th><td>{fmtDate(submission.form_date)}</td></tr>
        <tr><th>{T('field.initiator')}</th><td>{(submission.initiator as any)?.full_name ?? '—'}</td></tr>
        <tr><th>{T('field.productType')}</th><td>{submission.product_type}</td></tr>
        <tr><th>{T('field.quantity')}</th><td>{submission.quantity}</td></tr>
        <tr><th>{T('field.productionState')}</th><td>{submission.production_state ? (Tc(`state.${submission.production_state}` as keyof typeof frCommon) ?? submission.production_state) : '—'}</td></tr>
        <tr><th>{T('field.productionId')}</th><td>{submission.production_id || '—'}</td></tr>
        <tr><th>{T('field.productionStaff')}</th><td>{(submission.production as any)?.full_name ?? '—'}</td></tr>
        <tr><th>{T('field.qaVerification')}</th><td>{(submission.qa as any)?.full_name ?? '—'}</td></tr>
        <tr><th>{T('field.consentObtainer')}</th><td>{(submission.consent_obtainer as any)?.full_name ?? '—'}</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="margin-bottom: 24px;">
    <h2>{T('section.participants')} ({participants?.length ?? 0})</h2>
    {(!participants || participants.length === 0) ? (
      <p style="color: var(--p-muted); margin-top: 8px;">{T('participants.empty')}</p>
    ) : (
      <ul style="margin-top: 12px; padding-left: 20px;">
        {participants.map((p: any) => (
          <li style="margin-bottom: 6px;">{p.participant.full_name}</li>
        ))}
      </ul>
    )}
  </div>

  <div class="card" style="margin-bottom: 24px;">
    <h2>{T('section.signatures')}</h2>
    {(!signers || signers.length === 0) ? (
      <div style="color: var(--p-muted); margin-top: 8px;">
        {isDraft
          ? T('signatures.emptyDraft')
          : T('signatures.emptyOther')}
      </div>
    ) : (
      <table class="data" style="margin-top: 12px;">
        <thead>
          <tr>
            <th>{T('th.role')}</th>
            <th>{T('th.signer')}</th>
            <th>{T('th.document')}</th>
            <th>{T('th.status')}</th>
            <th>{T('th.signedOn')}</th>
            {isCreator && <th></th>}
          </tr>
        </thead>
        <tbody>
          {signerRowList.map((s, i) => {
            // Only show the regenerate button on the first row of each pending token
            const prev = signerRowList[i - 1];
            const isFirstOfToken = !prev || prev.signer_token_id !== s.signer_token_id;
            const canRegen = isCreator
              && isFirstOfToken
              && s.signer_token_id
              && tokenPending.get(s.signer_token_id) === true
              && ['sent', 'signing', 'complete'].includes(submission.status);
            return (
              <tr>
                <td>{Tc(`role.${s.role}` as keyof typeof frCommon) ?? s.role}</td>
                <td>
                  {s.staff_name}
                  {s.participant_name && <div style="color: var(--p-muted); font-size: .82rem;">{T('signerFor')} {s.participant_name}</div>}
                </td>
                <td>{Tc(`kind.${s.document_kind}` as keyof typeof frCommon) ?? s.document_kind}</td>
                <td>
                  <span class={`badge badge-${s.status === 'signed' ? 'complete' : s.status === 'pending' ? 'sent' : 'cancelled'}`}>
                    {s.status === 'signed' ? T('pill.signed') : s.status === 'pending' ? T('pill.pending') : s.status}
                  </span>
                </td>
                <td>{fmtDate(s.signed_at)}</td>
                {isCreator && (
                  <td style="text-align: right;">
                    {canRegen ? (
                      <form method="POST" action={`/api/portail/submissions/${id}/signers/${s.signer_token_id}/regenerate`} style="margin: 0;">
                        <button type="submit" class="btn btn-secondary" style="font-size: .78rem; padding: 5px 10px;">{T('regenerateLink')}</button>
                      </form>
                    ) : null}
                  </td>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
  </div>

  {isCreator && (
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      {isDraft && (
        <form method="POST" action={`/api/portail/submissions/${id}/send`} onsubmit={`return confirm('${T('confirm.send')}');`} style="margin: 0;">
          <button type="submit" class="btn btn-primary">{T('sendForSignature')}</button>
        </form>
      )}

      <a href={`/portail/demande/${id}/editer`} class="btn btn-secondary">
        {Tc('btn.edit')}{!isDraft && T('editSuffixNotDraft')}
      </a>

      <form
        method="POST"
        action={`/api/portail/submissions/${id}/delete`}
        onsubmit={
          isDraft
            ? `return confirm('${T('confirm.deleteDraft')}');`
            : `return confirm('${T('confirm.deleteSent')}');`
        }
        style="margin: 0; margin-left: auto;"
      >
        <button type="submit" class="btn btn-danger">
          {Tc('btn.delete')}{!isDraft && T('deleteSuffixNotDraft')}
        </button>
      </form>
    </div>
  )}
</PortailLayout>
