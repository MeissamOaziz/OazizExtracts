---
export const prerender = false;

import PortailLayout from '../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../lib/supabase';

const supabase = createServerClient(Astro.request, Astro.cookies);

// PKCE code-exchange: invite / recovery links from Resend land here with ?code=...
// Exchange for a session (setting cookies), then redirect to set-password.
const url = new URL(Astro.request.url);
const code = url.searchParams.get('code');
if (code) {
  const { error } = await supabase.auth.exchangeCodeForSession(code);
  if (error) {
    console.error('[portail] code exchange failed:', error);
    return Astro.redirect('/portail/connexion?error=invite_invalid');
  }
  return Astro.redirect('/portail/definir-mot-de-passe?first=1');
}

const staff = await currentStaff(supabase);
if (!staff) {
  // Might be a Supabase implicit-flow auth callback (#access_token=… in the
  // URL fragment). The server can't see the fragment, so render a tiny page
  // that hands the tokens to /api/portail/auth/hash-callback, which sets the
  // session cookie server-side. If no fragment is present, redirect to login.
  return new Response(`<!DOCTYPE html>
<html lang="fr"><head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Portail Oaziz</title>
  <style>
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#4b5063;background:#f4f5f7;margin:0;padding:0;display:flex;align-items:center;justify-content:center;min-height:100vh;text-align:center;}
    .spinner{width:32px;height:32px;border:3px solid #eaecef;border-top-color:#d05826;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 14px;}
    @keyframes spin{to{transform:rotate(360deg);}}
  </style>
</head>
<body>
  <div>
    <div class="spinner"></div>
    <div id="msg">Connexion en cours…</div>
  </div>
  <script>
    (function () {
      var h = window.location.hash || '';
      if (h.indexOf('access_token=') < 0) {
        window.location.replace('/portail/connexion');
        return;
      }
      var p = new URLSearchParams(h.replace(/^#/, ''));
      var body = {
        access_token: p.get('access_token'),
        refresh_token: p.get('refresh_token'),
      };
      // Wipe the tokens from the URL immediately.
      history.replaceState({}, '', '/portail');
      fetch('/api/portail/auth/hash-callback', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then(function (r) {
        if (!r.ok) throw new Error('bad status');
        window.location.replace('/portail/definir-mot-de-passe?first=1');
      }).catch(function () {
        document.getElementById('msg').textContent = 'Lien invalide ou expiré. Redirection…';
        setTimeout(function () { window.location.replace('/portail/connexion?error=invite_invalid'); }, 1500);
      });
    })();
  </script>
</body></html>`, {
    status: 200,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

const { count: pendingCount } = await supabase
  .from('submissions')
  .select('id', { count: 'exact', head: true })
  .in('status', ['draft', 'sent', 'signing']);

const sections = [
  {
    href: '/portail/formulaires',
    title: 'Formulaires R&D',
    desc: 'Demandes d\'échantillon, consentement, signatures et documents.',
    tag: pendingCount ? `${pendingCount} en cours` : null,
  },
  {
    href: '/portail/calculatrices',
    title: 'Calculatrices',
    desc: 'Coût de production, prix de vente par palier de marge, solveur inverse.',
    tag: null,
  },
];
---
<PortailLayout title="Accueil" staffName={staff.full_name}>
  <h1>Bonjour, {staff.full_name.split(' ')[0]}.</h1>
  <p style="color: var(--p-muted); margin-bottom: 24px;">Choisissez une section.</p>

  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
    {sections.map((s) => (
      <a href={s.href} class="card hub-card">
        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:8px; margin-bottom: 8px;">
          <h2 style="margin-bottom: 0;">{s.title}</h2>
          {s.tag && <span class="badge badge-sent">{s.tag}</span>}
        </div>
        <p style="color: var(--p-muted); font-size: .9rem; margin: 0;">{s.desc}</p>
      </a>
    ))}
  </div>
</PortailLayout>
<style>
  .hub-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .hub-card:hover {
    border-color: var(--p-accent);
    box-shadow: 0 2px 6px rgba(16,24,40,.08);
  }
</style>
