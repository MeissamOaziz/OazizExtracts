---
export const prerender = false;

import PortailLayout from '../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../lib/supabase';
import { getPortailLocale, makeT } from '../../lib/portail-i18n';
import { frNouvelle, enNouvelle } from '../../i18n/portail/nouvelle';
import { frCommon, enCommon } from '../../i18n/portail/common';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion');
}

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frNouvelle, enNouvelle);
const Tc = makeT(locale, frCommon, enCommon);

const { data: allStaff } = await supabase
  .from('staff')
  .select('id, full_name, email, title')
  .eq('is_active', true)
  .order('full_name');

const roster = allStaff ?? [];
const findByEmail = (email: string) => roster.find((s) => s.email === email);

// Locked-in role holders — the server enforces these too, regardless of what
// the form submits. Display-only in the UI.
const jorge = findByEmail('jorge@oaziz.ca');
const stephane = findByEmail('stephane@oaziz.ca');
const simon = findByEmail('simon@oaziz.ca');

const DEFAULT_OBJECTIVE = "Contrôle qualité, essai de traction, analyse physique du lot, R&D pour le lancement du produit, essai de résistance à la traction.";

const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  missing: T('error.missing'),
  no_participants: T('error.no_participants'),
  no_jorge: T('error.no_jorge'),
  no_stephane: T('error.no_stephane'),
  unknown: T('error.unknown'),
};

const today = new Date().toISOString().slice(0, 10);
---
<PortailLayout title={T('title')} staffName={staff.full_name}>
  <div style="margin-bottom: 20px;">
    <a href="/portail/formulaires" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">
      {T('backLink')}
    </a>
  </div>
  <h1>{T('heading')}</h1>
  <p style="color: var(--p-muted); margin-bottom: 24px;">
    F5-SOP-PRO-013/00 · {T('subtitleSection')}
  </p>

  {error && (
    <div class="flash flash-error">{errorMessages[error] ?? errorMessages.unknown}</div>
  )}

  <form method="POST" action="/api/portail/submissions" class="card">
    <div class="form-row">
      <label for="form_date">{T('label.formDate')}</label>
      <input type="date" name="form_date" id="form_date" value={today} required />
    </div>

    <div class="form-row">
      <label>{T('label.initiatorName')}</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px; color: var(--p-text);">
        {jorge?.full_name ?? 'Jorge Sousa'}
        <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">{T('fixedTag')}</span>
      </div>
    </div>

    <div class="form-row">
      <label for="product_name">{T('label.productName')}</label>
      <input type="text" name="product_name" id="product_name" required />
    </div>

    <div class="form-row">
      <label for="product_type">{T('label.productType')}</label>
      <input type="text" name="product_type" id="product_type" placeholder={T('placeholder.productType')} required />
    </div>

    <div class="form-row">
      <label for="quantity">{T('label.quantity')}</label>
      <input type="text" name="quantity" id="quantity" placeholder={T('placeholder.quantity')} required />
      <div class="hint">{T('hint.quantity')}</div>
    </div>

    <div class="form-row">
      <label for="rnd_objective">{T('label.objective')}</label>
      <textarea name="rnd_objective" id="rnd_objective" rows="4" style="width:100%;padding:9px 12px;border:1px solid var(--p-border);border-radius:6px;font-family:inherit;font-size:.95rem;resize:vertical;">{DEFAULT_OBJECTIVE}</textarea>
      <div class="hint">{T('hint.objective')}</div>
    </div>

    <div class="form-row">
      <label>{T('label.participants')}</label>
      <div class="participants-grid">
        {roster.map((s) => (
          <label>
            <input type="checkbox" name="participants" value={s.id} />
            <span>{s.full_name}</span>
          </label>
        ))}
      </div>
      <div class="hint">{T('hint.participants')}</div>
    </div>

    <h2 style="margin-top: 28px;">{T('heading.production')}</h2>

    <div class="form-row">
      <label for="production_staff_id">{Tc('role.production')}</label>
      <select name="production_staff_id" id="production_staff_id" required>
        {roster.map((s) => (
          <option value={s.id} selected={s.id === simon?.id}>{s.full_name}</option>
        ))}
      </select>
    </div>

    <div class="form-row">
      <label>{T('label.productionState')}</label>
      <div style="display: flex; gap: 20px; padding-top: 4px;">
        <label style="display:inline-flex;align-items:center;gap:6px;font-weight:400;margin:0;">
          <input type="radio" name="production_state" value="vrac" /> {Tc('state.vrac')}
        </label>
        <label style="display:inline-flex;align-items:center;gap:6px;font-weight:400;margin:0;">
          <input type="radio" name="production_state" value="emballe" /> {Tc('state.emballe')}
        </label>
      </div>
    </div>

    <div class="form-row">
      <label for="production_id">{T('label.productionId')}</label>
      <input type="text" name="production_id" id="production_id" />
    </div>

    <h2 style="margin-top: 28px;">{T('heading.signatureRoles')}</h2>
    <p class="hint" style="margin-bottom: 16px;">{T('hint.signatureRoles')}</p>

    <div class="form-row">
      <label>{Tc('role.qa_verifier')}</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px; color: var(--p-text);">
        {stephane?.full_name ?? 'Stephane Paquin'}
        <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">{T('fixedTag')}</span>
      </div>
    </div>

    <div class="form-row">
      <label>{Tc('role.consent_obtainer')}</label>
      <div style="padding: 9px 12px; border: 1px solid var(--p-border); background: #fafbfc; border-radius: 6px; color: var(--p-text);">
        {jorge?.full_name ?? 'Jorge Sousa'}
        <span style="color: var(--p-muted); font-size: .82rem; margin-left: 8px;">{T('fixedTag')}</span>
      </div>
    </div>

    <div style="display: flex; gap: 12px; margin-top: 28px;">
      <button type="submit" name="action" value="save_draft" class="btn btn-primary">
        {T('submit')}
      </button>
      <a href="/portail/formulaires" class="btn btn-secondary" style="margin-left:auto;">{Tc('btn.cancel')}</a>
    </div>
  </form>
</PortailLayout>
