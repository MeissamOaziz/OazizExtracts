---
export const prerender = false;

// Drop a supplier invoice (PDF/photo): it's read automatically, the supplier
// is matched, the fields are pre-filled for review, and a QuickBooks-ready
// summary is shown so the same invoice can be keyed into QB in one pass.
import PortailLayout from '../../../../layouts/PortailLayout.astro';
import PaiementsNav from '../../../../components/portail/PaiementsNav.astro';
import { createServerClient, currentStaff, getAdminClient } from '../../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../../lib/portail-i18n';
import { frPaiements, enPaiements } from '../../../../i18n/portail/paiements';
import { loadSuppliers } from '../../../../lib/payables';
import { extractionAvailable } from '../../../../lib/payables-extract';
import { connectionInfo } from '../../../../lib/qbo';

const staff = await currentStaff(createServerClient(Astro.request, Astro.cookies));
if (!staff) return Astro.redirect('/portail/connexion');
const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frPaiements, enPaiements);
const suppliers = await loadSuppliers(getAdminClient(), { includeInactive: false });
const qbEnv = (await connectionInfo(getAdminClient()))?.environment ?? null;
const sp = Astro.url.searchParams;
const errorKey = sp.get('error');
const i18n = {
  reading: T('pdf.reading'), noKey: T('pdf.noKey'), failed: T('pdf.failed'), dup: T('pdf.dup'),
  matched: T('pdf.matched'), newSupplier: T('pdf.newSupplierOpt'), copied: T('pdf.copied'),
  qbVendor: T('pdf.qb.vendor'), qbNumber: T('inv.number'), qbDate: T('inv.date'), qbDue: T('inv.due'),
  qbSubtotal: T('pdf.subtotal'), qbGst: T('pdf.gst'), qbQst: T('pdf.qst'), qbOther: T('pdf.otherTaxes'),
  qbTotal: T('pdf.total'), qbTerms: T('pdf.terms'), qbDesc: T('inv.description'), locale,
  codingFrom: T('pdf.qbFromHistory'), codingNone: T('pdf.qbNoHistory'), codingNew: T('pdf.qbNewSupplier'),
  dupTitle: T('dup.title'), dupChecking: T('dup.checking'), dupNone: T('dup.none'), dupNoneNoQb: T('dup.noneNoQb'),
  dupSrcPortal: T('dup.src.portal'), dupSrcQb: T('dup.src.qb'), dupRnumber: T('dup.r.number'), dupRamount_date: T('dup.r.amount_date'),
  dupRnumber_other_supplier: T('dup.r.number_other_supplier'), dupExact: T('dup.exact'), dupLikely: T('dup.likely'), dupView: T('dup.view'),
  dupLinkedQb: T('dup.linkedQb'), dupUseQb: T('dup.useQb'), dupBlocked: T('dup.blocked'),
  qbHost: qbEnv === 'production' ? 'https://qbo.intuit.com' : 'https://sandbox.qbo.intuit.com',
  saving: T('pdf.saving'), vendorNew: T('pdf.qbVendorNew'), vendorMatched: T('pdf.qbVendorMatched'), vendorNone: T('pdf.qbVendorNone'),
};
---
<PortailLayout title={T('pdf.title')} staffName={staff.full_name} wide>
  <h1>{T('title')}</h1>
  <PaiementsNav active="invoice" />
  {sp.get('ok') && <div class="flash flash-success">{T('inv.saved')}</div>}
  {errorKey && <div class="flash flash-error">{T(`pdf.error.${errorKey}` as keyof typeof frPaiements) ?? errorKey}</div>}
  {!extractionAvailable() && <div class="warn-banner">{T('pdf.noKey')}</div>}

  <label class="drop card" id="drop">
    <input type="file" id="file" accept="application/pdf,image/jpeg,image/png,image/webp" hidden />
    <strong>{T('pdf.drop')}</strong>
    <span class="muted">{T('pdf.dropHint')}</span>
  </label>
  <p id="status" class="status" hidden></p>

  <div class="grid">
    <form class="card" method="POST" action="/api/portail/paiements/invoices/create" id="inv-form">
      <input type="hidden" name="file_path" id="file_path" />
      <input type="hidden" name="submission_key" value={crypto.randomUUID()} />
      <input type="hidden" name="subtotal" id="subtotal" />
      <input type="hidden" name="tax_gst" id="tax_gst" />
      <input type="hidden" name="tax_qst" id="tax_qst" />
      <input type="hidden" name="x_vendor_name" id="x_vendor_name" />
      <input type="hidden" name="x_vendor_legal_name" id="x_vendor_legal_name" />
      <input type="hidden" name="x_vendor_email" id="x_vendor_email" />
      <input type="hidden" name="x_gst_number" id="x_gst_number" />
      <input type="hidden" name="x_qst_number" id="x_qst_number" />
      <div class="form-row">
        <label>{T('col.supplier')} *</label>
        <select name="supplier_id" id="supplier_id" required>
          <option value="">—</option>
          <option value="new">{T('pdf.newSupplierOpt')}</option>
          {suppliers.map((s) => <option value={s.id}>{s.name}</option>)}
        </select>
        <p class="hint" id="match-hint"></p>
      </div>
      <div id="new-supplier" hidden>
        <div class="two-col">
          <div class="form-row"><label>{T('f.name')} *</label><input type="text" name="new_supplier_name" id="new_supplier_name" /></div>
          <div class="form-row"><label>{T('f.legal_name')}</label><input type="text" name="new_supplier_legal_name" id="new_supplier_legal_name" /></div>
          <div class="form-row"><label>{T('f.contact_email')}</label><input type="email" name="new_supplier_email" id="new_supplier_email" /></div>
        </div>
        <div class="form-row"><label>{T('f.payment_details')}</label><textarea name="new_supplier_payment_details" id="new_supplier_payment_details" rows="2"></textarea></div>
      </div>
      <div class="three">
        <div class="form-row"><label>{T('inv.kind')}</label>
          <select name="kind" id="kind"><option value="invoice">{T('inv.kind.invoice')}</option><option value="credit">{T('inv.kind.credit')}</option></select>
        </div>
        <div class="form-row"><label>{T('inv.number')}</label><input type="text" name="invoice_number" id="invoice_number" /></div>
        <div class="form-row"><label>{T('inv.po')}</label><input type="text" name="po_number" id="po_number" /></div>
        <div class="form-row"><label>{T('inv.date')}</label><input type="date" name="invoice_date" id="invoice_date" /></div>
        <div class="form-row"><label>{T('inv.due')}</label><input type="date" name="due_date" id="due_date" /></div>
        <div class="form-row"><label>{T('pdf.total')} *</label><input type="text" inputmode="decimal" name="amount" id="amount" required /></div>
      </div>
      <div class="form-row"><label>{T('inv.description')}</label><input type="text" name="description" id="description" /></div>
      <fieldset class="qb-coding" id="qb-coding" hidden>
        <legend>{T('pdf.qbCoding')}</legend>
        <div class="form-row"><label>{T('pdf.qbVendor')}</label>
          <select name="qbo_vendor_choice" id="qbo_vendor_choice"><option value="new" id="qbo_vendor_new">{T('pdf.qbVendorNew')}</option></select>
          <p class="hint" id="qb-vendor-hint"></p>
        </div>
        <div class="two-col">
          <div class="form-row"><label>{T('pdf.qbAccount')}</label>
            <select name="qbo_account_id" id="qbo_account_id"><option value="">—</option></select>
          </div>
          <div class="form-row"><label>{T('pdf.qbTax')}</label>
            <select name="qbo_tax_code_id" id="qbo_tax_code_id"><option value="">{T('qbo.noTax')}</option></select>
          </div>
        </div>
        <p class="hint" id="qb-coding-hint"></p>
        <label class="check-inline"><input type="checkbox" name="qbo_remember" /> {T('pdf.qbRemember')}</label>
      </fieldset>
      <label class="check-inline"><input type="checkbox" name="in_quickbooks" /> {T('pdf.enteredQb')}</label>
      <p class="hint" style="margin:-6px 0 12px;">{T('pdf.qbAuto')}</p>
      <input type="hidden" name="link_qbo_bill_id" id="link_qbo_bill_id" />
      <div class="dup-panel" id="dup-panel" hidden>
        <p class="dup-status" id="dup-status"></p>
        <ul class="dup-list" id="dup-list"></ul>
        <p class="hint dup-using" id="dup-using" hidden>{T('dup.usingQb')}</p>
        <label class="check-inline" id="dup-confirm-row" hidden><input type="checkbox" id="dup-confirm" name="confirm_not_duplicate" value="1" /> {T('dup.confirm')}</label>
      </div>
      <div class="actions">
        <button class="btn btn-primary" type="submit" name="next" value="supplier">{T('pdf.save')}</button>
        <button class="btn btn-secondary" type="submit" name="next" value="another">{T('pdf.saveAnother')}</button>
      </div>
    </form>

    <aside class="side">
      <div class="card" id="qb-card" hidden>
        <div class="qb-head"><h2>{T('pdf.qb.title')}</h2><button type="button" class="btn btn-secondary" id="copy-qb">{T('pdf.copy')}</button></div>
        <p class="hint" style="margin-bottom:8px;">{T('pdf.qb.hint')}</p>
        <dl id="qb-list"></dl>
      </div>
      <div class="card preview" id="preview-card" hidden>
        <iframe id="preview" title="PDF"></iframe>
        <img id="preview-img" alt="" hidden />
      </div>
    </aside>
  </div>
  <script is:inline define:vars={{ i18n }}>window.__PDF = i18n;</script>
</PortailLayout>

<script>
  type X = Record<string, string | number | boolean | null>;
  const L = (window as unknown as { __PDF: Record<string, string> }).__PDF;
  const fmt = new Intl.NumberFormat(L.locale === 'en' ? 'en-CA' : 'fr-CA', { style: 'currency', currency: 'CAD' });
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const status = $('status');
  const say = (t: string, bad = false) => { status.textContent = t; status.hidden = false; status.classList.toggle('bad', bad); };
  const supSel = $<HTMLSelectElement>('supplier_id');
  const toggleNew = () => { $('new-supplier').hidden = supSel.value !== 'new'; $<HTMLInputElement>('new_supplier_name').required = supSel.value === 'new'; };

  // QuickBooks coding: suggested from how this supplier's previous QB bills were coded.
  let listsLoaded = false;
  let lastX: X | null = null;
  // Tax code from the taxes printed on the invoice: GST+QST → GST/QST QC, GST only → GST,
  // HST → HST, none → Exempt. Falls back to the supplier's history.
  function taxFromInvoice(codes: Array<{ id: string; name: string }>, x: X | null): string | null {
    if (!x) return null;
    const sub = Number(x.subtotal) || 0, g = Number(x.gst_hst) || 0, q = Number(x.qst) || 0;
    const find = (re: RegExp, not?: RegExp) => codes.find((c) => re.test(c.name) && !(not && not.test(c.name)))?.id ?? null;
    if (g > 0 && q > 0) return find(/GST\s*\/\s*QST/i) ?? find(/QST/i);
    if (g > 0 && sub > 0 && g / sub > 0.07) return find(/^HST/i);
    if (g > 0) return find(/^GST$/i) ?? find(/^GST/i, /QST|HST|Adjust/i);
    if (sub > 0 && Math.abs(sub - Math.abs(Number(x.total) || 0)) < 0.01) return find(/^Exempt/i) ?? find(/Zero/i);
    return null;
  }
  async function loadCoding() {
    const sid = supSel.value;
    const qs = new URLSearchParams();
    if (sid && sid !== 'new') qs.set('supplier_id', sid);
    if (lastX?.vendor_name) qs.set('vendor_name', String(lastX.vendor_name));
    if (lastX?.vendor_legal_name) qs.set('vendor_legal_name', String(lastX.vendor_legal_name));
    const r = await fetch(`/api/portail/paiements/qbo/suggest?${qs}`);
    const res = await r.json().catch(() => ({}));
    if (!res.connected) return;
    $('qb-coding').hidden = false;
    const accSel = $<HTMLSelectElement>('qbo_account_id');
    const taxSel = $<HTMLSelectElement>('qbo_tax_code_id');
    const venSel = $<HTMLSelectElement>('qbo_vendor_choice');
    if (!listsLoaded && res.accounts) {
      for (const a of res.accounts) accSel.add(new Option(a.name, a.id));
      for (const t of res.taxCodes) taxSel.add(new Option(t.name, t.id));
      for (const v of res.vendors ?? []) venSel.add(new Option(v.name, v.id));
      listsLoaded = true;
    }
    // Created under the trade name, with the legal name as QB's company name.
    const trade = String(lastX?.vendor_name || lastX?.vendor_legal_name || '');
    const legal = lastX?.vendor_legal_name && lastX.vendor_legal_name !== trade ? ` (${lastX.vendor_legal_name})` : '';
    $('qbo_vendor_new').textContent = trade ? `${L.vendorNew} « ${trade} »${legal}` : L.vendorNew;
    venSel.value = res.vendorId ?? 'new';
    $('qb-vendor-hint').textContent = res.vendorId ? L.vendorMatched : L.vendorNone;
    scheduleCheck();
    // Account is required unless the bill is already keyed into QB by hand.
    const already = document.querySelector<HTMLInputElement>('input[name="in_quickbooks"]')!;
    accSel.required = !already.checked;
    already.onchange = () => { accSel.required = !already.checked; };

    const s = res.suggestion;
    const hint = $('qb-coding-hint');
    const fromInvoice = taxFromInvoice(res.taxCodes ?? [], lastX);
    if (fromInvoice) taxSel.value = fromInvoice; else if (s?.taxCodeId) taxSel.value = s.taxCodeId;
    if (sid === 'new' || !sid) { accSel.value = ''; hint.textContent = L.codingNew; return; }
    accSel.value = s?.accountId ?? '';
    hint.textContent = s?.basedOn ? L.codingFrom.replace('{n}', String(s.basedOn)).replace('{pct}', String(Math.round((s.share ?? 0) * 100))) : L.codingNone;
  }
  supSel.addEventListener('change', () => { toggleNew(); loadCoding(); });

  async function handle(file: File) {
    say(L.reading);
    const url = URL.createObjectURL(file);
    $('preview-card').hidden = false;
    const isPdf = file.type === 'application/pdf';
    $<HTMLIFrameElement>('preview').hidden = !isPdf; $<HTMLImageElement>('preview-img').hidden = isPdf;
    if (isPdf) $<HTMLIFrameElement>('preview').src = url; else $<HTMLImageElement>('preview-img').src = url;

    const fd = new FormData(); fd.append('file', file);
    const r = await fetch('/api/portail/paiements/invoices/extract', { method: 'POST', body: fd });
    const res = await r.json().catch(() => ({ error: 'Erreur' }));
    if (!r.ok) { say(res.error ?? 'Erreur', true); return; }
    $<HTMLInputElement>('file_path').value = res.file_path;
    if (!res.extracted) { say(res.warning === 'no_key' ? L.noKey : `${L.failed} ${res.detail ?? ''}`, true); return; }
    const x = res.extracted as X;
    lastX = x;
    const set = (id: string, v: unknown) => { if (v !== null && v !== undefined && v !== '') $<HTMLInputElement>(id).value = String(v); };
    set('x_vendor_name', x.vendor_name); set('x_vendor_legal_name', x.vendor_legal_name); set('x_vendor_email', x.vendor_email);
    set('x_gst_number', x.vendor_gst_number); set('x_qst_number', x.vendor_qst_number);
    set('invoice_number', x.invoice_number); set('po_number', x.po_number);
    set('invoice_date', x.invoice_date); set('due_date', x.due_date);
    set('amount', Math.abs(Number(x.total)).toFixed(2)); set('description', x.description);
    set('subtotal', x.subtotal); set('tax_gst', x.gst_hst); set('tax_qst', x.qst);
    $<HTMLSelectElement>('kind').value = x.is_credit_note ? 'credit' : 'invoice';

    const m = res.matches as Array<{ id: string; name: string; score: number }>;
    if (m.length && m[0].score >= 0.6) {
      supSel.value = m[0].id;
      $('match-hint').textContent = L.matched.replace('{name}', m[0].name) + (m.length > 1 ? ` (${m.slice(1).map((o) => o.name).join(', ')})` : '');
    } else {
      supSel.value = 'new';
      set('new_supplier_name', x.vendor_name); set('new_supplier_legal_name', x.vendor_legal_name);
      set('new_supplier_email', x.vendor_email); set('new_supplier_payment_details', x.payment_instructions);
      $('match-hint').textContent = m.length ? `${L.newSupplier} — ${m.map((o) => o.name).join(', ')} ?` : '';
    }
    toggleNew();
    loadCoding();
    runCheck();

    const money = (v: unknown) => (v === null || v === undefined ? null : fmt.format(Number(v)));
    const rows: Array<[string, string | null]> = [
      [L.qbVendor, [x.vendor_name, x.vendor_legal_name].filter(Boolean).join(' / ')],
      [L.qbNumber, x.invoice_number as string | null], [L.qbDate, x.invoice_date as string | null],
      [L.qbDue, x.due_date as string | null], [L.qbTerms, x.payment_terms as string | null],
      [L.qbSubtotal, money(x.subtotal)], [L.qbGst, money(x.gst_hst)], [L.qbQst, money(x.qst)],
      [L.qbOther, money(x.other_taxes)], [L.qbTotal, `${money(x.total)}${x.currency !== 'CAD' ? ` ${x.currency}` : ''}`],
      [L.qbDesc, x.description as string | null],
    ];
    const dl = $('qb-list'); dl.innerHTML = '';
    for (const [k, v] of rows) {
      if (!v) continue;
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = v;
      dl.append(dt, dd);
    }
    $('qb-card').hidden = false;
    $('copy-qb').onclick = async () => {
      await navigator.clipboard.writeText(rows.filter(([, v]) => v).map(([k, v]) => `${k}: ${v}`).join('\n'));
      say(L.copied);
    };
    status.hidden = true;
  }

  // ---- Duplicate check (portal + QuickBooks), re-run whenever a key field changes.
  type Dup = { source: 'portal' | 'qb'; strength: 'exact' | 'likely'; reason: string; number: string | null; date: string | null;
    amount: number; supplier: string | null; id: string; supplierId?: string; qbType?: string; linked?: boolean };
  let dupBlocking = false;
  let checkSeq = 0;
  let checkTimer: number | undefined;
  const linkInput = $<HTMLInputElement>('link_qbo_bill_id');
  function setLink(id: string) {
    linkInput.value = id;
    $('dup-using').hidden = !id;
    const acc = document.getElementById('qbo_account_id') as HTMLSelectElement | null;
    const already = document.querySelector<HTMLInputElement>('input[name="in_quickbooks"]')!;
    if (acc) acc.required = !id && !already.checked;
    document.querySelectorAll<HTMLButtonElement>('.use-qb').forEach((b) => b.classList.toggle('chosen', b.dataset.id === id));
  }
  async function runCheck() {
    const number = $<HTMLInputElement>('invoice_number').value.trim();
    const amount = $<HTMLInputElement>('amount').value.trim();
    const panel = $('dup-panel');
    if (!number && !amount) { panel.hidden = true; dupBlocking = false; return; }
    const seq = ++checkSeq;
    panel.hidden = false;
    $('dup-status').textContent = L.dupChecking;
    $('dup-status').className = 'dup-status';
    const venSel = document.getElementById('qbo_vendor_choice') as HTMLSelectElement | null;
    const r = await fetch('/api/portail/paiements/invoices/check-duplicates', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        supplier_id: supSel.value, qbo_vendor_id: venSel && venSel.value !== 'new' ? venSel.value : null,
        number, amount, date: $<HTMLInputElement>('invoice_date').value, kind: $<HTMLSelectElement>('kind').value,
      }),
    }).catch(() => null);
    if (seq !== checkSeq) return;
    const res = r ? await r.json().catch(() => ({})) : {};
    const matches = (res.matches ?? []) as Dup[];
    const list = $('dup-list'); list.innerHTML = '';
    if (!matches.some((m) => m.source === 'qb' && m.id === linkInput.value)) setLink('');
    if (!matches.length) {
      $('dup-status').textContent = res.qbChecked ? L.dupNone : L.dupNoneNoQb;
      $('dup-status').className = 'dup-status ok';
      $('dup-confirm-row').hidden = true; dupBlocking = false;
      return;
    }
    $('dup-status').textContent = L.dupTitle;
    $('dup-status').className = 'dup-status bad';
    for (const m of matches) {
      const li = document.createElement('li');
      const tag = document.createElement('span');
      tag.className = `dup-tag ${m.strength}`; tag.textContent = m.strength === 'exact' ? L.dupExact : L.dupLikely;
      const txt = document.createElement('span');
      const reason = (L as Record<string, string>)[`dupR${m.reason}`] ?? m.reason;
      txt.textContent = ` ${m.source === 'qb' ? L.dupSrcQb : L.dupSrcPortal} · ${m.supplier ?? ''} · #${m.number ?? '—'} · ${m.date ?? '—'} · ${fmt.format(m.amount)} — ${reason}${m.linked ? ` (${L.dupLinkedQb})` : ''} `;
      const a = document.createElement('a');
      a.target = '_blank'; a.rel = 'noopener'; a.textContent = `${L.dupView} ↗`;
      a.href = m.source === 'portal' ? `/portail/paiements/fournisseurs/${m.supplierId}` : `${L.qbHost}/app/${m.qbType === 'VendorCredit' ? 'vendorcredit' : 'bill'}?txnId=${m.id}`;
      li.append(tag, txt, a);
      if (m.source === 'qb' && !m.linked) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn btn-secondary use-qb'; b.dataset.id = m.id; b.textContent = L.dupUseQb;
        b.onclick = () => setLink(linkInput.value === m.id ? '' : m.id);
        li.append(' ', b);
      }
      list.append(li);
    }
    // An exact match must be resolved: confirm it's not a duplicate, or reuse the QB bill.
    dupBlocking = matches.some((m) => m.strength === 'exact');
    $('dup-confirm-row').hidden = !dupBlocking;
    $<HTMLInputElement>('dup-confirm').checked = false;
    setLink(linkInput.value);
  }
  const scheduleCheck = () => { clearTimeout(checkTimer); checkTimer = window.setTimeout(runCheck, 500); };
  ['invoice_number', 'amount', 'invoice_date'].forEach((id) => $(id).addEventListener('input', scheduleCheck));
  ['kind', 'supplier_id', 'qbo_vendor_choice'].forEach((id) => $(id).addEventListener('change', scheduleCheck));

  // One save per form: grey out both buttons and show progress after the first click.
  const invForm = $<HTMLFormElement>('inv-form');
  invForm.addEventListener('submit', (ev) => {
    const btns = invForm.querySelectorAll<HTMLButtonElement>('button[type=submit]');
    if (dupBlocking && !$<HTMLInputElement>('dup-confirm').checked && !linkInput.value) {
      ev.preventDefault();
      $('dup-status').textContent = L.dupBlocked;
      $('dup-panel').scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    if (invForm.dataset.sent) { ev.preventDefault(); return; }
    invForm.dataset.sent = '1';
    const clicked = (ev as SubmitEvent).submitter as HTMLButtonElement | null;
    if (clicked?.name) {
      const h = document.createElement('input');
      h.type = 'hidden'; h.name = clicked.name; h.value = clicked.value;
      invForm.appendChild(h);
    }
    btns.forEach((b) => { b.disabled = true; });
    if (clicked) clicked.textContent = L.saving;
  });

  const drop = $('drop');
  const input = $<HTMLInputElement>('file');
  input.addEventListener('change', () => { if (input.files?.[0]) handle(input.files[0]); });
  ['dragenter', 'dragover'].forEach((e) => drop.addEventListener(e, (ev) => { ev.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((e) => drop.addEventListener(e, (ev) => { ev.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (ev) => { const f = (ev as DragEvent).dataTransfer?.files?.[0]; if (f) handle(f); });
</script>

<style>
  .drop { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 34px;
