---
export const prerender = false;

import PortailLayout from '../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff } from '../../lib/supabase';
import { getPortailLocale, makeT } from '../../lib/portail-i18n';
import { frDefinirMotDePasse, enDefinirMotDePasse } from '../../i18n/portail/definir-mot-de-passe';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) {
  return Astro.redirect('/portail/connexion?error=no_session');
}

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frDefinirMotDePasse, enDefinirMotDePasse);

const url = new URL(Astro.request.url);
const isFirst = url.searchParams.get('first') === '1';
const errCode = url.searchParams.get('error');
const errDetail = url.searchParams.get('detail');
const errorMessages: Record<string, string> = {
  short: T('error.short'),
  mismatch: T('error.mismatch'),
  weak: T('error.weak'),
  unknown: T('error.unknown'),
};
---
<PortailLayout title={T('title')} staffName={staff.full_name} minimal>
  <div style="max-width: 480px; margin: 40px auto;">
    <div class="card">
      <h1 style="margin-bottom: 8px;">
        {isFirst ? T('h1.first') : T('h1.reset')}
      </h1>
      <p style="color: var(--p-muted); font-size: .92rem; margin-bottom: 22px;">
        {isFirst
          ? T('subtitle.first').replace('{name}', staff.full_name.split(' ')[0])
          : T('subtitle.reset')}
      </p>

      {errCode && (
        <div class="flash flash-error">
          {errorMessages[errCode] ?? errorMessages.unknown}
          {errDetail && (
            <div style="margin-top: 6px; font-size: .82rem; opacity: .85;">
              <strong>{T('error.detailLabel')}</strong> {errDetail}
            </div>
          )}
        </div>
      )}

      <form method="POST" action="/api/portail/set-password">
        <div class="form-row">
          <label for="password">{T('label.password')}</label>
          <input type="password" name="password" id="password" required minlength="8" autocomplete="new-password" />
          <div class="hint">
            <strong>{T('hint.strong')}</strong> {T('hint.rest')}
            <br/>{T('hint.tipPrefix')}<em>{T('hint.example')}</em>{T('hint.tipSuffix')}
          </div>
        </div>
        <div class="form-row">
          <label for="confirm">{T('label.confirm')}</label>
          <input type="password" name="confirm" id="confirm" required minlength="8" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          {isFirst ? T('submit.first') : T('submit.reset')}
        </button>
      </form>
    </div>
  </div>
</PortailLayout>
