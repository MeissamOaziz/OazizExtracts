---
export const prerender = false;

import PortailLayout from '../../../layouts/PortailLayout.astro';
import { createServerClient, currentStaff, getAdminClient } from '../../../lib/supabase';
import { getPortailLocale, makeT } from '../../../lib/portail-i18n';
import { frFournisseursDetail, enFournisseursDetail } from '../../../i18n/portail/fournisseurs-detail';
import { frVendorForm, enVendorForm } from '../../../i18n/vendor-form';
import { getQbo } from '../../../lib/qbo';
import { bankAcctNum, businessNumber as cleanBn, similarVendors, vendorPreview, type VendorSubmission } from '../../../lib/vendor-qbo';

const supabase = createServerClient(Astro.request, Astro.cookies);
const staff = await currentStaff(supabase);
if (!staff) return Astro.redirect('/portail/connexion');

const locale = getPortailLocale(Astro.cookies);
const T = makeT(locale, frFournisseursDetail, enFournisseursDetail);
const Tv = makeT(locale, frVendorForm, enVendorForm);

const { id } = Astro.params;
if (!id) return Astro.redirect('/portail/fournisseurs');

const admin = getAdminClient();
const { data: submission } = await admin
  .from('vendor_submissions')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!submission) return new Response(T('notFound'), { status: 404 });
const isDraft = submission.status !== 'submitted';

const { data: approvalRows } = await admin
  .from('vendor_submission_approvals')
  .select('id, staff_id, approved_at, decision, decision_note, decided_at, staff:staff_id ( full_name, email )')
  .eq('vendor_submission_id', id)
  .order('created_at');

type Decision = 'approved' | 'feedback' | 'rejected';
type ApprovalRow = {
  id: string; staff_id: string; approved_at: string | null; decision: Decision | null; decision_note: string | null;
  decided_at: string | null; staff: { full_name: string; email: string } | null;
};
const approvals = (approvalRows ?? []) as unknown as ApprovalRow[];
const fullyApproved = approvals.length > 0 && approvals.every((a) => !!a.approved_at);
// The file's state: any rejection wins, then any request for feedback.
const rejected = approvals.filter((a) => a.decision === 'rejected');
const onHold = approvals.filter((a) => a.decision === 'feedback');
const fileState: 'rejected' | 'feedback' | 'approved' | 'pending' =
  rejected.length ? 'rejected' : onHold.length ? 'feedback' : fullyApproved ? 'approved' : 'pending';

const { data: eventRows } = await admin
  .from('vendor_submission_events')
  .select('id, at, decision, note, supplier_notified_to, staff:staff_id ( full_name )')
  .eq('vendor_submission_id', id)
  .order('at', { ascending: false });
const history = (eventRows ?? []) as unknown as Array<{
  id: number; at: string; decision: Decision | 'resubmitted' | 'staff_edited' | 'staff_submitted'; note: string | null;
  supplier_notified_to: string[] | null; staff: { full_name: string } | null;
}>;
const decisionBadge: Record<string, string> = { approved: 'badge-complete', feedback: 'badge-signing', rejected: 'badge-cancelled', resubmitted: 'badge-sent', staff_edited: 'badge-draft', staff_submitted: 'badge-sent' };

// QuickBooks card: for the accountants (Payments access) once the VQ is submitted.
const accountant = !!Astro.locals.access?.perms?.has('payables');
const showQb = accountant && submission.status === 'submitted';
const approvedCount = approvals.filter((a) => !!a.approved_at).length;
let qbConnected = false;
let similar: Array<{ id: string; name: string; company: string | null; score: number }> = [];
let qbLookupError: string | null = null;
const preview = vendorPreview(submission as VendorSubmission);
let pushedBy: string | null = null;
if (showQb && !submission.qbo_vendor_id) {
  try {
    const qbo = await getQbo(admin);
    qbConnected = !!qbo;
    if (qbo) similar = await similarVendors(qbo, submission as VendorSubmission);
  } catch (e) {
    qbLookupError = String((e as Error)?.message ?? e).slice(0, 200);
  }
}
if (submission.qbo_pushed_by) {
  const { data: who } = await admin.from('staff').select('full_name').eq('id', submission.qbo_pushed_by).maybeSingle();
  pushedBy = who?.full_name ?? null;
}
const qbReport = submission.qbo_push_report as null | {
  vendor_id: string; vendor_name: string; created: boolean; supplier: string;
  fields: Record<string, string>; errors: Record<string, string>;
};
const fmtAddr = (a: { Line1: string; City: string; CountrySubDivisionCode: string; PostalCode: string } | null) =>
  a ? [a.Line1, [a.City, a.CountrySubDivisionCode, a.PostalCode].filter(Boolean).join(' ')].filter(Boolean).join(', ') : null;

const url = new URL(Astro.request.url);
const info = url.searchParams.get('info');
const errCode = url.searchParams.get('error');
const canEdit = !!Astro.locals.access?.perms?.has('vq');
const infoMessages: Record<string, string> = { staff_saved: T('info.staff_saved'), staff_submitted: T('info.staff_submitted'), approved: T('info.approved'), feedback: T('info.feedback'), rejected: T('info.rejected'), qb_created: T('qb.ok.created'), qb_linked: T('qb.ok.linked'), qb_completed: T('qb.ok.completed') };
const errorMessages: Record<string, string> = {
  not_approver: T('error.not_approver'),
  note_required: T('error.note_required'),
  unknown: T('error.unknown'),
};

const vendorTypeLabels: Record<string, string> = {
  cannabis_grower: Tv('vendorType.cannabis_grower'), cannabis_extractor: Tv('vendorType.cannabis_extractor'),
  test_laboratory: Tv('vendorType.test_laboratory'), distributor: Tv('vendorType.distributor'),
};
const productionTypeLabels: Record<string, string> = {
  indoor: Tv('option.indoor'), outdoor: Tv('option.outdoor'),
  greenhouse: Tv('option.greenhouse'), hybrid: Tv('option.hybrid'),
};
const cultivationMethodLabels: Record<string, string> = {
  sog: Tv('option.sog'), hydroponic: Tv('option.hydroponic'), aquaponic: Tv('option.aquaponic'),
  aeroponic: Tv('option.aeroponic'), regenerative: Tv('option.regenerative'),
};
const startingMaterialLabels: Record<string, string> = {
  clone: Tv('option.clone'), seed: Tv('option.seed'), tissue_culture: Tv('option.tissueCulture'),
};

function fmtDate(iso: string | null): string {
  if (!iso) return '—';
  return new Date(iso).toLocaleDateString(locale === 'en' ? 'en-CA' : 'fr-CA', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
}
function joinLabels(codes: string[] | null, map: Record<string, string>): string {
  if (!codes || codes.length === 0) return '—';
  return codes.map((c) => map[c] ?? c).join(', ');
}
function fmtPlainDate(dateStr: string | null): string {
  if (!dateStr) return '—';
  return new Date(`${dateStr}T00:00:00Z`).toLocaleDateString(locale === 'en' ? 'en-CA' : 'fr-CA', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
function expiryBadge(dateStr: string | null): { text: string; className: string } | null {
  if (!dateStr) return null;
  const days = Math.round((new Date(`${dateStr}T00:00:00Z`).getTime() - Date.now()) / 86_400_000);
  const formatted = fmtPlainDate(dateStr);
  if (days < 0) return { text: T('doc.expired').replace('{date}', formatted), className: 'badge-cancelled' };
  if (days <= 60) return { text: T('doc.expirySoon').replace('{date}', formatted), className: 'badge-signing' };
  return { text: T('doc.expiry').replace('{date}', formatted), className: 'badge-draft' };
}
const craExpiry = expiryBadge(submission.file_cra_license_expiry);
const hcExpiry = expiryBadge(submission.file_health_canada_license_expiry);

// Contacts as labelled rows, the same way the company address is laid out,
// rather than one dash-joined line per person.
const contacts = [
  {
    title: T('label.salesContact'),
    name: submission.sales_contact_name, email: submission.sales_contact_email,
    phone: submission.sales_contact_phone, ext: submission.sales_contact_phone_ext,
  },
  {
    title: T('label.qaContact'),
    name: submission.qa_contact_name, email: submission.qa_contact_email,
    phone: submission.qa_contact_phone, ext: submission.qa_contact_phone_ext,
  },
  {
    title: T('label.accountingContact'),
    name: submission.accounting_contact_name, email: submission.accounting_contact_email,
    phone: submission.accounting_contact_phone, ext: submission.accounting_contact_phone_ext,
  },
];

// A comma in a tel: link makes the phone pause after connecting and then dial
// the extension, so tapping the number on a phone reaches the right desk.
function telHref(phone: string, ext?: string | null): string {
  const digits = phone.replace(/[^\d+]/g, '');
  return ext ? `tel:${digits},${String(ext).replace(/\D/g, '')}` : `tel:${digits}`;
}
---
<PortailLayout title={submission.company_name} staffName={staff.full_name} wide>
  <div style="margin-bottom: 20px;">
    <a href="/portail/fournisseurs" style="font-size: .9rem; color: var(--p-muted); text-decoration: none;">{T('backLink')}</a>
  </div>

  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:16px;">
    <div>
      <h1 style="margin-bottom: 4px;">{submission.company_name}</h1>
      <p style="color: var(--p-muted);">{T('submittedOn')} {fmtDate(submission.submitted_at)}</p>
    </div>
    {canEdit && <a href={`/portail/fournisseurs/${id}/modifier`} class="btn btn-secondary" style="margin-left:auto;">{T('staff.editBtn')}</a>}
    {fileState === 'approved' && <span class="badge badge-complete">{T('fullyApprovedBanner')}</span>}
    {fileState === 'rejected' && <span class="badge badge-cancelled">{T('state.rejected')}</span>}
    {fileState === 'feedback' && <span class="badge badge-signing">{T('state.feedback')}</span>}
  </div>

  {info && infoMessages[info] && <div class="flash flash-success">{infoMessages[info]}</div>}
  {url.searchParams.get('notified') === '1' && <div class="flash flash-success">{T('info.notified')}</div>}
  {url.searchParams.get('notified') === '0' && <div class="flash flash-error">{T('error.notify_failed')}</div>}
  {errCode === 'qb' && <div class="flash flash-error">{T('qb.err').replace('{msg}', url.searchParams.get('msg') ?? '')}</div>}
  {errCode === 'qb_forbidden' && <div class="flash flash-error">{T('qb.err.forbidden')}</div>}
  {errCode && !errCode.startsWith('qb') && <div class="flash flash-error">{errorMessages[errCode] ?? errorMessages.unknown}</div>}

  {isDraft && (
    <div class="card" style="margin-bottom: 20px;">
      {T('notYetSubmitted')}
      {canEdit && <div style="margin-top: 12px;"><a href={`/portail/fournisseurs/${id}/modifier`} class="btn btn-primary">{T('staff.editBtn')}</a></div>}
    </div>
  )}

  {!isDraft && <>
  <div class="card" id="approbations" style="margin-bottom: 20px;">
    <h2>{T('section.approvals')}</h2>
    <p class="hint" style="margin: 4px 0 14px;">{T('approvals.intro')}</p>
    {(rejected.length > 0 || onHold.length > 0) && (
      <div class={rejected.length ? 'flash flash-error' : 'warn-banner'}>
        {[...rejected, ...onHold].map((a) => (
          <div><strong>{a.staff?.full_name ?? '—'}</strong> — {T(`decision.${a.decision}` as keyof typeof frFournisseursDetail)} : {a.decision_note}</div>
        ))}
      </div>
    )}
    <table class="data">
      <thead>
        <tr><th>{T('th.approver')}</th><th>{T('th.status')}</th><th>{T('th.decidedOn')}</th><th></th></tr>
      </thead>
      <tbody>
        {approvals.map((a) => (
          <tr>
            <td>{a.staff?.full_name ?? '—'}</td>
            <td>
              <span class={`badge ${a.decision ? decisionBadge[a.decision] : 'badge-sent'}`}>
                {a.decision ? T(`decision.${a.decision}` as keyof typeof frFournisseursDetail) : T('pendingPill')}
              </span>
              {a.decision_note && <div class="decision-note">{a.decision_note}</div>}
            </td>
            <td>{a.decided_at ? fmtDate(a.decided_at) : '—'}</td>
            <td style="text-align: right;">
              {a.staff_id === staff.id && (
                <details class="decide" open={!a.decision}>
                  <summary>{a.decision ? T('decide.change') : T('decide.title')}</summary>
                  <form method="POST" action={`/api/portail/vendor-submissions/${id}/approve`} class="decide-form">
                    <textarea name="note" rows="2" placeholder={T('decide.notePlaceholder')} aria-label={T('decide.note')}>{a.decision !== 'approved' ? a.decision_note ?? '' : ''}</textarea>
                    <label class="notify"><input type="checkbox" name="notify" value="1" checked /> {T('decide.notify')}</label>
                    <div class="decide-btns">
                      <button type="submit" name="decision" value="approved" class="btn btn-primary">{T('approveBtn')}</button>
                      <button type="submit" name="decision" value="feedback" class="btn btn-secondary" data-needs-note>{T('decide.feedback')}</button>
                      <button type="submit" name="decision" value="rejected" class="btn btn-danger" data-needs-note>{T('decide.reject')}</button>
                    </div>
                    <p class="hint">{T('decide.hint')}</p>
                  </form>
                </details>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    {history.length > 0 && (
      <details class="vq-history">
        <summary>{T('history.title')} ({history.length})</summary>
        <ol>
          {history.map((h) => (
            <li>
              <span class={`badge ${decisionBadge[h.decision]}`}>{T(`decision.${h.decision}` as keyof typeof frFournisseursDetail)}</span>
              <strong>{h.staff?.full_name ?? (h.decision === 'resubmitted' ? submission.company_name : '—')}</strong> <span class="hint">{fmtDate(h.at)}</span>
              {h.note && <div class="decision-note">{h.note}</div>}
              {h.supplier_notified_to?.length ? <div class="decision-note">{T('history.notified').replace('{list}', h.supplier_notified_to.join(', '))}</div> : null}
            </li>
          ))}
        </ol>
      </details>
    )}
  </div>

  {showQb && (
    <div class="card qb-card" id="quickbooks" style="margin-bottom: 20px;">
      <h2>{T('qb.title')}</h2>
      {submission.qbo_vendor_id ? (
        <>
          <p class="qb-done">{T('qb.done').replace('{name}', submission.qbo_vendor_name ?? '').replace('{id}', submission.qbo_vendor_id)}</p>
          {submission.qbo_pushed_at && <p class="hint">{T('qb.doneBy').replace('{date}', fmtDate(submission.qbo_pushed_at)).replace('{name}', pushedBy ?? '—')}</p>}
          {submission.ap_supplier_id && (
            <p style="margin-top: 8px;">{T('qb.supplier')} : <a href={`/portail/paiements/fournisseurs/${submission.ap_supplier_id}`}>{submission.qbo_vendor_name}</a>
              {qbReport && <span class="hint"> ({T(`qb.supplier.${qbReport.supplier}` as keyof typeof frFournisseursDetail)})</span>}</p>
          )}
          {qbReport?.created && (
            <>
              <h3 class="qb-h">{T('qb.fields')}</h3>
              <table class="data qb-table"><tbody>
                {(['emails', 'shipping', 'business_number', 'bank'] as const).map((k) => (
                  <tr>
                    <th>{T(`qb.field.${k}` as keyof typeof frFournisseursDetail)}</th>
                    <td><span class={`qb-st qb-${qbReport.fields[k]}`}>{T(`qb.state.${qbReport.fields[k] ?? 'skipped'}` as keyof typeof frFournisseursDetail)}</span>
                      {qbReport.errors?.[k] && <div class="hint">{qbReport.errors[k]}</div>}</td>
                  </tr>
                ))}
              </tbody></table>
              {Object.values(qbReport.fields).some((v) => v === 'refused' || v === 'dropped') && <p class="hint" style="margin-top: 8px;">{T('qb.manual')}</p>}
            </>
          )}
          {(qbReport?.fields?.business_number !== 'kept' || qbReport?.fields?.bank !== 'kept') && (cleanBn(submission as VendorSubmission) || bankAcctNum(submission as VendorSubmission)) && (
            <form method="POST" action={`/api/portail/vendor-submissions/${id}/qbo`} class="qb-complete">
              <input type="hidden" name="_action" value="complete" />
              <h3 class="qb-h">{T('qb.complete.title')}</h3>
              <p class="hint" style="margin-bottom: 8px;">{T('qb.complete.hint')}</p>
              <div class="qb-grid">
                <div class="form-row"><label for="qc-bank">{T('qb.f.bank')}</label>
                  <input type="text" id="qc-bank" name="bank_acct" value={bankAcctNum(submission as VendorSubmission) ?? ''} maxlength="100" /></div>
                <div class="form-row"><label for="qc-bn">{T('qb.f.bn')}</label>
                  <input type="text" id="qc-bn" name="business_number" value={cleanBn(submission as VendorSubmission) ?? ''} maxlength="30" /></div>
              </div>
              <button type="submit" class="btn btn-primary">{T('qb.complete.btn')}</button>
            </form>
          )}
        </>
      ) : !qbConnected ? (
        <p class="hint">{qbLookupError ? T('qb.err').replace('{msg}', qbLookupError) : T('qb.notConnected')}</p>
      ) : (
        <>
          <p class="hint" style="margin: -4px 0 12px;">{T('qb.intro')}</p>
          {fileState === 'rejected' && <div class="flash flash-error">{T('qb.rejected')}</div>}
          {fileState !== 'rejected' && !fullyApproved && <div class="warn-banner">{T('qb.pending').replace('{n}', String(approvedCount)).replace('{total}', String(approvals.length))}</div>}

          <h3 class="qb-h">{T('qb.similar')}</h3>
          {similar.length === 0 ? <p class="hint">{T('qb.similar.none')}</p> : (
            <>
              <p class="hint" style="margin-bottom: 8px;">{T('qb.similar.hint')}</p>
              <table class="data qb-table"><tbody>
                {similar.map((v) => (
                  <tr>
                    <td><strong>{v.name}</strong>{v.company && v.company !== v.name && <span class="hint"> · {v.company}</span>} <span class="hint">#{v.id}</span></td>
                    <td style="text-align: right;">
                      <form method="POST" action={`/api/portail/vendor-submissions/${id}/qbo`} style="margin: 0;">
                        <input type="hidden" name="_action" value="link" />
                        <input type="hidden" name="vendor_id" value={v.id} />
                        <button type="submit" class="btn btn-secondary" style="font-size: .82rem; padding: 6px 14px;">{T('qb.link')}</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody></table>
            </>
          )}

          <h3 class="qb-h">{T('qb.preview')}</h3>
          <form method="POST" action={`/api/portail/vendor-submissions/${id}/qbo`} class="qb-create" data-confirm={T('qb.create.confirm')}>
            <input type="hidden" name="_action" value="create" />
            <div class="form-row">
              <label for="qb-name">{T('qb.f.displayName')}</label>
              <input type="text" id="qb-name" name="display_name" value={preview.displayName} maxlength="100" required />
              <p class="hint">{T('qb.f.displayName.hint')}</p>
            </div>
            <p class="hint" style="margin: -4px 0 10px;">{T('qb.editHint')}</p>
            <div class="qb-grid">
              <div class="form-row"><label for="qb-company">{T('qb.f.company')}</label>
                <input type="text" id="qb-company" name="company_name" value={preview.companyName} maxlength="100" /></div>
              <div class="form-row"><label for="qb-phone">{T('qb.f.phone')}</label>
                <input type="text" id="qb-phone" name="phone" value={preview.phone ?? ''} maxlength="30" /></div>
              <div class="form-row wide"><label for="qb-emails">{T('qb.f.emails')}</label>
                <input type="text" id="qb-emails" name="emails" value={preview.emails.join(', ')} />
                <p class="hint">{T('qb.f.emails.hint')}</p></div>
              <div class="form-row"><label for="qb-bn">{T('qb.f.bn')}</label>
                <input type="text" id="qb-bn" name="business_number" value={preview.businessNumber ?? ''} maxlength="30" />
                {!preview.businessNumber && submission.business_number && <p class="qb-fixed">{T('qb.bnIgnored').replace('{typed}', submission.business_number)}</p>}</div>
            </div>

            {(['bill', 'ship'] as const).map((k) => {
              const a = k === 'bill' ? preview.billing : preview.shipping;
              const src = k === 'bill' || !a ? preview.billing : a;
              return (
                <fieldset class="qb-addr" data-addr={k}>
                  <legend>{k === 'bill' ? T('qb.f.billing') : T('qb.f.shipping')}</legend>
                  {k === 'ship' && (
                    <label class="qb-same"><input type="checkbox" name="ship_same" value="1" checked={!preview.shipping} /> {T('qb.f.shipping.same')}</label>
                  )}
                  <div class="qb-grid addr-fields" hidden={k === 'ship' && !preview.shipping}>
                    <div class="form-row wide"><label>{T('qb.f.street')}</label><input type="text" name={`${k}_line`} value={(k === 'ship' ? a?.Line1 : src?.Line1) ?? ''} /></div>
                    <div class="form-row"><label>{T('qb.f.city')}</label><input type="text" name={`${k}_city`} value={(k === 'ship' ? a?.City : src?.City) ?? ''} /></div>
                    <div class="form-row"><label>{T('qb.f.prov')}</label><input type="text" name={`${k}_prov`} value={(k === 'ship' ? a?.CountrySubDivisionCode : src?.CountrySubDivisionCode) ?? ''} maxlength="30" /></div>
                    <div class="form-row"><label>{T('qb.f.postal')}</label><input type="text" name={`${k}_postal`} value={(k === 'ship' ? a?.PostalCode : src?.PostalCode) ?? ''} maxlength="30" /></div>
                  </div>
                  {a?.typed && <p class="qb-fixed">{T('qb.addrFixed').replace('{typed}', a.typed)}</p>}
                </fieldset>
              );
            })}

            <div class="form-row"><label for="qb-bank">{T('qb.f.bank')}</label>
              <input type="text" id="qb-bank" name="bank_acct" value={preview.bankAcct ?? ''} maxlength="100" />
              <p class="hint">{T('qb.f.bank.hint')}</p></div>
            <button type="submit" class="btn btn-primary" style="margin-top: 12px;" disabled={fileState === 'rejected'}>{T('qb.create')}</button>
          </form>
        </>
      )}
    </div>
  )}

  <div class="card" style="margin-bottom: 20px;">
    <h2>{T('section.contacts')}</h2>
    <table class="data" style="margin-top: 12px;">
      <tbody>
        {contacts.map((c, i) => (
          <>
            <tr class="contact-group"><th colspan="2" style={i === 0 ? 'width:260px;' : undefined}>{c.title}</th></tr>
            <tr><th style="width:260px;">{T('field.fullName')}</th><td>{c.name || '—'}</td></tr>
            <tr>
              <th>{T('field.email')}</th>
              <td>{c.email ? <a href={`mailto:${c.email}`}>{c.email}</a> : '—'}</td>
            </tr>
            <tr>
              <th>{T('field.phone')}</th>
              <td>
                {c.phone ? (
                  <a href={telHref(c.phone, c.ext)}>{c.phone}</a>
                ) : '—'}
                {c.phone && c.ext && <span class="ext"> · {T('field.ext')} {c.ext}</span>}
              </td>
            </tr>
          </>
        ))}
      </tbody>
    </table>
  </div>

