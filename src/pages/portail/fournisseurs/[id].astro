        </tr>
        <tr>
          <th>{T('doc.hc')}</th>
          <td><div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            {submission.file_health_canada_license_path ? (
              <a href={`/api/portail/vendor-submissions/${id}/files/hc`} class="btn btn-secondary" style="font-size:.82rem;padding:5px 12px;">{T('downloadBtn')}</a>
            ) : T('notProvided')}
