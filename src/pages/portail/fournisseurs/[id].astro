        <tr><th></th><td>{submission.certified ? `✓ ${T('certifiedYes')}` : '—'}</td></tr>
      </tbody>
    </table>
  </div>
  </>}
</PortailLayout>

<style>
  .qb-h { font-size: .92rem; font-weight: 600; margin: 16px 0 8px; }
  .decision-note { font-size: .82rem; color: var(--p-muted); margin-top: 4px; white-space: pre-line; max-width: 46ch; }
  .decide { text-align: left; display: inline-block; min-width: 320px; }
  .decide summary { justify-content: flex-end; }
  .decide-form { margin-top: 8px; }
  .decide-form textarea { font-size: .86rem; }
  .notify { display: flex; align-items: center; gap: 6px; font-weight: 400; font-size: .82rem; margin: 6px 0 0; justify-content: flex-end; }
  .decide-btns { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; justify-content: flex-end; }
  .decide-btns .btn { font-size: .82rem; padding: 6px 12px; }
  .vq-history { margin-top: 14px; }
  .vq-history ol { list-style: none; margin-top: 8px; display: flex; flex-direction: column; gap: 8px; }
  .vq-history li { font-size: .88rem; display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
  .vq-history li .decision-note { flex-basis: 100%; }
  .qb-table th { width: 260px; }
  .qb-table th, .qb-table td { padding: 8px 12px; }
  .qb-done { font-weight: 600; color: var(--p-success); }
  .qb-fixed { font-size: .8rem; color: var(--p-warn); margin-top: 4px; }
  .qb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0 16px; }
  .qb-grid .wide { grid-column: 1 / -1; }
  .qb-addr { border: 1px solid var(--p-border); border-radius: 8px; padding: 12px 14px 4px; margin-bottom: 14px; }
  .qb-addr legend { font-weight: 600; font-size: .88rem; padding: 0 6px; }
  .qb-same { display: flex; align-items: center; gap: 8px; font-weight: 400; margin-bottom: 10px; }
  .qb-st { font-size: .8rem; font-weight: 600; padding: 2px 8px; border-radius: 999px; }
  .qb-kept { background: #dcfce7; color: #166534; }
  .qb-refused, .qb-dropped { background: #fef3c7; color: #92400e; }
  .qb-skipped { background: #f3f4f6; color: #6b7280; }
</style>

<script>
  // Awaiting feedback and reject need a reason; approving does not.
  document.querySelectorAll<HTMLFormElement>('form.decide-form').forEach((f) => {
    f.addEventListener('submit', (e) => {
      const btn = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      const note = f.querySelector<HTMLTextAreaElement>('textarea[name="note"]')!;
      if (btn?.hasAttribute('data-needs-note') && !note.value.trim()) {
        e.preventDefault();
        note.focus();
        note.setCustomValidity(note.placeholder);
        note.reportValidity();
        note.addEventListener('input', () => note.setCustomValidity(''), { once: true });
      }
    });
  });
  // Shipping fields only when the shipping address differs from billing.
  const same = document.querySelector<HTMLInputElement>('form.qb-create [name="ship_same"]');
  same?.addEventListener('change', () => {
    const box = same.closest('fieldset')!.querySelector<HTMLElement>('.addr-fields')!;
    box.hidden = same.checked;
    if (!same.checked) {
      for (const f of ['line', 'city', 'prov', 'postal']) {
        const ship = box.querySelector<HTMLInputElement>(`[name="ship_${f}"]`)!;
        if (!ship.value) ship.value = (document.querySelector<HTMLInputElement>(`form.qb-create [name="bill_${f}"]`)?.value ?? '');
      }
    }
  });
  document.querySelector<HTMLFormElement>('form.qb-create')?.addEventListener('submit', (e) => {
    const f = e.currentTarget as HTMLFormElement;
    const name = (f.querySelector('[name="display_name"]') as HTMLInputElement).value;
    if (!confirm((f.dataset.confirm ?? '').replace('{name}', name))) { e.preventDefault(); return; }
    (f.querySelector('button[type="submit"]') as HTMLButtonElement).disabled = true;
  });
</script>

