        <tr><th>{T('field.companyName')}</th><td>{submission.company_name}</td></tr>
        <tr><th>{T('field.address')}</th><td>{submission.address}</td></tr>
        <tr><th>{T('field.cityProvincePostal')}</th><td>{submission.city} / {submission.province} / {submission.postal_code}</td></tr>
        <tr><th>{T('field.contactPerson')}</th><td>{submission.contact_person}</td></tr>
        <tr>
