        <tr><th>{T('field.bankTransit')}</th><td>{submission.bank_transit_number || '—'}</td></tr>
        <tr><th>{T('field.bankAccount')}</th><td>{submission.bank_account_number || '—'}</td></tr>
        <tr><th>{T('field.bankAddress')}</th><td>{submission.bank_address || '—'}</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="margin-bottom: 20px;">
    <h2>{T('section.documents')}</h2>
    <table class="data" style="margin-top: 12px;">
      <tbody>
        <tr>
          <th style="width:260px;">{T('doc.cra')}</th>
          <td><div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            {submission.file_cra_license_path ? (
              <a href={`/api/portail/vendor-submissions/${id}/files/cra`} class="btn btn-secondary" style="font-size:.82rem;padding:5px 12px;">{T('downloadBtn')}</a>
            ) : T('notProvided')}
            {craExpiry && <span class={`badge ${craExpiry.className}`}>{craExpiry.text}</span>}
