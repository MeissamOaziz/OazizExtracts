  <div class="card" style="margin-bottom: 20px;">
    <h2>{T('section.tax')}</h2>
    <table class="data" style="margin-top: 12px;">
      <tbody>
        <tr><th style="width:260px;">{T('field.businessNumber')}</th><td>{submission.business_number || '—'}</td></tr>
        <tr><th>{T('field.gstHst')}</th><td>{submission.gst_hst_number || '—'}</td></tr>
        <tr><th>{T('field.qst')}</th><td>{submission.qst_number || '—'}</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="margin-bottom: 20px;">
    <h2>{T('section.banking')}</h2>
    <p class="hint" style="color: var(--p-danger); margin: 4px 0 12px;">{T('bankingWarning')}</p>
