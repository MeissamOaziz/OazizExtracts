---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { t } from '../../i18n/ui';

const lang = 'en';
const T = t(lang);

const teamTop = [
  { name: 'Jorge Sousa',         role: T('about.role.ceo') },
  { name: 'Stephane Paquin',     role: T('about.role.paq') },
  { name: 'Simon Salomone',      role: T('about.role.extractor') },
];
const teamBottom = [
  { name: 'Kyle St-Hilaire',     role: T('about.role.sales') },
  { name: 'Meissam Hagh Panah',  role: T('about.role.cfo') },
];
---

<Layout title={T('about.meta.title')} description={T('about.meta.desc')} lang={lang} path="/en/about">
  <div class="page-container with-padding">
    <h1 class="page-header">{T('about.title')}</h1>
  </div>

  <section class="content-section white-bg">
    <div class="page-container">
      <h2>{T('about.spirit.title')}</h2>
      <p>{T('about.spirit.p1')}</p>
      <p>{T('about.spirit.p2')}</p>
    </div>
  </section>

  <section class="content-section dark-bg">
    <div class="page-container">
      <h2 class="title-light">{T('about.team.title')}</h2>
      <p class="text-light">{T('about.team.intro')}</p>
      <div class="team-grid team-grid-top">
        {teamTop.map((m) => (
          <div class="team-member"><h3>{m.name}</h3><p>{m.role}</p></div>
        ))}
      </div>
      <div class="team-grid team-grid-bottom">
        {teamBottom.map((m) => (
          <div class="team-member"><h3>{m.name}</h3><p>{m.role}</p></div>
        ))}
      </div>
    </div>
  </section>

  <ContactSection lang={lang} context="About page" />
</Layout>
