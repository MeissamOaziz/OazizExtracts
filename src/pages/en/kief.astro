---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { t } from '../../i18n/ui';

const lang = 'en';
const T = t(lang);

const dry = [
  { src: '/images/Dry-Tumbled-Kief-2.webp', alt: 'Dry Tumbled Kief' },
  { src: '/images/Dry-Tumbled-Kief.webp',   alt: 'Tumbled Kief' },
];
const iwe = [
  { src: '/images/IWE-Kief-2.webp',             alt: 'Ice Water Extract Kief 1' },
  { src: '/images/IWE-Kief.webp',               alt: 'Ice Water Extract Kief 2' },
  { src: '/images/Ice-Water-Extract-Kief.webp', alt: 'Ice Water Extract Kief 3' },
];
---

<Layout title={T('kief.meta.title')} description={T('kief.meta.desc')} lang={lang} path="/en/kief">
  <div class="page-container with-padding">
    <h1 class="page-header">{T('kief.h1')}</h1>
    <p class="product-description">{T('kief.desc')}</p>

    <div class="product-subsection-container">
      <div class="product-subsection">
        <h2>{T('kief.sub.dry')}</h2>
        <div class="product-gallery">
          {dry.map((p) => (
            <div class="gallery-item"><img src={p.src} alt={p.alt} loading="lazy" width="600" height="600" /></div>
          ))}
        </div>
      </div>

      <div class="product-subsection">
        <h2>{T('kief.sub.iwe')}</h2>
        <div class="product-gallery">
          {iwe.map((p) => (
            <div class="gallery-item"><img src={p.src} alt={p.alt} loading="lazy" width="600" height="600" /></div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <ContactSection lang={lang} context={T('kief.ctx')} defaultSubject="sales" />
</Layout>
