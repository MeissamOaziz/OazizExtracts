---
import Layout from '../../../layouts/Layout.astro';
import { t, localizeUrl } from '../../../i18n/ui';

const lang = 'en';
const T = t(lang);

const brands = [
  { slug: 'cannonfire', logo: '/images/Cannonfire-Logo.png', alt: 'CannonFire Logo', name: 'CannonFire', tagKey: 'brands.tag.cannonfire' },
  { slug: 'curado',     logo: '/images/Curado-Logo.png',     alt: 'Curado Logo',     name: 'CURADO',     tagKey: 'brands.tag.curado' },
  { slug: 'canolio',    logo: '/images/Canolio-Logo.png',    alt: 'Canolio Logo',    name: 'CANOLIO',    tagKey: 'brands.tag.canolio' },
  { slug: 'xaman',      logo: '/images/Xaman-logo.jpg',      alt: 'Xaman Logo',      name: 'Xaman',      tagKey: 'brands.tag.xaman' },
  { slug: 'hashtisan',  logo: '/images/Hashtisan-Logo.png',  alt: 'Hashtisan Logo',  name: 'Hashtisan',  tagKey: 'brands.tag.hashtisan' },
  { slug: 'hazo',       logo: '/images/Hazo-logo.png',       alt: 'Hazo Logo',       name: 'Hazo',       tagKey: 'brands.tag.hazo' },
];
---

<Layout
  title={T('brands.meta.title')}
  description={T('brands.meta.desc')}
  lang={lang}
  path="/en/brands"
  bodyClass="brands-page-background"
>
  <main class="page-container">
    <h1 class="sr-only">{T('brands.title')}</h1>
    <div class="brands-grid">
      {brands.map((b) => (
        <a href={localizeUrl(`/brands/${b.slug}`, lang)} class="brand-card">
          <div class="brand-logo-wrapper">
            <img src={b.logo} alt={b.alt} loading="lazy" />
          </div>
          <div class="brand-info">
            <h3>{b.name}</h3>
            {T(b.tagKey) && <p>{T(b.tagKey)}</p>}
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
