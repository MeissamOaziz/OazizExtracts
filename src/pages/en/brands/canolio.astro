---
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/ui';

const lang = 'en';
const T = t(lang);

const medical = [
  { src: '/images/CanolioBCP.png',           alt: 'Canolio 3 Blue Kings',          labelKey: 'canolio.med.3bk' },
  { src: '/images/CanolioBCPpackaging.webp', alt: 'Canolio Black Cherry Punch',    labelKey: 'canolio.med.bcp' },
  { src: '/images/CanolioBCP.png',           alt: 'Canolio Sapphire Scout',        labelKey: 'canolio.med.sapphire' },
];

const retailers = [
  { href: 'https://mendomedical.ca',     src: '/images/Mendo-Medical-Cannabis-Logo.webp', alt: 'Mendo Medical Cannabis' },
  { href: 'https://teedy.com',           src: '/images/Teedy.png',                        alt: 'Teedy' },
  { href: 'https://herbaldispatch.com/', src: '/images/HerbalDispatch.webp',              alt: 'Herbal Dispatch' },
  { href: 'https://flodega.com',         src: '/images/Flodega.png',                      alt: 'Flodega' },
];
---

<Layout title={T('canolio.meta.title')} description={T('canolio.meta.desc')} lang={lang} path="/en/brands/canolio" ogImage="/images/Canolio-Logo.png">
  <section class="brand-hero white-bg-hero">
    <img src="/images/Canolio-Logo.png" alt="CANOLIO Logo" class="brand-hero-logo" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">CANOLIO</h1>
    <p>
      {T('canolio.intro.before')}
      <a href="https://canoliogourmet.ca/" target="_blank" rel="noopener">{T('canolio.intro.partner')}</a>{T('canolio.intro.after')}
    </p>
  </section>

  <section class="product-showcase-medical white-bg-products">
    <div class="page-container with-padding">
      <h2 class="section-title-dark">{T('brands.medical.title')}</h2>
      <div class="medical-retailers-bar">
        {retailers.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="med-retailer-link">
            <img src={r.src} alt={r.alt} loading="lazy" />
          </a>
        ))}
      </div>
      <div class="medical-product-gallery">
        {medical.map((m) => (
          <div class="med-card">
            <div class="med-image-wrapper"><img src={m.src} alt={m.alt} loading="lazy" /></div>
            <p>{T(m.labelKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
