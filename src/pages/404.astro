---
import Layout from '../layouts/Layout.astro';
import { t, localizeUrl } from '../i18n/ui';

const lang = 'fr';
const T = t(lang);
---

<Layout title={T('404.title')} description={T('404.desc')} lang={lang} path="/404">
  <section style="padding: 120px 20px; text-align: center; min-height: 60vh;">
    <h1 class="page-header">{T('404.heading')}</h1>
    <p style="font-size: 1.25rem; max-width: 600px; margin: 24px auto;">{T('404.body')}</p>
    <p style="margin-top: 32px;">
      <a href={localizeUrl('/', lang)} class="contact-float-btn cta-light">{T('404.back')}</a>
    </p>
  </section>
</Layout>
