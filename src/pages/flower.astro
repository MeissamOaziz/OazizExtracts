---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';

const lang = 'fr';
---

<Layout
  title='Fleur — Oaziz Extracts'
  description='Fleur de cannabis GMP, disponible pour producteurs et exportateurs. Demandez vos volumes, délais et spécifications.'
  lang={lang}
  path="/flower"
>
  <ContactSection
    lang={lang}
    title="Demande d'Information — Fleur"
    showLeadIn
    context="Flower inquiry"
    defaultSubject="sales"
    fullHeight
  />
</Layout>
