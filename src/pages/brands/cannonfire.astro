---
import Layout from '../../layouts/Layout.astro';
import { t, localizeUrl } from '../../i18n/ui';

const lang = 'en';
const T = t(lang);

const medical = [
  { src: '/images/CannonfireBCP.webp',              alt: 'Black Cherry Punch Vape',  labelKey: 'cf.med.bcp' },
  { src: '/images/Cannonfire3bk1.webp',             alt: '3 Blue Kings Rosin Vape',  labelKey: 'cf.med.3bk' },
  { src: '/images/CannonfireMandarinCookies1.webp', alt: 'Mandarin Cookies Vape',    labelKey: 'cf.med.mc' },
  { src: '/images/CannonfireFlawless.webp',         alt: 'Flawless Victory Vape',    labelKey: 'cf.med.fl' },
  { src: '/images/SAPPHIRE_SCOUTVAPE.jpg',          alt: 'Sapphire Scout Vape',      labelKey: 'cf.med.sapphire' },
];

const retailers = [
  { href: 'https://mendomedical.ca',     src: '/images/Mendo-Medical-Cannabis-Logo.webp', alt: 'Mendo Medical Cannabis' },
  { href: 'https://teedy.com',           src: '/images/Teedy.png',                        alt: 'Teedy' },
  { href: 'https://herbaldispatch.com/', src: '/images/HerbalDispatch.webp',              alt: 'Herbal Dispatch' },
  { href: 'https://flodega.com',         src: '/images/Flodega.png',                      alt: 'Flodega' },
];
---

<Layout title={T('cf.meta.title')} description={T('cf.meta.desc')} lang={lang} path="/brands/cannonfire" ogImage="/images/Cannonfire-Logo.png">
  <section class="brand-hero white-bg-hero">
    <img src="/images/Cannonfire-Logo.png" alt="CannonFire Logo" class="brand-hero-logo" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">CannonFire</h1>
    <p>{T('cf.intro')}</p>
  </section>

  <section class="product-showcase">
    <div class="product-showcase-grid single">
      <div class="product-grid-item portrait">
        <div class="product-image-container">
          <img src="/images/Aube-packaging-and-fullcart.jpg" alt="AUBE Vape Cartridge" loading="lazy" />
        </div>
        <div class="product-details dark-bg-details">
          <h3>{T('cf.aube.title')}</h3>
          <p>{T('cf.aube.blurb')}</p>
          <ul>
            <li>{T('cf.aube.b1')}</li>
            <li>{T('cf.aube.b2')}</li>
            <li>{T('cf.aube.b3')}</li>
          </ul>
          <div class="product-cta-group">
            <a href={localizeUrl('/brands/aube', lang)} class="contact-float-btn cta-light">{T('cf.aube.cta')}</a>
            <a href="https://www.sqdc.ca/en-CA/p-aube/628942710100-P/628942710100" target="_blank" rel="noopener" class="product-availability-badge">
              <span class="badge-text">{T('brands.availableAt')}</span>
              <img src="/images/SQDC-logo.png" alt="SQDC" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="product-showcase-medical white-bg-products">
    <div class="page-container with-padding">
      <h2 class="section-title-dark">{T('brands.medical.title')}</h2>
      <div class="medical-retailers-bar">
        {retailers.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="med-retailer-link">
            <img src={r.src} alt={r.alt} loading="lazy" />
          </a>
        ))}
      </div>
      <div class="medical-product-gallery">
        {medical.map((m) => (
          <div class="med-card">
            <div class="med-image-wrapper"><img src={m.src} alt={m.alt} loading="lazy" /></div>
            <p>{T(m.labelKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
