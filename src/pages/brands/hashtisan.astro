---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/ui';

const lang = 'en';
const T = t(lang);

const products = [
  { img: '/images/HashtisanGemBesidePackaing.webp', alt: 'Hashtisan GEM',          titleKey: 'ht.gem.title',     descKey: 'ht.gem.desc' },
  { img: '/images/Hashtisan-Hashgar.png',           alt: 'Hashtisan Hashgar',      titleKey: 'ht.hashgar.title', descKey: 'ht.hashgar.desc' },
  { img: '/images/minigar-1.webp',                  alt: 'Hashtisan Minigar',      titleKey: 'ht.minigar.title', descKey: 'ht.minigar.desc' },
  { img: '/images/HashtisanBonmatinfront.webp',     alt: 'Hashtisan Bon Matin',    titleKey: 'ht.bm.title',      descKey: 'ht.bm.desc' },
  { img: '/images/HashtisanImportHash.webp',        alt: 'Hashtisan Import Hash',  titleKey: 'ht.import.title',  descKey: 'ht.import.desc' },
];

const retailers = [
  { href: 'https://mendomedical.ca',     src: '/images/Mendo-Medical-Cannabis-Logo.webp', alt: 'Mendo Medical Cannabis' },
  { href: 'https://teedy.com',           src: '/images/Teedy.png',                        alt: 'Teedy' },
  { href: 'https://herbaldispatch.com/', src: '/images/HerbalDispatch.webp',              alt: 'Herbal Dispatch' },
  { href: 'https://flodega.com',         src: '/images/Flodega.png',                      alt: 'Flodega' },
];
---

<Layout title={T('ht.meta.title')} description={T('ht.meta.desc')} lang={lang} path="/brands/hashtisan" ogImage="/images/Hashtisan-Logo.png">
  <section class="brand-hero white-bg-hero">
    <img src="/images/Hashtisan-Logo.png" alt="HASHTISAN Logo" class="brand-hero-logo" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">HASHTISAN</h1>
    <p>{T('ht.intro')}</p>
  </section>

  <section class="product-showcase-medical white-bg-products">
    <div class="page-container with-padding">
      <h2 class="section-title-dark">{T('brands.medical.title')}</h2>
      <div class="medical-retailers-bar">
        {retailers.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="med-retailer-link">
            <img src={r.src} alt={r.alt} loading="lazy" />
          </a>
        ))}
      </div>
      <div class="medical-product-gallery">
        {products.map((p) => (
          <div class="med-card">
            <div class="med-image-wrapper"><img src={p.img} alt={p.alt} loading="lazy" /></div>
            <p><strong>{T(p.titleKey)}</strong>{T(p.descKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
