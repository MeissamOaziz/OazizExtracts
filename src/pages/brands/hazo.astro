---
import Layout from '../../layouts/Layout.astro';

const lang = 'fr';

const ocsProducts = [
  {
    img: '/images/HAZO-CBD-Vape-w_ packaging.png',
    alt: 'Hazo CBD Vape OCS',
    title: 'Hazo — CBD Vape',
    desc: 'Formule premium riche en CBD pour une expérience apaisante et équilibrée.',
  },
];

const medicalProducts = [
  {
    img: '/images/HAZOCBDvape1.png',
    alt: 'Hazo CBD Vape Medical',
    title: 'Hazo — CBD Vape',
    desc: 'Qualité médicale supérieure, idéal pour une utilisation quotidienne contrôlée.',
  },
  {
    img: '/images/Hazo-BB-muffin-3x.05g.png',
    alt: 'Hazo Blueberry Muffins',
    title: 'Blueberry Muffins',
    desc: 'Format pratique de 3 × 0,5g. Des prerolls artisanaux aux arômes de baies sucrées.',
  },
];

const medicalRetailers = [
  { href: 'https://mendomedical.ca',     src: '/images/Mendo-Medical-Cannabis-Logo.webp', alt: 'Mendo Medical Cannabis' },
  { href: 'https://teedy.com',           src: '/images/Teedy.png',                        alt: 'Teedy' },
  { href: 'https://herbaldispatch.com/', src: '/images/HerbalDispatch.webp',              alt: 'Herbal Dispatch' },
];
---

<Layout
  title='HAZO — Oaziz Extracts'
  description="HAZO — vapes CBD et prerolls fleur. Disponibles à l'OCS et sur les plateformes médicales canadiennes."
  lang={lang}
  path="/brands/hazo"
  ogImage='/images/Hazo-logo.png'
>
  <section class="brand-hero white-bg-hero">
    <img src="/images/Hazo-logo.png" alt="HAZO Logo" class="brand-hero-logo" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">HAZO</h1>
    <p>Une approche moderne du bien-être, offrant des produits de haute qualité conçus pour s'intégrer parfaitement à votre style de vie.</p>
  </section>

  <section class="product-showcase-medical white-bg-products">
    <div class="page-container with-padding">
      <h2 class="section-title-dark">Disponible sur OCS</h2>
      <div class="medical-retailers-bar">
        <a href="https://ocs.ca" target="_blank" rel="noopener" class="med-retailer-link">
          <img src="/images/OCS-logo.png" alt="OCS" style="max-width: 120px;" />
        </a>
      </div>
      <div class="medical-product-gallery">
        {ocsProducts.map((p) => (
          <div class="med-card">
            <div class="med-image-wrapper"><img src={p.img} alt={p.alt} loading="lazy" /></div>
            <p><strong>{p.title}</strong>{p.desc}</p>
          </div>
        ))}
      </div>

      <div style="margin-top: 80px;">
        <h2 class="section-title-dark">Disponible sur Plateformes Médicales</h2>
        <div class="medical-retailers-bar">
          {medicalRetailers.map((r) => (
            <a href={r.href} target="_blank" rel="noopener" class="med-retailer-link">
              <img src={r.src} alt={r.alt} loading="lazy" />
            </a>
          ))}
        </div>
        <div class="medical-product-gallery">
          {medicalProducts.map((p) => (
            <div class="med-card">
              <div class="med-image-wrapper"><img src={p.img} alt={p.alt} loading="lazy" /></div>
              <p><strong>{p.title}</strong>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
