---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import { t } from '../i18n/ui';

const lang = 'en';
const T = t(lang);
---

<Layout title={T('whitelabel.meta.title')} description={T('whitelabel.meta.desc')} lang={lang} path="/whitelabel">
  <div class="page-container with-padding" style="padding: 60px 20px;">
    <h1 class="page-header">{T('whitelabel.h1')}</h1>
    <p class="product-description" style="font-size: 1.1rem;">{T('whitelabel.desc')}</p>
  </div>
  <ContactSection lang={lang} context={T('whitelabel.ctx')} defaultSubject="sales" />
</Layout>
