---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { t } from '../../i18n/ui';

const lang = 'fr';
const T = t(lang);
---

<Layout title={T('trim.meta.title')} description={T('trim.meta.desc')} lang={lang} path="/fr/trim">
  <ContactSection
    lang={lang}
    title={T('trim.formTitle')}
    showLeadIn
    context={T('trim.ctx')}
    defaultSubject="sales"
    fullHeight
  />
</Layout>
