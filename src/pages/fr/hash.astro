---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { t } from '../../i18n/ui';

const lang = 'fr';
const T = t(lang);

const pressed = [
  { src: '/images/Afghan-Hash3.webp', alt: 'Afghan Hash' },
  { src: '/images/Afghan-Hash2.webp', alt: 'Afghan Pressed Hash' },
  { src: '/images/REPEAT.webp',       alt: 'Hash Block' },
];
const iwe = [
  { src: '/images/Curado-Purple-Octane-Hash.webp', alt: 'Curado Purple Octane Hash' },
  { src: '/images/Curado-Royal-Temple-Ball.webp',  alt: 'Royal Temple Ball' },
  { src: '/images/Piatella.webp',                  alt: 'Piatella Hash' },
  { src: '/images/Templeball.webp',                alt: 'Templeball Hash' },
];
---

<Layout title={T('hash.meta.title')} description={T('hash.meta.desc')} lang={lang} path="/fr/hash">
  <div class="page-container with-padding">
    <h1 class="page-header">{T('hash.h1')}</h1>
    <p class="product-description">{T('hash.desc')}</p>

    <div class="product-subsection-container">
      <div class="product-subsection">
        <h2>{T('hash.sub.pressed')}</h2>
        <div class="product-gallery">
          {pressed.map((p) => (
            <div class="gallery-item"><img src={p.src} alt={p.alt} loading="lazy" width="600" height="600" /></div>
          ))}
        </div>
      </div>

      <div class="product-subsection">
        <h2>{T('hash.sub.iwe')}</h2>
        <div class="product-gallery">
          {iwe.map((p) => (
            <div class="gallery-item"><img src={p.src} alt={p.alt} loading="lazy" width="600" height="600" /></div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <ContactSection lang={lang} context={T('hash.ctx')} defaultSubject="sales" />
</Layout>
