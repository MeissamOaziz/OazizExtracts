---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { t } from '../../i18n/ui';

const lang = 'fr';
const T = t(lang);

const items = [
  { src: '/images/Rosin-1.webp', alt: 'Rosin 1' },
  { src: '/images/Rosin-2.webp', alt: 'Rosin 2' },
  { src: '/images/Rosin-3.webp', alt: 'Rosin 3' },
  { src: '/images/Rosin-4.webp', alt: 'Rosin 4' },
  { src: '/images/Rosin-5.webp', alt: 'Rosin 5' },
];
---

<Layout title={T('rosin.meta.title')} description={T('rosin.meta.desc')} lang={lang} path="/fr/rosin">
  <div class="page-container with-padding">
    <h1 class="page-header">{T('rosin.h1')}</h1>
    <p class="product-description">{T('rosin.desc')}</p>
    <div class="product-gallery">
      {items.map((p) => (
        <div class="gallery-item"><img src={p.src} alt={p.alt} loading="lazy" width="600" height="600" /></div>
      ))}
    </div>
  </div>

  <ContactSection lang={lang} context={T('rosin.ctx')} defaultSubject="sales" />
</Layout>
