---
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { t } from '../../i18n/ui';

const lang = 'fr';
const T = t(lang);
---

<Layout title={T('export.meta.title')} description={T('export.meta.desc')} lang={lang} path="/fr/export">
  <ContactSection
    lang={lang}
    title={T('export.formTitle')}
    showLeadIn
    context={T('export.ctx')}
    defaultSubject="export"
    fullHeight
  />
</Layout>
