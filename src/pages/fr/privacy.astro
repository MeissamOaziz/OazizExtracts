---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../i18n/ui';

const lang = 'fr';
const T = t(lang);
const updated = '2026-05-25';
---

<Layout title={T('privacy.meta.title')} description={T('privacy.meta.desc')} lang={lang} path="/fr/privacy">
  <article class="content-section white-bg">
    <div class="page-container" style="max-width: 800px;">
      <h1 class="page-header">{T('privacy.title')}</h1>
      <p style="text-align: center; color: var(--dark-gray); margin-bottom: 40px;">
        {T('legal.updated')} {updated}
      </p>

      <h2 style="text-align: left;">{T('privacy.h.collect')}</h2>
      <p>{T('privacy.collect')}</p>

      <h2 style="text-align: left; margin-top: 30px;">{T('privacy.h.use')}</h2>
      <p>{T('privacy.use')}</p>

      <h2 style="text-align: left; margin-top: 30px;">{T('privacy.h.share')}</h2>
      <p>{T('privacy.share')}</p>

      <h2 style="text-align: left; margin-top: 30px;">{T('privacy.h.rights')}</h2>
      <p>
        {T('privacy.rights')}
        <a href="mailto:info@oaziz.ca">info@oaziz.ca</a>.
      </p>

      <h2 style="text-align: left; margin-top: 30px;">{T('privacy.h.retention')}</h2>
      <p>{T('privacy.retention')}</p>

      <h2 style="text-align: left; margin-top: 30px;">{T('privacy.h.contact')}</h2>
      <p>{T('privacy.contact')} <a href="mailto:info@oaziz.ca">info@oaziz.ca</a>.</p>
    </div>
  </article>
</Layout>
