---
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/ui';

const lang = 'fr';
const T = t(lang);

const gallery = [
  '/images/brands/aube/Aube-product-quebec.jpg',
  '/images/brands/aube/Aube-product-forest.jpg',
  '/images/brands/aube/Aube-laboratory.jpg',
  '/images/brands/aube/AUBESunrise.jpg',
  '/images/brands/aube/Aube-packaging-and-cart.jpg',
  '/images/brands/aube/Aube-packaging-and-fullcart.jpg',
];
---

<Layout title={T('aube.meta.title')} description={T('aube.meta.desc')} lang={lang} path="/fr/brands/aube" ogImage="/images/brands/aube/AUBESunrise.jpg">
  <section
    class="brand-hero"
    style="background-image: url('/images/brands/aube/AUBESunrise.jpg'); height: 45vh;"
  >
    <img src="/images/brands/aube/AUBE-LOGO.png" alt="AUBE Logo" class="brand-hero-logo" style="max-width: 220px;" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">AUBE by CannonFire</h1>
    <p>{T('aube.intro')}</p>
  </section>

  <section class="product-showcase">
    <div class="product-showcase-grid">
      <div class="product-grid-item">
        <div class="product-image-container">
          <img src="/images/brands/aube/Aube-packaging-and-fullcart.jpg" alt="AUBE Cartridge and Packaging" loading="lazy" />
        </div>
        <div class="product-details dark-bg-details">
          <h3>{T('aube.product.title')}</h3>
          <p>{T('aube.product.blurb')}</p>
          <ul>
            <li>{T('aube.b1')}</li>
            <li>{T('aube.b2')}</li>
            <li>{T('aube.b3')}</li>
            <li>{T('aube.b4')}</li>
          </ul>
          <div class="product-cta-group">
            <a
              href="https://www.sqdc.ca/en-CA/p-aube/628942710100-P/628942710100"
              target="_blank"
              rel="noopener"
              class="product-availability-badge"
            >
              <span class="badge-text">{T('brands.availableAt')}</span>
              <img src="/images/SQDC-logo.png" alt="SQDC" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="product-showcase">
    <h2 style="text-align: center; color: var(--primary-black); font-size: 2rem; margin-bottom: 32px;">
      {T('aube.gallery.title')}
    </h2>
    <div class="product-gallery">
      {gallery.map((src) => (
        <div class="gallery-item"><img src={src} alt="" loading="lazy" /></div>
      ))}
    </div>
  </section>
</Layout>
