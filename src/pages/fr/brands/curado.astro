---
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/ui';

const lang = 'fr';
const T = t(lang);

const featured = [
  {
    img: '/images/PBB-J-Temple-Ball.webp',
    alt: 'Curado Peanut Butter Breath Temple Ball',
    titleKey: 'curado.pbb.title',
    blurbKey: 'curado.pbb.blurb',
    bKeys: ['curado.pbb.b1', 'curado.pbb.b2', 'curado.pbb.b3', 'curado.pbb.b4'],
  },
  {
    img: '/images/Curado-Cali-Biscotti-Hash-1.5g.webp',
    alt: 'Curado Cali Biscotti Temple Ball Hash',
    titleKey: 'curado.cb.title',
    blurbKey: 'curado.cb.blurb',
    bKeys: ['curado.cb.b1', 'curado.cb.b2', 'curado.cb.b3', 'curado.cb.b4'],
  },
  {
    img: '/images/Curado-Cap-Junky-Temple-Ball-Jar.webp',
    alt: 'Curado Cap Junky Temple Ball',
    titleKey: 'curado.cj.title',
    blurbKey: 'curado.cj.blurb',
    bKeys: ['curado.cj.b1', 'curado.cj.b2', 'curado.cj.b3', 'curado.cj.b4'],
  },
  {
    img: '/images/Curado-Royal-Temple-Ball.webp',
    alt: 'Curado Royal M-39 Temple Ball',
    titleKey: 'curado.royal.title',
    blurbKey: 'curado.royal.blurb',
    bKeys: ['curado.royal.b1', 'curado.royal.b2', 'curado.royal.b3', 'curado.royal.b4'],
  },
  {
    img: '/images/Templeball.webp',
    alt: 'Curado Fruit Temple Ball',
    titleKey: 'curado.fruit.title',
    blurbKey: 'curado.fruit.blurb',
    bKeys: ['curado.fruit.b1', 'curado.fruit.b2', 'curado.fruit.b3', 'curado.fruit.b4'],
  },
];

const retailers = [
  { href: 'https://mendomedical.ca',     src: '/images/Mendo-Medical-Cannabis-Logo.webp', alt: 'Mendo Medical Cannabis' },
  { href: 'https://teedy.com',           src: '/images/Teedy.png',                        alt: 'Teedy' },
  { href: 'https://herbaldispatch.com/', src: '/images/HerbalDispatch.webp',              alt: 'Herbal Dispatch' },
  { href: 'https://flodega.com',         src: '/images/Flodega.png',                      alt: 'Flodega' },
];
---

<Layout title={T('curado.meta.title')} description={T('curado.meta.desc')} lang={lang} path="/fr/brands/curado" ogImage="/images/Curado-Logo.png">
  <section class="brand-hero white-bg-hero">
    <img src="/images/Curado-Logo.png" alt="CURADO Logo" class="brand-hero-logo" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">CURADO</h1>
    <p>{T('curado.intro')}</p>
  </section>

  <section class="product-showcase">
    <div class="product-showcase-grid">
      {featured.map((p) => (
        <div class="product-grid-item">
          <div class="product-image-container">
            <img src={p.img} alt={p.alt} loading="lazy" />
          </div>
          <div class="product-details dark-bg-details">
            <h3>{T(p.titleKey)}</h3>
            <p>{T(p.blurbKey)}</p>
            <ul>{p.bKeys.map((k) => <li>{T(k)}</li>)}</ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="product-showcase-medical white-bg-products">
    <div class="page-container with-padding">
      <h2 class="section-title-dark">{T('brands.medical.title')}</h2>
      <div class="medical-retailers-bar">
        {retailers.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="med-retailer-link">
            <img src={r.src} alt={r.alt} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
