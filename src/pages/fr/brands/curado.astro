---
import Layout from '../../../layouts/Layout.astro';
import { t } from '../../../i18n/ui';

const lang = 'fr';
const T = t(lang);

const featured = [
  {
    img: '/images/PBB-J-Temple-Ball.webp', alt: 'Curado Peanut Butter Breath Temple Ball',
    titleKey: 'curado.pbb.title', blurbKey: 'curado.pbb.blurb',
    bKeys: ['curado.pbb.b1', 'curado.pbb.b2', 'curado.pbb.b3', 'curado.pbb.b4'],
  },
  {
    img: '/images/PurpleOctane.webp', alt: 'Curado Fruit 1.5g Vape',
    titleKey: 'curado.fruit.title', blurbKey: 'curado.fruit.blurb',
    bKeys: ['curado.fruit.b1', 'curado.fruit.b2', 'curado.fruit.b3'],
  },
];

const medical = [
  { src: '/images/TropicannaCookies.webp', alt: 'Tropicana Cookies',   labelKey: 'curado.med.tc' },
  { src: '/images/TropicannaCookies.webp', alt: 'Black Cherry Punch',  labelKey: 'curado.med.bcp' },
  { src: '/images/PurpleOctane.webp',      alt: 'Purple Octane',       labelKey: 'curado.med.po' },
  { src: '/images/PurpleOctane.webp',      alt: 'Curado Fruit 1.5g',   labelKey: 'curado.med.fruit' },
];

const retailers = [
  { href: 'https://mendomedical.ca',     src: '/images/Mendo-Medical-Cannabis-Logo.webp', alt: 'Mendo Medical Cannabis' },
  { href: 'https://teedy.com',           src: '/images/Teedy.png',                        alt: 'Teedy' },
  { href: 'https://herbaldispatch.com/', src: '/images/HerbalDispatch.webp',              alt: 'Herbal Dispatch' },
  { href: 'https://flodega.com',         src: '/images/Flodega.png',                      alt: 'Flodega' },
];
---

<Layout title={T('curado.meta.title')} description={T('curado.meta.desc')} lang={lang} path="/fr/brands/curado" ogImage="/images/Curado-Logo.png">
  <section class="brand-hero white-bg-hero">
    <img src="/images/Curado-Logo.png" alt="CURADO Logo" class="brand-hero-logo" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">CURADO</h1>
    <p>{T('curado.intro')}</p>
  </section>

  <section class="product-showcase">
    <div class="product-showcase-grid">
      {featured.map((p) => (
        <div class="product-grid-item">
          <div class="product-image-container">
            <img src={p.img} alt={p.alt} loading="lazy" />
          </div>
          <div class="product-details dark-bg-details">
            <h3>{T(p.titleKey)}</h3>
            <p>{T(p.blurbKey)}</p>
            <ul>{p.bKeys.map((k) => <li>{T(k)}</li>)}</ul>
            <div class="product-cta-group">
              <a href="https://ocs.ca" target="_blank" rel="noopener" class="product-availability-badge">
                <span class="badge-text">{T('brands.availableAt')}</span>
                <img src="/images/OCS-logo.png" alt="OCS" />
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="product-showcase-medical white-bg-products">
    <div class="page-container with-padding">
      <h2 class="section-title-dark">{T('brands.medical.title')}</h2>
      <div class="medical-retailers-bar">
        {retailers.map((r) => (
          <a href={r.href} target="_blank" rel="noopener" class="med-retailer-link">
            <img src={r.src} alt={r.alt} loading="lazy" />
          </a>
        ))}
      </div>
      <div class="medical-product-gallery">
        {medical.map((m) => (
          <div class="med-card">
            <div class="med-image-wrapper"><img src={m.src} alt={m.alt} loading="lazy" /></div>
            <p>{T(m.labelKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
