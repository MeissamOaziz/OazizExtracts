---
import Layout from '../../../layouts/Layout.astro';
import ContactSection from '../../../components/ContactSection.astro';
import { t } from '../../../i18n/ui';

const lang = 'fr';
const T = t(lang);
---

<Layout title={T('xaman.meta.title')} description={T('xaman.meta.desc')} lang={lang} path="/fr/brands/xaman" ogImage="/images/Xaman-logo.jpg">
  <section class="brand-hero white-bg-hero">
    <img src="/images/Xaman-logo.jpg" alt="Xaman Logo" class="brand-hero-logo" />
  </section>

  <section class="brand-intro-cta">
    <h1 class="sr-only">Xaman</h1>
    <p>{T('xaman.intro')}</p>
  </section>

  <ContactSection lang={lang} title={T('xaman.formTitle')} showLeadIn context={T('xaman.ctx')} defaultSubject="sales" />
</Layout>
