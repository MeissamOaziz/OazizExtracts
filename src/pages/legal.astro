---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/ui';

const lang = 'en';
const T = t(lang);
const updated = '2026-05-25';
---

<Layout title={T('legal.meta.title')} description={T('legal.meta.desc')} lang={lang} path="/legal">
  <article class="content-section white-bg">
    <div class="page-container" style="max-width: 800px;">
      <h1 class="page-header">{T('legal.title')}</h1>
      <p style="text-align: center; color: var(--dark-gray); margin-bottom: 40px;">
        {T('legal.updated')} {updated}
      </p>

      <h2 style="text-align: left;">{T('legal.publisher')}</h2>
      <p>
        <strong>Oaziz Extracts Inc.</strong><br />
        322 Port Royal Ouest<br />
        Montréal, QC, Canada<br />
        {T('legal.email')} <a href="mailto:info@oaziz.ca">info@oaziz.ca</a>
      </p>

      <h2 style="text-align: left; margin-top: 30px;">{T('legal.license')}</h2>
      <p>{T('legal.license.body')}</p>

      <h2 style="text-align: left; margin-top: 30px;">{T('legal.compliance')}</h2>
      <p>{T('legal.compliance.body')}</p>

      <h2 style="text-align: left; margin-top: 30px;">{T('legal.ip')}</h2>
      <p>{T('legal.ip.body')}</p>

      <h2 style="text-align: left; margin-top: 30px;">{T('legal.disclaimer')}</h2>
      <p>{T('legal.disclaimer.body')}</p>
    </div>
  </article>
</Layout>
