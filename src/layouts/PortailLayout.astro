---
// Internal portal chrome — deliberately does NOT include the public site's
// Header, Footer, BottomBanner, AgeGate, or SEO. This is a private tool.
interface Props {
  title: string;
  /** Staff full name to show in the top-right, or null when unauthenticated. */
  staffName?: string | null;
  /** When true, hides the "Nouvelle demande" nav link (e.g. on login). */
  minimal?: boolean;
}
const { title, staffName = null, minimal = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Portail Oaziz</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --p-bg: #f6f7f9;
        --p-card: #ffffff;
        --p-border: #e2e5eb;
        --p-text: #1a1d24;
        --p-muted: #6b7280;
        --p-accent: #d05826;
        --p-accent-hover: #b64a1e;
        --p-danger: #b91c1c;
        --p-success: #15803d;
        --p-warn: #b45309;
        --p-shadow: 0 1px 2px rgba(16,24,40,.05), 0 1px 3px rgba(16,24,40,.06);
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--p-bg);
        color: var(--p-text);
        line-height: 1.5;
        min-height: 100vh;
      }
      a { color: var(--p-accent); }
      .portail-shell { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
      .portail-header {
        background: var(--p-card);
        border-bottom: 1px solid var(--p-border);
        padding: 14px 0;
        margin-bottom: 32px;
      }
      .portail-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }
      .portail-brand {
        display: flex; align-items: center; gap: 12px;
        font-weight: 700; font-size: 1rem; color: var(--p-text);
        text-decoration: none;
      }
      .portail-brand img { height: 32px; width: auto; }
      .portail-brand small { color: var(--p-muted); font-weight: 500; font-size: .82rem; }
      .portail-nav { display: flex; gap: 20px; align-items: center; font-size: .92rem; }
      .portail-nav a { color: var(--p-muted); text-decoration: none; font-weight: 500; }
      .portail-nav a:hover, .portail-nav a.active { color: var(--p-text); }
      .portail-user { color: var(--p-muted); font-size: .88rem; }
      .portail-logout {
        background: none; border: 1px solid var(--p-border); color: var(--p-text);
        padding: 6px 12px; border-radius: 6px; font-size: .85rem; cursor: pointer;
        font-family: inherit;
      }
      .portail-logout:hover { background: var(--p-bg); }
      h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: 8px; }
      h2 { font-size: 1.15rem; font-weight: 600; margin-bottom: 12px; }
      .card {
        background: var(--p-card);
        border: 1px solid var(--p-border);
        border-radius: 10px;
        padding: 24px;
        box-shadow: var(--p-shadow);
      }
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 10px 18px; border-radius: 8px; font-weight: 600; font-size: .95rem;
        border: 1px solid transparent; cursor: pointer; text-decoration: none;
        font-family: inherit; transition: background .15s ease, border-color .15s ease;
      }
      .btn-primary { background: var(--p-accent); color: #fff; }
      .btn-primary:hover:not(:disabled) { background: var(--p-accent-hover); }
      .btn-primary:disabled { opacity: .55; cursor: not-allowed; }
      .btn-secondary { background: #fff; color: var(--p-text); border-color: var(--p-border); }
      .btn-secondary:hover { background: var(--p-bg); }
      .btn-danger { background: #fff; color: var(--p-danger); border-color: #fecaca; }
      .btn-danger:hover { background: #fef2f2; }
      label { display: block; font-weight: 500; font-size: .88rem; margin-bottom: 6px; color: var(--p-text); }
      input[type="text"], input[type="email"], input[type="password"],
      input[type="date"], input[type="number"], select, textarea {
        width: 100%; padding: 9px 12px; border: 1px solid var(--p-border);
        border-radius: 6px; font-size: .95rem; background: #fff;
        font-family: inherit; color: var(--p-text);
      }
      input:focus, select:focus, textarea:focus {
        outline: none; border-color: var(--p-accent);
        box-shadow: 0 0 0 3px rgba(208, 88, 38, 0.15);
      }
      .form-row { margin-bottom: 18px; }
      .form-row .hint { font-size: .82rem; color: var(--p-muted); margin-top: 4px; }
      .badge {
        display: inline-block; padding: 3px 10px; border-radius: 999px;
        font-size: .75rem; font-weight: 600; letter-spacing: .3px;
      }
      .badge-draft { background: #f3f4f6; color: #374151; }
      .badge-sent { background: #dbeafe; color: #1e40af; }
      .badge-signing { background: #fef3c7; color: #92400e; }
      .badge-complete { background: #dcfce7; color: #166534; }
      .badge-finalized { background: #ede9fe; color: #5b21b6; }
      .badge-cancelled { background: #fee2e2; color: #991b1b; }
      .flash { padding: 12px 16px; border-radius: 8px; font-size: .9rem; margin-bottom: 20px; }
      .flash-error { background: #fef2f2; border: 1px solid #fecaca; color: var(--p-danger); }
      .flash-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: var(--p-success); }
      .flash-info { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; }
      table.data { width: 100%; border-collapse: collapse; }
      table.data th, table.data td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--p-border); font-size: .92rem; }
      table.data th { font-weight: 600; color: var(--p-muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .4px; }
      table.data tr:last-child td { border-bottom: none; }
      table.data a { color: var(--p-text); text-decoration: none; font-weight: 500; }
      table.data a:hover { color: var(--p-accent); }
      .empty-state { text-align: center; padding: 48px 24px; color: var(--p-muted); }
      .participants-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 8px 16px;
        border: 1px solid var(--p-border); border-radius: 6px; padding: 14px;
        max-height: 260px; overflow-y: auto;
      }
      .participants-grid label {
        display: flex; align-items: center; gap: 8px;
        font-weight: 400; font-size: .92rem; margin-bottom: 0; cursor: pointer;
      }
      .participants-grid input[type="checkbox"] { margin: 0; }
    </style>
  </head>
  <body>
    <header class="portail-header">
      <div class="portail-shell portail-header-inner">
        <a href="/portail" class="portail-brand">
          <img src="/images/Oaziz-Logo.webp" alt="" />
          <span>Portail Oaziz <small>· R&D</small></span>
        </a>
        {staffName && (
          <div style="display:flex;align-items:center;gap:16px;">
            {!minimal && (
              <nav class="portail-nav">
                <a href="/portail" class={Astro.url.pathname === '/portail' ? 'active' : ''}>Tableau de bord</a>
                <a href="/portail/nouvelle" class={Astro.url.pathname === '/portail/nouvelle' ? 'active' : ''}>Nouvelle demande</a>
              </nav>
            )}
            <span class="portail-user">{staffName}</span>
            <form method="POST" action="/api/portail/logout" style="margin:0;">
              <button type="submit" class="portail-logout">Déconnexion</button>
            </form>
          </div>
        )}
      </div>
    </header>
    <main class="portail-shell">
      <slot />
    </main>
  </body>
</html>
