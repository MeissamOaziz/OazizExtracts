---
import type { Locale } from '../i18n/ui';
import { t, localizeUrl, pathInLocale } from '../i18n/ui';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const T = t(lang);

const links = [
  { href: localizeUrl('/', lang),       label: T('nav.home') },
  { href: localizeUrl('/about', lang),  label: T('nav.about') },
  { href: localizeUrl('/brands', lang), label: T('nav.brands') },
];

const enHref = pathInLocale(currentPath, 'en');
const frHref = pathInLocale(currentPath, 'fr');

const isActive = (href: string) => {
  if (href === '/' || href === '/fr' || href === '/fr/') return currentPath === href;
  return currentPath === href || currentPath.startsWith(href + '/');
};
---

<header class="main-header">
  <nav class="main-nav" aria-label="Primary">
    <div class="nav-left">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </div>
    <div class="nav-center">
      <a href={localizeUrl('/', lang)} aria-label="Oaziz Extracts">
        <img src="/images/Oaziz-Logo.webp" alt="Oaziz Extracts" class="logo" width="200" height="90" />
      </a>
    </div>
    <div class="nav-right">
      <div class="lang-switcher" role="group" aria-label="Language">
        <a
          href={enHref}
          class:list={['lang-link', { active: lang === 'en' }]}
          hreflang="en"
          data-set-locale="en"
          aria-current={lang === 'en' ? 'true' : undefined}
        >
          English
        </a>
        <span class="lang-divider" aria-hidden="true"></span>
        <a
          href={frHref}
          class:list={['lang-link', { active: lang === 'fr' }]}
          hreflang="fr"
          data-set-locale="fr"
          aria-current={lang === 'fr' ? 'true' : undefined}
        >
          Français
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Persist explicit language choice so the geo-redirect middleware respects it.
  document.querySelectorAll<HTMLAnchorElement>('a.lang-link[data-set-locale]').forEach((link) => {
    link.addEventListener('click', () => {
      const locale = link.dataset.setLocale;
      if (locale === 'fr' || locale === 'en') {
        document.cookie = `oaziz_locale=${locale}; path=/; max-age=${60 * 60 * 24 * 365}; SameSite=Lax`;
      }
    });
  });
</script>
